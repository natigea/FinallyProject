@using Microsoft.Extensions.Localization
@using EcommersProject.Resources
@inject IStringLocalizer<SharedResource> L
@model RegisterViewModel
@{
    ViewData["Title"] = L["Register_Title"].Value;
    Layout = null;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@L["Register_Title"] — EcommersShop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: linear-gradient(135deg, #1e1b4b 0%, #4c1d95 100%); min-height: 100vh; }
        .auth-card { border-radius: 20px; box-shadow: 0 20px 60px rgba(0,0,0,.3); }
        .brand-logo { font-size: 1.5rem; font-weight: 700; color: #6366f1; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center py-5">
    <div class="auth-card bg-white p-5" style="width:100%; max-width:500px;">
        <div class="text-center mb-4">
            <div class="brand-logo mb-2">
                <i class="bi bi-bag-heart-fill me-1"></i>EcommersShop
            </div>
            <h4 class="fw-bold">@L["Register_Title"]</h4>
        </div>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label class="form-label fw-semibold">@L["Register_FirstName"]</label>
                    <input asp-for="FirstName" class="form-control" placeholder="@L["Register_FirstName"].Value" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-6">
                    <label class="form-label fw-semibold">@L["Register_LastName"]</label>
                    <input asp-for="LastName" class="form-control" placeholder="@L["Register_LastName"].Value" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Email</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="your@email.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">@L["Register_Phone"]</label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="+994 50 000 00 00" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label class="form-label fw-semibold">@L["Register_Password"]</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-6">
                    <label class="form-label fw-semibold">@L["Register_Confirm"]</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <!-- Seller toggle -->
            <div class="mb-3">
                <div class="form-check form-switch">
                    <input asp-for="IsSeller" class="form-check-input" id="isSellerToggle" onchange="toggleShopFields()" />
                    <label class="form-check-label fw-semibold" for="isSellerToggle">
                        <i class="bi bi-shop me-1"></i>@L["Register_IsSeller"]
                    </label>
                </div>
            </div>

            <div id="shopFields" class="d-none">
                <div class="mb-3">
                    <label class="form-label fw-semibold">@L["Register_ShopName"]</label>
                    <input asp-for="ShopName" class="form-control" placeholder="@L["Register_ShopName"].Value" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">@L["Register_ShopDescription"]</label>
                    <textarea asp-for="ShopDescription" class="form-control" rows="2" placeholder="@L["Register_ShopDescription"].Value"></textarea>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mt-2">
                <i class="bi bi-person-plus me-2"></i>@L["Register_Submit"]
            </button>
        </form>

        <hr class="my-4" />
        <p class="text-center text-muted small mb-0">
            @L["Register_HasAccount"] <a href="/Account/Login" class="text-primary fw-semibold">@L["Register_Login"]</a>
        </p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    function toggleShopFields() {
        const checked = document.getElementById('isSellerToggle').checked;
        document.getElementById('shopFields').classList.toggle('d-none', !checked);
    }
    </script>
</body>
</html>
