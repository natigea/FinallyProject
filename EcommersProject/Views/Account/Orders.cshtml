@using Microsoft.Extensions.Localization
@using EcommersProject.Resources
@inject IStringLocalizer<SharedResource> L
@model IReadOnlyList<EcommersProject.BLL.DTOs.OrderGetDto>
@{
    ViewData["Title"] = L["Orders_Title"].Value;
    var statuses = new[] { "", "Pending", "Paid", "Processing", "Shipped", "Delivered", "Cancelled" };
    var activeStatus = Context.Request.Query["status"].ToString();
    var filtered = string.IsNullOrEmpty(activeStatus) ? Model : Model.Where(o => o.Status == activeStatus).ToList();

    string StatusLabel(string s) => s switch
    {
        "Pending" => L["Status_Pending"].Value,
        "Paid" => L["Status_Paid"].Value,
        "Processing" => L["Status_Processing"].Value,
        "Shipped" => L["Status_Shipped"].Value,
        "Delivered" => L["Status_Delivered"].Value,
        "Cancelled" => L["Status_Cancelled"].Value,
        _ => s
    };
}

<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-bag me-2"></i>@L["Orders_Title"]</h2>

    <!-- Status filter -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 p-3">
        <div class="d-flex gap-2 flex-wrap">
            @foreach (var s in statuses)
            {
                var label = string.IsNullOrEmpty(s) ? L["Orders_All"].Value : StatusLabel(s);
                var isActive = activeStatus == s;
                <a href="/Account/Orders@(string.IsNullOrEmpty(s) ? "" : "?status=" + s)"
                   class="btn btn-sm @(isActive ? "btn-primary" : "btn-outline-secondary")">@label</a>
            }
        </div>
    </div>

    @if (!filtered.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-bag-x fs-1 text-muted"></i>
            <h5 class="mt-3 text-muted">@(Model.Any() ? L["Orders_EmptyFiltered"].Value : L["Orders_Empty"].Value)</h5>
            <a href="/Shop" class="btn btn-primary mt-3">@L["Orders_GoToShop"]</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var o in filtered.OrderByDescending(x => x.OrderDate))
            {
                <div class="card border-0 shadow-sm rounded-3 order-card">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                            <div>
                                <a href="/Account/OrderDetail/@o.Id" class="fw-bold text-dark text-decoration-none h6 mb-0 d-block">@o.OrderNumber</a>
                                <small class="text-muted">@o.OrderDate.ToString("dd MMMM yyyy, HH:mm")</small>
                            </div>
                            <div class="text-end d-flex flex-column align-items-end gap-1">
                                <span class="order-status-badge status-@o.Status.ToLower()">@StatusLabel(o.Status)</span>
                                <span class="fw-bold text-primary">@o.TotalAmount.ToString("N2") ₼</span>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var item in o.Items.Take(3))
                                {
                                    <div class="d-flex align-items-center gap-2 bg-light rounded-3 px-2 py-1">
                                        <div style="width:28px; height:28px; background:#e0e7ff; border-radius:6px; display:flex; align-items:center; justify-content:center;">
                                            <i class="bi bi-box text-primary" style="font-size:.7rem;"></i>
                                        </div>
                                        <span class="small text-muted">@item.ProductName <span class="fw-semibold text-dark">×@item.Quantity</span></span>
                                    </div>
                                }
                                @if (o.Items.Count > 3)
                                {
                                    <span class="small text-muted align-self-center">+@(o.Items.Count - 3)</span>
                                }
                            </div>
                            @if (o.CanCancel)
                            {
                                <form method="post" asp-controller="Account" asp-action="CancelOrder"
                                      onsubmit="return confirm('@L["Orders_CancelConfirm"]')">
                                    <input type="hidden" name="id" value="@o.Id" />
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-x-circle me-1"></i>@L["Orders_CancelBtn"]
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Styles {
<style>
    .order-card { transition: transform .15s, box-shadow .15s; }
    .order-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(99,102,241,.12) !important; }
</style>
}
