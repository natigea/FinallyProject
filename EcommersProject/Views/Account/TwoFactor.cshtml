@model TwoFactorViewModel
@{
    ViewData["Title"] = L["TwoFactor_Title"].Value;
    Layout = null;
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString);
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@L["TwoFactor_Title"] — Alıs-Veris</title>
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', system-ui, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f4f5f7;
            color: #1a1a1a;
            font-size: 14px;
        }
        .tfa-card {
            width: 100%;
            max-width: 440px;
            background: #fff;
            border-radius: 16px;
            padding: 40px 36px;
            box-shadow: 0 4px 24px rgba(0,0,0,.06);
            text-align: center;
        }
        .tfa-icon {
            width: 64px; height: 64px;
            border-radius: 16px;
            background: linear-gradient(135deg, #eff6ff, #e0e7ff);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            color: #2563eb;
            margin-bottom: 20px;
        }
        .tfa-title {
            font-size: 1.4rem;
            font-weight: 800;
            letter-spacing: -.4px;
            margin-bottom: 8px;
        }
        .tfa-sub {
            font-size: .85rem;
            color: #888;
            margin-bottom: 28px;
            line-height: 1.6;
        }
        .tfa-email {
            font-weight: 600;
            color: #1a1a1a;
        }
        .code-input {
            width: 100%;
            text-align: center;
            font-size: 1.8rem;
            font-weight: 700;
            letter-spacing: 10px;
            padding: 14px;
            border: 2px solid #e0e4ec;
            border-radius: 12px;
            outline: none;
            transition: border-color .2s, box-shadow .2s;
            font-family: 'Inter', monospace;
        }
        .code-input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37,99,235,.12);
        }
        .code-input::placeholder {
            color: #ddd;
            letter-spacing: 12px;
        }
        .tfa-submit {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #2563eb, #6366f1);
            color: #fff;
            border: none;
            border-radius: 12px;
            font-size: .95rem;
            font-weight: 700;
            font-family: inherit;
            cursor: pointer;
            margin-top: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 16px rgba(37,99,235,.3);
            transition: opacity .15s;
        }
        .tfa-submit:hover { opacity: .9; }
        .tfa-alert {
            border-radius: 8px;
            padding: 10px 14px;
            font-size: .82rem;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
            text-align: left;
        }
        .tfa-alert-danger { background: #fff0f0; color: #c53030; border: 1px solid #fecaca; }
        .tfa-alert-info   { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }
        .tfa-alert-warn   { background: #fffbeb; color: #92400e; border: 1px solid #fde68a; }
        .tfa-resend {
            margin-top: 20px;
            font-size: .82rem;
            color: #888;
        }
        .tfa-resend button {
            background: none;
            border: none;
            color: #2563eb;
            font-weight: 600;
            cursor: pointer;
            font-size: inherit;
            font-family: inherit;
            text-decoration: none;
        }
        .tfa-resend button:hover { text-decoration: underline; }
        .tfa-back {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            margin-top: 16px;
            font-size: .82rem;
            color: #888;
            text-decoration: none;
        }
        .tfa-back:hover { color: #555; }
        .lang-bar {
            position: fixed;
            top: 24px; right: 28px;
            display: flex;
            gap: 4px;
        }
        .lang-btn {
            font-size: .72rem;
            font-weight: 600;
            padding: 4px 9px;
            border-radius: 6px;
            border: 1.5px solid #e0e4ec;
            color: #888;
            text-decoration: none;
            transition: all .15s;
        }
        .lang-btn:hover { border-color: #2563eb; color: #2563eb; }
        .lang-btn.active { border-color: #2563eb; color: #2563eb; background: #eff6ff; font-weight: 700; }
    </style>
</head>
<body>
    <div class="lang-bar">
        <a href="/Language/Set?culture=ru&returnUrl=@returnUrl" class="lang-btn @(currentCulture == "ru" ? "active" : "")">RU</a>
        <a href="/Language/Set?culture=az&returnUrl=@returnUrl" class="lang-btn @(currentCulture == "az" ? "active" : "")">AZ</a>
        <a href="/Language/Set?culture=en&returnUrl=@returnUrl" class="lang-btn @(currentCulture == "en" ? "active" : "")">EN</a>
    </div>

    <div class="tfa-card">
        <div class="tfa-icon"><i class="bi bi-shield-lock"></i></div>
        <div class="tfa-title">@L["TwoFactor_Title"]</div>
        <div class="tfa-sub">
            @L["TwoFactor_Subtitle"]
            <br/><span class="tfa-email">@Model.Email</span>
        </div>

        @if (TempData["Info"] is string info)
        {
            <div class="tfa-alert tfa-alert-info"><i class="bi bi-info-circle-fill"></i>@info</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="tfa-alert tfa-alert-warn"><i class="bi bi-exclamation-triangle-fill"></i>@err</div>
        }

        <form asp-action="TwoFactor" method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="tfa-alert tfa-alert-danger">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <input asp-for="Code" class="code-input" maxlength="6" placeholder="••••••"
                   autocomplete="one-time-code" inputmode="numeric" autofocus />

            <button type="submit" class="tfa-submit">
                <i class="bi bi-check-circle"></i>@L["TwoFactor_Submit"]
            </button>
        </form>

        <div class="tfa-resend">
            @L["TwoFactor_NoCode"]
            <form asp-action="ResendTwoFactorCode" method="post" style="display:inline;">
                <button type="submit">@L["TwoFactor_ResendBtn"]</button>
            </form>
        </div>

        <a href="/Account/Login" class="tfa-back">
            <i class="bi bi-arrow-left"></i>@L["TwoFactor_BackToLogin"]
        </a>
    </div>

    <script>
        var inp = document.querySelector('.code-input');
        if (inp) {
            inp.addEventListener('input', function () {
                this.value = this.value.replace(/[^0-9]/g, '').slice(0, 6);
            });
        }
    </script>
</body>
</html>
