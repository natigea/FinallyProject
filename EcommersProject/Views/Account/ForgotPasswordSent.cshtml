@{
    Layout = null;
    var code  = TempData["ResetCode"]  as string;
    var email = TempData["ResetEmail"] as string ?? "";
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@L["ForgotPwd_SentTitle"] — Alıs-Veris</title>
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', system-ui, sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #f4f5f7; padding: 24px; }
        .card { background: #fff; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,.07); padding: 48px 44px; max-width: 460px; width: 100%; text-align: center; }
        .icon-wrap { width: 72px; height: 72px; border-radius: 50%; background: #f0fdf4; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; font-size: 2rem; color: #16a34a; }
        h1 { font-size: 1.5rem; font-weight: 800; color: #1a1a1a; margin-bottom: 8px; letter-spacing: -.4px; }
        .sub { font-size: .9rem; color: #777; line-height: 1.6; margin-bottom: 28px; }
        .code-box { background: #f8faff; border: 2px dashed #bfdbfe; border-radius: 12px; padding: 20px; margin-bottom: 28px; cursor: pointer; }
        .code-label { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .8px; color: #6b7280; margin-bottom: 8px; }
        .code-value { font-size: 2rem; font-weight: 800; font-family: monospace; color: #1d4ed8; letter-spacing: 6px; user-select: all; }
        .code-hint { font-size: .75rem; color: #9ca3af; margin-top: 6px; }
        .notice { background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 10px 14px; font-size: .78rem; color: #92400e; text-align: left; margin-bottom: 24px; display: flex; gap: 8px; }
        .btn-dark { display: inline-flex; align-items: center; gap: 8px; background: #111; color: #fff; border: none; border-radius: 9px; padding: 12px 28px; font-size: .9rem; font-weight: 600; font-family: inherit; cursor: pointer; text-decoration: none; transition: opacity .15s; width: 100%; justify-content: center; margin-bottom: 12px; }
        .btn-dark:hover { opacity: .85; color: #fff; }
        .btn-ghost { display: inline-flex; align-items: center; gap: 6px; color: #666; font-size: .82rem; text-decoration: none; }
        .btn-ghost:hover { color: #111; }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon-wrap"><i class="bi bi-key-fill"></i></div>
        <h1>@L["ForgotPwd_SentTitle"]</h1>
        <p class="sub">
            @if (code != null)
            {
                @:@L["ForgotPwd_SentSub"] <strong>@email</strong>:
            }
            else
            {
                @L["ForgotPwd_NoAccountSub"]
            }
        </p>

        @if (code != null)
        {
            <div class="notice">
                <i class="bi bi-info-circle-fill flex-shrink-0 mt-1" style="color:#d97706;"></i>
                <span>@L["ForgotPwd_NoticeText"]</span>
            </div>
            <div class="code-box" onclick="copyCode()" title="@L["ForgotPwd_CodeHint"]">
                <div class="code-label">@L["ForgotPwd_CodeLabel"]</div>
                <div class="code-value" id="codeVal">@code</div>
                <div class="code-hint" id="codeHint"><i class="bi bi-clipboard me-1"></i>@L["ForgotPwd_CodeHint"]</div>
            </div>
        }

        <a href="/Account/ResetPassword?email=@Uri.EscapeDataString(email)" class="btn-dark">
            <i class="bi bi-lock-fill"></i>@L["ForgotPwd_GoToReset"]
        </a>
        <div style="margin-top:8px;">
            <a href="/Account/Login" class="btn-ghost"><i class="bi bi-arrow-left"></i>@L["ForgotPwd_BackToLogin"]</a>
        </div>
    </div>

    <script>
        const copiedMsg = '@L["ForgotPwd_Copied"].Value';
        const originalHint = '<i class="bi bi-clipboard me-1"></i>@L["ForgotPwd_CodeHint"].Value';
        function copyCode() {
            const val = document.getElementById('codeVal')?.textContent?.trim();
            if (!val) return;
            navigator.clipboard.writeText(val).then(() => {
                const hint = document.getElementById('codeHint');
                hint.innerHTML = '<i class="bi bi-check-lg me-1" style="color:#16a34a"></i>' + copiedMsg;
                setTimeout(() => hint.innerHTML = originalHint, 2000);
            });
        }
    </script>
</body>
</html>
