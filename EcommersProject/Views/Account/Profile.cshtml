@model ProfileEditViewModel
@using EcommersProject.Models
@{
    ViewData["Title"] = L["Profile_EditTitle"].Value;
    var email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
}

@section Styles {
<style>
    .settings-wrap { max-width: 860px; margin: 0 auto; padding: 32px 16px 60px; }
    .settings-layout { display: flex; gap: 28px; align-items: flex-start; }

    /* ── Section card ──────────────────────────────── */
    .settings-card {
        background: #fff;
        border: 1.5px solid #e8eaed;
        border-radius: 14px;
        padding: 28px;
        margin-bottom: 20px;
    }
    .settings-card-title {
        font-size: .9rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .settings-card-title i { color: #666; font-size: 1rem; }

    /* ── Avatar block ──────────────────────────────── */
    .avatar-block { display: flex; align-items: center; gap: 20px; }
    .avatar-circle {
        width: 80px; height: 80px; border-radius: 50%;
        background: #1a1a1a; color: #fff;
        font-size: 1.7rem; font-weight: 700;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0; overflow: hidden;
        border: 3px solid #e8eaed;
    }
    .avatar-circle img { width: 100%; height: 100%; object-fit: cover; }
    .avatar-actions { display: flex; flex-direction: column; gap: 8px; }
    .avatar-upload-btn {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 16px; border-radius: 8px;
        border: 1.5px solid #1a1a1a; background: #1a1a1a;
        color: #fff; font-size: .82rem; font-weight: 600;
        cursor: pointer; transition: opacity .15s;
    }
    .avatar-upload-btn:hover { opacity: .85; }
    .avatar-remove-btn {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 7px 14px; border-radius: 8px;
        border: 1.5px solid #e8eaed; background: transparent;
        color: #888; font-size: .82rem; font-weight: 500;
        cursor: pointer; transition: all .15s;
        text-decoration: none;
    }
    .avatar-remove-btn:hover { border-color: #ef4444; color: #ef4444; }
    .avatar-hint { font-size: .74rem; color: #aaa; margin-top: 4px; }

    /* ── Form ──────────────────────────────────────── */
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-group { display: flex; flex-direction: column; gap: 5px; }
    .form-group.full { grid-column: 1 / -1; }
    .form-label { font-size: .8rem; font-weight: 600; color: #555; }
    .form-input {
        border: 1.5px solid #e0e4ec; border-radius: 8px;
        padding: 10px 14px; font-size: .875rem; font-family: inherit;
        color: #1a1a1a; outline: none; transition: border-color .15s;
        background: #fff;
    }
    .form-input:focus { border-color: #999; }
    .form-input:disabled { background: #f8f9fa; color: #999; cursor: not-allowed; }
    .form-hint { font-size: .74rem; color: #aaa; }
    .validation-msg { font-size: .75rem; color: #ef4444; margin-top: 2px; }

    /* ── Save button ───────────────────────────────── */
    .save-btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 11px 28px; border-radius: 9px;
        background: #1a1a1a; color: #fff;
        border: none; font-size: .875rem; font-weight: 600;
        font-family: inherit; cursor: pointer; transition: opacity .15s;
        margin-top: 8px;
    }
    .save-btn:hover { opacity: .85; }

    /* ── Password section ──────────────────────────── */
    .pwd-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }

    /* ── Alerts ────────────────────────────────────── */
    .settings-alert {
        border-radius: 9px; padding: 11px 16px;
        font-size: .84rem; display: flex; align-items: center; gap: 9px;
        margin-bottom: 16px;
    }
    .settings-alert-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
    .settings-alert-error   { background: #fff5f5; border: 1px solid #fecaca; color: #dc2626; }

    @@media (max-width: 768px) {
        .settings-layout { flex-direction: column; }
        .form-grid { grid-template-columns: 1fr; }
        .pwd-grid  { grid-template-columns: 1fr; }
    }
</style>
}

<div class="settings-wrap">
    <div class="settings-layout">

        @await Html.PartialAsync("_ProfileSidebar")

        <main style="flex:1;min-width:0;">

            @if (TempData["Success"] != null)
            {
                <div class="settings-alert settings-alert-success">
                    <i class="bi bi-check-circle-fill"></i>@TempData["Success"]
                </div>
            }
            @if (TempData["PwdSuccess"] != null)
            {
                <div class="settings-alert settings-alert-success">
                    <i class="bi bi-check-circle-fill"></i>@TempData["PwdSuccess"]
                </div>
            }
            @if (TempData["PwdError"] != null)
            {
                <div class="settings-alert settings-alert-error">
                    <i class="bi bi-exclamation-circle-fill"></i>@TempData["PwdError"]
                </div>
            }

            <!-- ── Avatar + personal info ── -->
            <form asp-controller="Account" asp-action="Profile" method="post"
                  enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="PhotoUrl" />

                <div class="settings-card">
                    <div class="settings-card-title">
                        <i class="bi bi-person-circle"></i>@L["Profile_Avatar"]
                    </div>

                    <div class="avatar-block">
                        <div class="avatar-circle" id="avatarPreview">
                            @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                            {
                                <img src="@Model.PhotoUrl" alt="avatar" id="avatarImg" />
                            }
                            else
                            {
                                <span id="avatarInitials">@(Model.FirstName.FirstOrDefault().ToString().ToUpper())@(Model.LastName.FirstOrDefault().ToString().ToUpper())</span>
                            }
                        </div>
                        <div class="avatar-actions">
                            <label class="avatar-upload-btn">
                                <i class="bi bi-camera"></i>@L["Profile_ChangePhoto"]
                                <input type="file" asp-for="Photo" accept="image/*"
                                       style="display:none;" id="photoInput"
                                       onchange="previewAvatar(this)" />
                            </label>
                            @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                            {
                                <a href="/Account/RemovePhoto" class="avatar-remove-btn">
                                    <i class="bi bi-trash"></i>@L["Profile_RemovePhoto"]
                                </a>
                            }
                            <span class="avatar-hint">JPG, PNG, WebP · до 5 МБ</span>
                        </div>
                    </div>
                </div>

                <div class="settings-card">
                    <div class="settings-card-title">
                        <i class="bi bi-person"></i>@L["Profile_PersonalInfo"]
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">@L["Profile_FirstName"]</label>
                            <input asp-for="FirstName" class="form-input" />
                            <span asp-validation-for="FirstName" class="validation-msg"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">@L["Profile_LastName"]</label>
                            <input asp-for="LastName" class="form-input" />
                            <span asp-validation-for="LastName" class="validation-msg"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">@L["Profile_Phone"]</label>
                            <input asp-for="PhoneNumber" class="form-input" placeholder="+994 XX XXX XX XX" />
                            <span asp-validation-for="PhoneNumber" class="validation-msg"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">@L["Profile_Email"]</label>
                            <input type="email" value="@email" class="form-input" disabled />
                            <span class="form-hint">@L["Profile_EmailHint"]</span>
                        </div>
                    </div>

                    <button type="submit" class="save-btn">
                        <i class="bi bi-check-lg"></i>@L["Profile_SaveChanges"]
                    </button>
                </div>
            </form>

            <!-- ── Change password ── -->
            <form asp-controller="Account" asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <div class="settings-card">
                    <div class="settings-card-title">
                        <i class="bi bi-lock"></i>@L["Profile_ChangePassword"]
                    </div>

                    <div class="pwd-grid">
                        <div class="form-group">
                            <label class="form-label">@L["Profile_CurrentPassword"]</label>
                            <input asp-for="@(new ChangePasswordViewModel().CurrentPassword)"
                                   name="CurrentPassword" type="password" class="form-input"
                                   autocomplete="current-password" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">@L["Profile_NewPassword"]</label>
                            <input asp-for="@(new ChangePasswordViewModel().NewPassword)"
                                   name="NewPassword" type="password" class="form-input"
                                   autocomplete="new-password" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">@L["Profile_ConfirmPassword"]</label>
                            <input asp-for="@(new ChangePasswordViewModel().ConfirmPassword)"
                                   name="ConfirmPassword" type="password" class="form-input"
                                   autocomplete="new-password" />
                        </div>
                    </div>

                    <button type="submit" class="save-btn" style="margin-top:16px;">
                        <i class="bi bi-shield-lock"></i>@L["Profile_UpdatePassword"]
                    </button>
                </div>
            </form>

        </main>
    </div>
</div>

@section Scripts {
<script>
    function previewAvatar(input) {
        if (!input.files?.length) return;
        const file = input.files[0];
        const reader = new FileReader();
        reader.onload = e => {
            const preview = document.getElementById('avatarPreview');
            preview.innerHTML = `<img src="${e.target.result}" style="width:100%;height:100%;object-fit:cover;" />`;
        };
        reader.readAsDataURL(file);
    }
</script>
}
