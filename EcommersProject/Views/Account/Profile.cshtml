@using Microsoft.Extensions.Localization
@using EcommersProject.Resources
@inject IStringLocalizer<SharedResource> L
@model ProfileViewModel
@{
    ViewData["Title"] = L["Profile_Title"].Value;
    var u = Model.User;
}

<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-person-circle me-2"></i>@L["Profile_Title"]</h2>

    <div class="row g-4">
        <!-- Left sidebar -->
        <div class="col-md-4 col-lg-3">
            <!-- User card -->
            <div class="card border-0 shadow-sm rounded-3 p-4 text-center mb-3">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3"
                     style="width:80px; height:80px; background: linear-gradient(135deg, #6366f1, #8b5cf6); color:#fff; font-size:2rem; font-weight:700;">
                    @u.FirstName[0]@u.LastName[0]
                </div>
                <h5 class="fw-bold mb-0">@u.FirstName @u.LastName</h5>
                <p class="text-muted small mb-2">@u.Email</p>
                @if (!string.IsNullOrEmpty(u.ShopName))
                {
                    <span class="badge bg-success-subtle text-success mb-1 d-inline-block">
                        <i class="bi bi-shop me-1"></i>@u.ShopName
                    </span>
                }
                <span class="badge bg-primary">@u.Role</span>
                <p class="text-muted small mt-2 mb-0">@L["Profile_Since"] @u.CreatedDate.ToString("MMMM yyyy")</p>
            </div>

            <!-- Quick links -->
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="list-group list-group-flush">
                    <a href="/Account/Profile" class="list-group-item list-group-item-action active border-0 py-3">
                        <i class="bi bi-person me-2"></i>@L["Profile_Profile"]
                    </a>
                    <a href="/Account/Orders" class="list-group-item list-group-item-action border-0 py-3">
                        <i class="bi bi-bag me-2"></i>@L["Nav_MyOrders"] <span class="badge bg-primary ms-1">@Model.Orders.Count</span>
                    </a>
                    <a href="/Favorites" class="list-group-item list-group-item-action border-0 py-3">
                        <i class="bi bi-heart me-2"></i>@L["Profile_Favorites"]
                    </a>
                    <a href="/Cart" class="list-group-item list-group-item-action border-0 py-3">
                        <i class="bi bi-cart3 me-2"></i>@L["Profile_Cart"]
                    </a>
                </div>
            </div>
        </div>

        <!-- Right content -->
        <div class="col-md-8 col-lg-9">

            <!-- Recent orders -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">@L["Profile_RecentOrders"]</h5>
                        <a href="/Account/Orders" class="btn btn-outline-primary btn-sm">@L["Profile_AllOrders"]</a>
                    </div>
                    @if (!Model.Orders.Any())
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-bag-x fs-2 text-muted"></i>
                            <p class="text-muted mt-2 mb-2">@L["Profile_NoOrders"]</p>
                            <a href="/Shop" class="btn btn-primary btn-sm">@L["Profile_GoToCatalog"]</a>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var o in Model.Orders.OrderByDescending(x => x.OrderDate).Take(3))
                            {
                                <a href="/Account/OrderDetail/@o.Id" class="text-decoration-none">
                                    <div class="order-row d-flex justify-content-between align-items-center p-3 rounded-3 border">
                                        <div>
                                            <div class="fw-semibold text-dark">@o.OrderNumber</div>
                                            <div class="text-muted small">@o.OrderDate.ToString("dd.MM.yyyy") · @o.Items.Count @L["Profile_OrderItems"]</div>
                                        </div>
                                        <div class="text-end">
                                            <div class="order-status-badge status-@o.Status.ToLower() mb-1">@o.Status</div>
                                            <div class="fw-bold text-primary">@o.TotalAmount.ToString("N2") ₼</div>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Addresses -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">@L["Profile_Addresses"]</h5>
                        <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addAddrModal">
                            <i class="bi bi-plus me-1"></i>@L["Profile_AddAddress"]
                        </button>
                    </div>
                    @if (!Model.Addresses.Any())
                    {
                        <div class="text-center py-3">
                            <i class="bi bi-geo-alt fs-2 text-muted"></i>
                            <p class="text-muted mt-2 mb-0 small">@L["Profile_NoAddresses"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-2">
                            @foreach (var addr in Model.Addresses)
                            {
                                <div class="col-md-6">
                                    <div class="p-3 rounded-3 border @(addr.IsDefault ? "border-primary bg-primary bg-opacity-5" : "")">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <div class="fw-semibold small">@addr.Line1</div>
                                                @if (!string.IsNullOrEmpty(addr.Line2))
                                                {
                                                    <div class="text-muted small">@addr.Line2</div>
                                                }
                                                <div class="text-muted small">@addr.City@(addr.State != "" ? ", " + addr.State : ""), @addr.Country</div>
                                            </div>
                                            <form method="post" asp-controller="Account" asp-action="DeleteAddress">
                                                <input type="hidden" name="id" value="@addr.Id" />
                                                <button class="btn btn-outline-danger btn-sm py-0 px-1 border-0">
                                                    <i class="bi bi-trash small"></i>
                                                </button>
                                            </form>
                                        </div>
                                        @if (addr.IsDefault)
                                        {
                                            <span class="badge bg-primary mt-1" style="font-size:.65rem;">@L["Profile_IsDefault"]</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Add Address Modal -->
<div class="modal fade" id="addAddrModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">@L["Profile_NewAddress"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-controller="Account" asp-action="AddAddress">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">@L["Profile_Street"] *</label>
                            <input type="text" name="line1" class="form-control" placeholder="@L["Profile_Street"].Value" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">@L["Profile_Apartment"]</label>
                            <input type="text" name="line2" class="form-control" placeholder="@L["Profile_Apartment"].Value" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@L["Profile_City"] *</label>
                            <input type="text" name="city" class="form-control" placeholder="@L["Profile_City"].Value" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@L["Profile_District"]</label>
                            <input type="text" name="state" class="form-control" placeholder="@L["Profile_District"].Value" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@L["Profile_PostalCode"]</label>
                            <input type="text" name="postalCode" class="form-control" placeholder="AZ1000" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@L["Profile_Country"]</label>
                            <input type="text" name="country" class="form-control" value="AZ" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="isDefault" value="true" id="isDefaultChk" />
                                <label class="form-check-label" for="isDefaultChk">@L["Profile_DefaultAddress"]</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Profile_Cancel"]</button>
                    <button type="submit" class="btn btn-primary px-4">@L["Profile_SaveAddress"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
<style>
    .order-row { transition: background .15s, border-color .15s; }
    .order-row:hover { background: #f8f9ff; border-color: #6366f1 !important; }
</style>
}
