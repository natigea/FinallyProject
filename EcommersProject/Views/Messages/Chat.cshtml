@model EcommersProject.BLL.DTOs.ConversationGetDto
@{
    ViewData["Title"]         = L["Messages_Title"].Value;
    ViewData["HideFooter"]    = true;
    ViewData["HideNavSearch"] = true;
    var userId       = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isBuyer      = Model.BuyerId.ToString() == userId;
    var otherName    = (isBuyer ? Model.SellerName : Model.BuyerName) ?? "?";
    var otherInitial = otherName.Length > 0 ? char.ToUpper(otherName[0]).ToString() : "?";
    var convId       = Model.Id.ToString();
}

<div class="chat-outer">
<div class="chat-sidebar-col d-none d-md-block">
    @await Html.PartialAsync("_ProfileSidebar")
</div>
<div class="chat-wrap">
    <!-- Header -->
    @{ var isSupport = Model.ListingTitle == "__SUPPORT__"; }
    <div class="chat-header">
        <a href="/Messages" class="chat-back-btn"><i class="bi bi-arrow-left"></i></a>
        @if (isSupport)
        { <div class="chat-header-img-ph" style="background:var(--accent);color:#fff;"><i class="bi bi-headset"></i></div> }
        else if (Model.ListingImage != null)
        { <img src="@Model.ListingImage" class="chat-header-img" /> }
        else
        { <div class="chat-header-img-ph"><i class="bi bi-image"></i></div> }
        <div class="chat-header-info">
            <div class="chat-header-name">@(isSupport ? L["Nav_Support"].Value : otherName)</div>
            @if (!isSupport)
            {
            <a href="/Listing/Detail/@Model.ListingId" class="chat-header-listing">
                @Model.ListingTitle@(Model.ListingPrice.HasValue ? $" — {Model.ListingPrice.Value:N0} ₼" : "")
            </a>
            }
        </div>
        <button id="call-btn" class="chat-call-btn" onclick="startCall()" @(isSupport ? "style=display:none" : "")>
            <i class="bi bi-telephone-fill"></i>
        </button>
    </div>

    <!-- Messages -->
    <div id="chatBox" class="chat-box">
        @if (Model.Messages == null || !Model.Messages.Any())
        { <div class="chat-empty">@L["Messages_FirstMsg"]</div> }
        @foreach (var msg in Model.Messages ?? [])
        {
            var isMe = msg.SenderId.ToString() == userId;
            <div class="chat-msg-row @(isMe?"chat-msg-me":"chat-msg-them")">
                <div class="chat-bubble @(isMe?"chat-bubble-me":"chat-bubble-them")">
                    @if (msg.Text.StartsWith("[voice]"))
                    {
                        var voiceUrl = msg.Text.Substring(7);
                        <div class="voice-msg" data-src="@voiceUrl">
                            <button class="voice-msg-btn" type="button"><i class="bi bi-play-fill"></i></button>
                            <div class="voice-msg-wave"></div>
                            <span class="voice-msg-time">0:00</span>
                        </div>
                    }
                    else if (msg.Text.StartsWith("[photo]"))
                    {
                        var photoUrl = msg.Text.Substring(7);
                        <div class="chat-media-photo">
                            <img src="@photoUrl" alt="photo" loading="lazy" onclick="window._openPhoto(this.src)" />
                        </div>
                    }
                    else
                    {
                        <div class="chat-bubble-text">@msg.Text</div>
                    }
                    <div class="chat-bubble-time @(isMe?"justify-content-end":"")">
                        <span>@msg.CreatedDate.ToLocalTime().ToString("HH:mm")</span>
                        @if (isMe){ <i class="bi @(msg.IsRead?"bi-check2-all":"bi-check2")"></i> }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Input -->
    <div class="chat-input-wrap">
        <input type="file" id="photoInput" accept="image/*" style="display:none" />
        <form asp-controller="Messages" asp-action="Send" method="post" class="chat-input-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="conversationId" value="@Model.Id" />
            <button type="button" class="chat-media-btn" id="photoBtn" title="@L["Chat_PhotoBtn"]">
                <i class="bi bi-image"></i>
            </button>
            <button type="button" class="chat-media-btn" id="voiceBtn" title="@L["Chat_VoiceBtn"]">
                <i class="bi bi-mic-fill" id="voiceIcon"></i>
            </button>
            <input type="text" name="text" class="chat-input"
                   placeholder="@L["Messages_InputPlaceholder"]" required autocomplete="off" />
            <button type="submit" class="chat-send-btn"><i class="bi bi-send-fill"></i></button>
        </form>
        <div id="voiceRecording" class="voice-recording" style="display:none">
            <div class="voice-rec-indicator">
                <span class="voice-rec-dot"></span>
                <span class="voice-rec-time" id="recTime">0:00</span>
            </div>
            <button type="button" class="voice-rec-cancel" id="recCancel">
                <i class="bi bi-x-lg"></i>
            </button>
            <button type="button" class="voice-rec-send" id="recSend">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
    </div>
</div>
</div>

<!-- Photo lightbox -->
<div id="photoLightbox" class="photo-lightbox" style="display:none" onclick="this.style.display='none'">
    <img id="lightboxImg" src="" alt="" />
</div>

<!-- OUTGOING / ACTIVE CALL OVERLAY -->
<div id="call-overlay">
    <div class="co-bg"></div>
    <div class="co-body">
        <div class="co-av-wrap">
            <div class="co-ring co-ring-1" id="co-r1"></div>
            <div class="co-ring co-ring-2" id="co-r2"></div>
            <div class="co-av">@otherInitial</div>
        </div>
        <div class="co-name">@otherName</div>
        <div class="co-status" id="call-status">@L["Call_Calling"]</div>
    </div>
    <div class="co-controls">
        <div class="co-ctrl-wrap">
            <button class="co-btn co-btn-mute" id="mute-btn" onclick="toggleMute()">
                <i class="bi bi-mic-fill" id="mute-icon"></i>
            </button>
            <span class="co-btn-lbl">@L["Call_Mic"]</span>
        </div>
        <div class="co-ctrl-wrap">
            <button class="co-btn co-btn-speaker" id="speaker-btn" onclick="toggleSpeaker()">
                <i class="bi bi-volume-up-fill" id="speaker-icon"></i>
            </button>
            <span class="co-btn-lbl" id="speaker-lbl">@L["Chat_Speaker"]</span>
        </div>
        <div class="co-ctrl-wrap">
            <button class="co-btn co-btn-end" onclick="endCall(false)">
                <i class="bi bi-telephone-x-fill"></i>
            </button>
            <span class="co-btn-lbl">@L["Call_End"]</span>
        </div>
    </div>
</div>

<!-- INCOMING CALL OVERLAY -->
<div id="incoming-overlay">
    <div class="co-bg co-bg-incoming"></div>
    <div class="co-body">
        <div class="co-incoming-label">@L["Call_Incoming"]</div>
        <div class="co-av-wrap">
            <div class="co-ring co-ring-1 co-ring-g"></div>
            <div class="co-ring co-ring-2 co-ring-g" style="animation-delay:.7s"></div>
            <div class="co-av" id="inc-av">?</div>
        </div>
        <div class="co-name" id="inc-name">...</div>
        <div class="co-status">@L["Call_Incoming"]</div>
    </div>
    <div class="co-controls">
        <div class="co-ctrl-wrap">
            <button class="co-btn co-btn-decline" onclick="declineCall()">
                <i class="bi bi-telephone-x-fill"></i>
            </button>
            <span class="co-btn-lbl">@L["Call_Decline"]</span>
        </div>
        <div class="co-ctrl-wrap">
            <button class="co-btn co-btn-accept" onclick="acceptCall()">
                <i class="bi bi-telephone-fill"></i>
            </button>
            <span class="co-btn-lbl">@L["Call_Accept"]</span>
        </div>
    </div>
</div>

@section Styles {
<style>
/* ── DESKTOP LAYOUT ── */
.chat-outer {
    display:flex; align-items:flex-start; gap:28px;
    max-width:1060px; margin:0 auto;
    padding:32px 16px 0;
    height:calc(100vh - 64px);
}
.chat-sidebar-col { width:240px; flex-shrink:0; align-self:flex-start; }
.chat-wrap {
    flex:1; display:flex; flex-direction:column; min-width:0;
    align-self:stretch;
    border:1px solid var(--border); border-radius:14px 14px 0 0; overflow:hidden;
}
.chat-box { min-height:0; }

@@media (max-width:767px) {
    .chat-outer { max-width:100%; margin:0; padding:0; gap:0; height:calc(100vh - 64px); }
    .chat-wrap  { border:none; border-radius:0; align-self:auto; height:100%; }
}

/* ── HEADER ── */
.chat-header { display:flex; align-items:center; gap:12px; padding:12px 16px; background:var(--card); border-bottom:1px solid var(--border); flex-shrink:0; }
.chat-back-btn { display:flex; align-items:center; justify-content:center; width:36px; height:36px; border-radius:50%; background:var(--bg); border:1.5px solid var(--border); color:var(--text); text-decoration:none; flex-shrink:0; transition:background .15s; }
.chat-back-btn:hover { background:var(--accent-soft); color:var(--accent); }
.chat-header-img { width:44px; height:44px; border-radius:10px; object-fit:cover; flex-shrink:0; }
.chat-header-img-ph { width:44px; height:44px; border-radius:10px; flex-shrink:0; background:var(--bg); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; font-size:1.2rem; color:var(--muted); }
.chat-header-info { flex:1; min-width:0; }
.chat-header-name { font-weight:700; font-size:.95rem; color:var(--text); }
.chat-header-listing { display:block; font-size:.75rem; color:var(--accent); text-decoration:none; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.chat-call-btn { width:40px; height:40px; border-radius:50%; flex-shrink:0; background:#22c55e; color:#fff; border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:.95rem; transition:background .15s, transform .1s; box-shadow:0 2px 8px rgba(34,197,94,.4); }
.chat-call-btn:hover { background:#16a34a; }
.chat-call-btn:active { transform:scale(.92); }
.chat-call-btn:disabled { background:var(--muted); box-shadow:none; cursor:not-allowed; }

/* ── MESSAGES ── */
.chat-box { flex:1; overflow-y:auto; padding:16px 12px; display:flex; flex-direction:column; gap:6px; background:var(--bg); scrollbar-width:thin; scrollbar-color:var(--border) transparent; }
.chat-empty { flex:1; display:flex; align-items:center; justify-content:center; color:var(--muted); font-size:.9rem; text-align:center; padding:32px; }
.chat-msg-row { display:flex; }
.chat-msg-me    { justify-content:flex-end; }
.chat-msg-them  { justify-content:flex-start; }
.chat-bubble { max-width:72%; padding:9px 13px; border-radius:16px; word-break:break-word; line-height:1.5; }
.chat-bubble-me   { background:var(--accent); color:#fff; border-bottom-right-radius:4px; }
.chat-bubble-them { background:var(--card); color:var(--text); border:1px solid var(--border); border-bottom-left-radius:4px; }
.chat-bubble-text { font-size:.9rem; }
.chat-bubble-time { display:flex; align-items:center; gap:3px; font-size:.68rem; opacity:.75; margin-top:4px; }
.chat-bubble-me   .chat-bubble-time { color:rgba(255,255,255,.85); }
.chat-bubble-them .chat-bubble-time { color:var(--muted); }

/* ── INPUT ── */
.chat-input-wrap { flex-shrink:0; padding:10px 12px; background:var(--card); border-top:1px solid var(--border); position:relative; }
.chat-input-form { display:flex; align-items:center; gap:8px; }
.chat-input { flex:1; border:1.5px solid var(--border); border-radius:24px; padding:10px 16px; font-size:.9rem; font-family:inherit; color:var(--text); background:var(--bg); outline:none; transition:border-color .15s; }
.chat-input:focus { border-color:var(--accent); }
.chat-send-btn { width:42px; height:42px; border-radius:50%; flex-shrink:0; background:var(--accent); color:#fff; border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:1rem; transition:background .15s, transform .1s; }
.chat-send-btn:active { transform:scale(.92); }

/* ── MEDIA BUTTONS ── */
.chat-media-btn { width:38px; height:38px; border-radius:50%; flex-shrink:0; background:var(--bg); color:var(--muted); border:1.5px solid var(--border); cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:.95rem; transition:all .15s; }
.chat-media-btn:hover { background:var(--accent-soft); color:var(--accent); border-color:var(--accent); }
.chat-media-btn.recording { background:#ef4444; color:#fff; border-color:#ef4444; animation:recPulse 1.2s ease-in-out infinite; }
@@keyframes recPulse { 0%,100% { box-shadow:0 0 0 0 rgba(239,68,68,.4); } 50% { box-shadow:0 0 0 8px rgba(239,68,68,0); } }

/* ── VOICE RECORDING BAR ── */
.voice-recording { display:flex; align-items:center; gap:12px; padding:8px 12px; background:var(--bg); border-radius:24px; border:1.5px solid #ef4444; }
.voice-rec-indicator { display:flex; align-items:center; gap:8px; flex:1; }
.voice-rec-dot { width:10px; height:10px; border-radius:50%; background:#ef4444; animation:recPulse 1.2s ease-in-out infinite; }
.voice-rec-time { font-size:.85rem; font-weight:600; color:var(--text); font-variant-numeric:tabular-nums; }
.voice-rec-cancel { width:36px; height:36px; border-radius:50%; background:rgba(239,68,68,.1); color:#ef4444; border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:.9rem; }
.voice-rec-send { width:42px; height:42px; border-radius:50%; background:#22c55e; color:#fff; border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:1rem; transition:transform .1s; }
.voice-rec-send:active { transform:scale(.92); }

/* ── VOICE MESSAGE (TG-style) ── */
.voice-msg { display:flex; align-items:center; gap:10px; min-width:200px; max-width:260px; padding:2px 0; user-select:none; }
.voice-msg-btn { width:36px; height:36px; min-width:36px; border-radius:50%; border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:1.05rem; transition:transform .12s, background .15s; }
.voice-msg-btn:active { transform:scale(.88); }
.chat-bubble-me .voice-msg-btn { background:rgba(255,255,255,.22); color:#fff; }
.chat-bubble-them .voice-msg-btn { background:var(--accent); color:#fff; }
.voice-msg-wave { flex:1; display:flex; align-items:center; gap:1.5px; height:28px; cursor:pointer; position:relative; }
.voice-msg-wave .vbar { width:3px; border-radius:1.5px; min-height:3px; transition:background .08s; }
.chat-bubble-me .voice-msg-wave .vbar { background:rgba(255,255,255,.35); }
.chat-bubble-me .voice-msg-wave .vbar.played { background:rgba(255,255,255,.85); }
.chat-bubble-them .voice-msg-wave .vbar { background:rgba(0,0,0,.15); }
.chat-bubble-them .voice-msg-wave .vbar.played { background:var(--accent); }
[data-theme="dark"] .chat-bubble-them .voice-msg-wave .vbar { background:rgba(255,255,255,.2); }
[data-theme="dark"] .chat-bubble-them .voice-msg-wave .vbar.played { background:var(--accent); }
.voice-msg-time { font-size:.72rem; font-weight:600; min-width:32px; text-align:right; font-variant-numeric:tabular-nums; opacity:.75; }

/* ── MEDIA IN BUBBLES ── */
.chat-media-photo img { max-width:240px; max-height:260px; border-radius:10px; cursor:pointer; display:block; object-fit:cover; }
.chat-bubble-me .chat-media-photo img { border:1px solid rgba(255,255,255,.2); }
.chat-bubble-them .chat-media-photo img { border:1px solid var(--border); }

/* ── PHOTO LIGHTBOX ── */
.photo-lightbox { position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,.85); display:flex; align-items:center; justify-content:center; cursor:pointer; }
.photo-lightbox img { max-width:92vw; max-height:92vh; border-radius:8px; object-fit:contain; }

/* ── CALL OVERLAYS ── */
#call-overlay, #incoming-overlay {
    display:none; position:fixed; inset:0; z-index:3000;
    flex-direction:column; align-items:center; overflow:hidden;
}
.co-bg {
    position:absolute; inset:0; z-index:0;
    background:linear-gradient(160deg,#1e1b4b 0%,#111827 55%,#052e16 100%);
}
.co-bg::before { content:''; position:absolute; top:8%; left:12%; width:220px; height:220px; border-radius:50%; background:rgba(99,102,241,.18); filter:blur(50px); }
.co-bg::after  { content:''; position:absolute; bottom:18%; right:8%; width:180px; height:180px; border-radius:50%; background:rgba(34,197,94,.14); filter:blur(40px); }
.co-bg-incoming::before { background:rgba(34,197,94,.22); }
.co-bg-incoming::after  { background:rgba(99,102,241,.12); }
.co-body { position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; flex:1; padding-top:72px; }
.co-incoming-label { font-size:.78rem; font-weight:700; letter-spacing:.8px; color:#86efac; text-transform:uppercase; margin-bottom:32px; }
.co-av-wrap { position:relative; width:100px; height:100px; margin-bottom:28px; }
.co-av { width:100px; height:100px; border-radius:50%; position:relative; z-index:2; background:linear-gradient(135deg,#6366f1,#8b5cf6); color:#fff; font-size:2.4rem; font-weight:900; text-transform:uppercase; display:flex; align-items:center; justify-content:center; box-shadow:0 8px 36px rgba(99,102,241,.45); }
.co-ring { position:absolute; inset:-14px; border-radius:50%; z-index:1; border:2px solid rgba(99,102,241,.45); animation:co-pulse 2.8s ease-out infinite; }
.co-ring-2 { inset:-30px; border-color:rgba(99,102,241,.22); animation-delay:.9s; }
.co-ring-g   { border-color:rgba(34,197,94,.5); }
.co-ring-g.co-ring-2 { border-color:rgba(34,197,94,.22); }
@@keyframes co-pulse { 0% { transform:scale(1); opacity:1; } 100% { transform:scale(1.45); opacity:0; } }
.co-name   { font-size:1.55rem; font-weight:800; color:#fff; margin-bottom:8px; letter-spacing:-.3px; }
.co-status { font-size:.92rem; color:rgba(255,255,255,.5); }
.co-controls { position:relative; z-index:1; display:flex; align-items:flex-start; justify-content:center; gap:36px; padding:40px 24px 56px; }
.co-ctrl-wrap { display:flex; flex-direction:column; align-items:center; gap:9px; }
.co-btn { width:64px; height:64px; border-radius:50%; border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:1.4rem; color:#fff; transition:transform .15s, box-shadow .15s; }
.co-btn:active { transform:scale(.88); }
.co-btn-mute   { background:rgba(255,255,255,.14); backdrop-filter:blur(10px); }
.co-btn-mute.muted { background:rgba(239,68,68,.7); }
.co-btn-mute:hover { background:rgba(255,255,255,.22); }
.co-btn-speaker { background:rgba(255,255,255,.14); backdrop-filter:blur(10px); }
.co-btn-speaker.speaker-on { background:rgba(34,197,94,.6); }
.co-btn-speaker:hover { background:rgba(255,255,255,.22); }
.co-btn-end    { width:72px; height:72px; font-size:1.65rem; background:#ef4444; box-shadow:0 6px 24px rgba(239,68,68,.55); }
.co-btn-end:hover { box-shadow:0 6px 32px rgba(239,68,68,.75); }
.co-btn-accept { width:72px; height:72px; font-size:1.65rem; background:#22c55e; box-shadow:0 6px 24px rgba(34,197,94,.55); animation:co-accept-glow 1.1s ease-in-out infinite; }
.co-btn-decline { background:rgba(239,68,68,.75); backdrop-filter:blur(10px); }
.co-btn-decline:hover { background:rgba(239,68,68,.9); }
@@keyframes co-accept-glow { 0%,100% { box-shadow:0 6px 24px rgba(34,197,94,.55); } 50% { box-shadow:0 6px 44px rgba(34,197,94,.9); } }
.co-btn-lbl { font-size:.74rem; color:rgba(255,255,255,.45); text-align:center; }
</style>
}

@section Scripts {
<script src="https://unpkg.com/@@daily-co/daily-js"></script>
<script>
// ── CONSTANTS ────────────────────────────────────────────
const CONV_ID    = '@convId';
const OTHER_NAME = '@otherName';
const MY_USER_ID = '@userId';
window._currentConvId = CONV_ID;

const chatBox = document.getElementById('chatBox');
if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;

console.log('[Chat] Init: CONV_ID=' + CONV_ID + ', MY_USER_ID=' + MY_USER_ID);

// ── CALL STATE ───────────────────────────────────────────
var _callFrame   = null;
var _callActive  = false;
var _isCaller    = false;
var _isMuted     = false;
var _speakerOn   = false;
var _callStart   = null;
var _timerInt    = null;
var _audioCtx    = null;
var _ringCtx     = null, _ringInt = null, _ringStop = null, _ringVibrate = null;
var _pollInt     = null;
var _lastIncoming = false;

var TXT_CALLING    = '@Html.Raw(L["Call_Calling"].Value.Replace("'","\\'"))';
var TXT_CONNECTING = '@Html.Raw(L["Call_Connecting"].Value.Replace("'","\\'"))';
var TXT_INCALL     = '@Html.Raw(L["Call_InCall"].Value.Replace("'","\\'"))';
var TXT_NO_ANSWER  = '@Html.Raw(L["Call_NoAnswer"].Value.Replace("'","\\'"))';
var TXT_LOG_CALL   = '@Html.Raw(L["Call_LogCall"].Value.Replace("'","\\'"))';
var TXT_LOG_ENDED  = '@Html.Raw(L["Call_LogEnded"].Value.Replace("'","\\'"))';
var TXT_LOG_MISSED = '@Html.Raw(L["Call_LogMissed"].Value.Replace("'","\\'"))';

// ── AUDIO ────────────────────────────────────────────────
function _ensureAudio() {
    if (!_audioCtx) _audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (_audioCtx.state === 'suspended') _audioCtx.resume();
    return _audioCtx;
}
['click','touchstart','keydown'].forEach(function(ev) {
    document.addEventListener(ev, function() { try { _ensureAudio(); } catch(e) {} }, { once: true });
});

function _beep(ctx, t0, f, d) {
    var o = ctx.createOscillator(), g = ctx.createGain();
    o.connect(g); g.connect(ctx.destination);
    o.type = 'sine'; o.frequency.value = f;
    g.gain.setValueAtTime(0, t0);
    g.gain.linearRampToValueAtTime(0.28, t0 + .02);
    g.gain.setValueAtTime(0.28, t0 + d - .04);
    g.gain.linearRampToValueAtTime(0, t0 + d);
    o.start(t0); o.stop(t0 + d);
}
function playRingtone(incoming) {
    stopRingtone();
    try { _ringCtx = _ensureAudio(); } catch(e) { return; }
    var f = incoming ? 520 : 440, iv = incoming ? 2800 : 3200;
    function ring() {
        if (!_ringCtx) return;
        try {
            var t = _ringCtx.currentTime;
            _beep(_ringCtx, t, f, .36);
            _beep(_ringCtx, t + .48, f, .36);
            if (incoming) _beep(_ringCtx, t + .96, f * 1.12, .28);
        } catch(e) {}
    }
    ring();
    _ringInt = setInterval(ring, iv);
    if (incoming && navigator.vibrate) {
        navigator.vibrate([350, 150, 350, 150, 350]);
        _ringVibrate = setInterval(function() { navigator.vibrate([350, 150, 350, 150, 350]); }, iv);
    }
}
function stopRingtone() {
    if (_ringInt)     { clearInterval(_ringInt);     _ringInt     = null; }
    if (_ringVibrate) { clearInterval(_ringVibrate); _ringVibrate = null; }
    if (navigator.vibrate) navigator.vibrate(0);
    _ringCtx = null;
}

// ── TIMER ────────────────────────────────────────────────
function startTimer() {
    _callStart = Date.now();
    var el = document.getElementById('call-status');
    _timerInt = setInterval(function() {
        if (!_callStart) return;
        var s = Math.floor((Date.now() - _callStart) / 1000);
        if (el) el.textContent = TXT_INCALL + ' · ' + Math.floor(s/60) + ':' + String(s%60).padStart(2,'0');
    }, 1000);
}
function stopTimer() { if (_timerInt) { clearInterval(_timerInt); _timerInt = null; } }
function getDuration() { return _callStart ? Math.floor((Date.now() - _callStart) / 1000) : 0; }

// ── DAILY.CO ─────────────────────────────────────────────
function _markConnected() {
    stopRingtone();
    if (_ringStop) { clearTimeout(_ringStop); _ringStop = null; }
    if (!_callStart) startTimer();
    var el = document.getElementById('call-status');
    if (el) el.textContent = TXT_INCALL;
    ['co-r1','co-r2'].forEach(function(id) {
        var r = document.getElementById(id); if (r) r.style.animationPlayState = 'paused';
    });
}

async function _joinChannel() {
    console.log('[Call] _joinChannel: CONV_ID=' + CONV_ID);
    if (!CONV_ID || CONV_ID === '00000000-0000-0000-0000-000000000000') {
        console.error('[Call] BLOCKED: CONV_ID is empty/zero!');
        throw new Error('conversationId is empty');
    }
    var resp = await fetch('/Call/Join/' + CONV_ID);
    if (!resp.ok) { console.error('[Call] Join failed:', resp.status); throw new Error('join failed: ' + resp.status); }
    var data = await resp.json();
    console.log('[Call] Join response:', JSON.stringify(data));
    _isCaller = data.isCaller;

    _callFrame = DailyIframe.createCallObject({ audioSource: true, videoSource: false });
    _callFrame.on('participant-joined', function(evt) {
        console.log('[Daily] participant-joined:', evt?.participant?.session_id, 'local=', evt?.participant?.local);
        if (evt && evt.participant && !evt.participant.local) _markConnected();
    });
    _callFrame.on('participant-left', function(evt) {
        console.log('[Daily] participant-left:', evt?.participant?.session_id);
        if (!_callActive || !_callFrame) return;
        var parts = _callFrame.participants();
        var remoteCount = Object.keys(parts).filter(function(k) { return k !== 'local'; }).length;
        if (remoteCount === 0) endCall(true);
    });
    _callFrame.on('track-started', function(evt) {
        console.log('[Daily] track-started:', evt?.track?.kind, 'local=', evt?.participant?.local);
        if (evt && evt.track && evt.track.kind === 'audio' && evt.participant && !evt.participant.local) {
            var audio = document.createElement('audio');
            audio.srcObject = new MediaStream([evt.track]);
            audio.autoplay = true;
            audio.id = 'daily-remote-audio-' + evt.participant.session_id;
            audio.volume = _speakerOn ? 1.0 : 0.6;
            if (typeof audio.setSinkId === 'function') {
                audio.setSinkId(_speakerOn ? 'default' : 'communications').catch(function(){});
            }
            document.body.appendChild(audio);
            audio.play().catch(function(e) { console.warn('[Daily] audio play blocked:', e); });
        }
    });
    _callFrame.on('track-stopped', function(evt) {
        if (evt && evt.participant && !evt.participant.local) {
            var el = document.getElementById('daily-remote-audio-' + evt.participant.session_id);
            if (el) el.remove();
        }
    });

    console.log('[Call] Joining Daily room:', data.roomUrl);
    await _callFrame.join({ url: data.roomUrl, startVideoOff: true, startAudioOff: false });
    console.log('[Call] Joined Daily room OK');
    return data;
}

async function _cleanupDaily() {
    if (_callFrame) {
        try { await _callFrame.leave(); } catch(e) {}
        try { _callFrame.destroy(); } catch(e) {}
        _callFrame = null;
    }
    document.querySelectorAll('audio[id^="daily-remote-audio-"]').forEach(function(el) { el.remove(); });
}

// ── OVERLAYS ─────────────────────────────────────────────
function _moveToBody(id) {
    var el = document.getElementById(id);
    if (el && el.parentElement !== document.body) document.body.appendChild(el);
}
function showCallOverlay() {
    _moveToBody('call-overlay'); _moveToBody('incoming-overlay');
    document.getElementById('call-overlay').style.display = 'flex';
    document.getElementById('incoming-overlay').style.display = 'none';
    document.body.style.overflow = 'hidden';
    ['co-r1','co-r2'].forEach(function(id) { var r = document.getElementById(id); if (r) r.style.animationPlayState = 'running'; });
}
function showIncomingOverlay(callerName) {
    _moveToBody('call-overlay'); _moveToBody('incoming-overlay');
    var av = document.getElementById('inc-av'), nm = document.getElementById('inc-name');
    if (av) av.textContent = callerName ? callerName[0].toUpperCase() : '?';
    if (nm) nm.textContent = callerName || '...';
    document.getElementById('incoming-overlay').style.display = 'flex';
    document.getElementById('call-overlay').style.display = 'none';
    document.body.style.overflow = 'hidden';
    playRingtone(true);
}
function hideOverlays() {
    ['call-overlay','incoming-overlay'].forEach(function(id) {
        var el = document.getElementById(id); if (el) el.style.display = 'none';
    });
    document.body.style.overflow = '';
}

// ── OUTGOING ─────────────────────────────────────────────
async function startCall() {
    console.log('[Call] startCall(), CONV_ID=' + CONV_ID);
    var btn = document.getElementById('call-btn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm" style="width:14px;height:14px;"></span>';
    try {
        showCallOverlay();
        document.getElementById('call-status').textContent = TXT_CALLING;
        playRingtone(false);
        _callActive = true;
        await _joinChannel();
        _ringStop = setTimeout(function() {
            stopRingtone();
            var el = document.getElementById('call-status');
            if (el && !_callStart) el.textContent = TXT_NO_ANSWER;
        }, 45000);
    } catch(e) {
        console.error('[Call] startCall error:', e);
        stopRingtone(); hideOverlays(); await _cleanupDaily(); _callActive = false;
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-telephone-fill"></i>';
    }
}

// ── INCOMING ─────────────────────────────────────────────
async function acceptCall() {
    stopRingtone(); stopPoll();
    try {
        showCallOverlay();
        document.getElementById('call-status').textContent = TXT_CONNECTING;
        _callActive = true;
        await _joinChannel();
    } catch(e) {
        console.error('[Call] acceptCall error:', e);
        hideOverlays(); await _cleanupDaily(); _callActive = false;
    }
}

async function declineCall() {
    stopRingtone(); hideOverlays();
    _lastIncoming = false;
    await fetch('/Call/Decline?conversationId=' + CONV_ID).catch(function(){});
    startPoll();
}

// ── END CALL ─────────────────────────────────────────────
async function endCall(remoteHungUp) {
    if (_ringStop) { clearTimeout(_ringStop); _ringStop = null; }
    stopRingtone(); stopTimer(); stopPoll();
    var duration = getDuration();
    var wasCaller = _isCaller;
    _callStart = null; _callActive = false; _isMuted = false; _isCaller = false; _speakerOn = false;
    await _cleanupDaily(); hideOverlays();
    var mi = document.getElementById('mute-icon'), mb = document.getElementById('mute-btn');
    if (mi) mi.className = 'bi bi-mic-fill';
    if (mb) mb.classList.remove('muted');
    var si = document.getElementById('speaker-icon'), sb = document.getElementById('speaker-btn');
    if (si) si.className = 'bi bi-volume-up-fill';
    if (sb) sb.classList.remove('speaker-on');
    var m = Math.floor(duration/60), s = duration%60;
    var timeStr = m + ':' + String(s).padStart(2,'0');
    var msgText;
    if (duration < 5)      msgText = TXT_LOG_MISSED;
    else if (remoteHungUp) msgText = TXT_LOG_ENDED + ' · ' + timeStr;
    else                   msgText = TXT_LOG_CALL  + ' · ' + timeStr;
    _appendBubble(msgText, new Date().toISOString(), true);
    if (wasCaller) fetch('/Call/Log?conversationId=' + CONV_ID + '&duration=' + duration).catch(function(){});
    startPoll();
}

// ── MUTE ─────────────────────────────────────────────────
function toggleMute() {
    if (!_callFrame) return;
    _isMuted = !_isMuted;
    _callFrame.setLocalAudio(!_isMuted);
    var mi = document.getElementById('mute-icon'), mb = document.getElementById('mute-btn');
    if (mi) mi.className = _isMuted ? 'bi bi-mic-mute-fill' : 'bi bi-mic-fill';
    if (mb) mb.classList.toggle('muted', _isMuted);
}

function toggleSpeaker() {
    _speakerOn = !_speakerOn;
    var si = document.getElementById('speaker-icon'), sb = document.getElementById('speaker-btn');
    var lbl = document.getElementById('speaker-lbl');
    if (si) si.className = _speakerOn ? 'bi bi-volume-up-fill' : 'bi bi-earbuds';
    if (sb) sb.classList.toggle('speaker-on', _speakerOn);
    if (lbl) lbl.textContent = _speakerOn ? '@L["Chat_SpeakerLoud"]' : '@L["Chat_SpeakerEarpiece"]';
    document.querySelectorAll('audio[id^="daily-remote-audio-"]').forEach(function(el) {
        if (typeof el.setSinkId === 'function') {
            el.setSinkId(_speakerOn ? 'default' : 'communications').catch(function(){});
        }
        el.volume = _speakerOn ? 1.0 : 0.6;
    });
}

// ── INCOMING POLL (chat page — polls for THIS conversation) ──
function startPoll() {
    if (_pollInt) return;
    _pollInt = setInterval(async function() {
        if (_callActive) return;
        try {
            var r = await fetch('/Call/Poll?conversationId=' + CONV_ID);
            var d = await r.json();
            if (d.incoming && !_lastIncoming) {
                _lastIncoming = true;
                showIncomingOverlay(d.callerName);
            } else if (!d.incoming && _lastIncoming) {
                _lastIncoming = false;
                if (document.getElementById('incoming-overlay')?.style.display === 'flex')
                    hideOverlays();
            }
        } catch(e) {}
    }, 3000);
}
function stopPoll() { if (_pollInt) { clearInterval(_pollInt); _pollInt = null; } _lastIncoming = false; }

document.addEventListener('keydown', function(e) {
    if (e.key !== 'Escape') return;
    if (document.getElementById('call-overlay')?.style.display === 'flex') endCall(false);
    if (document.getElementById('incoming-overlay')?.style.display === 'flex') declineCall();
});
window.addEventListener('beforeunload', function() {
    try { if (_callFrame) { _callFrame.leave(); _callFrame.destroy(); } } catch(e) {}
    stopRingtone();
});

startPoll();

// Auto-accept if navigated from global overlay (once only)
if (new URLSearchParams(location.search).get('accept') === '1') {
    history.replaceState(null, '', location.pathname);
    setTimeout(function() { if (!_callActive) acceptCall().catch(function(){}); }, 600);
}

// SignalR: incoming call pushed by layout
window.addEventListener('signalr:incomingCall', function(e) {
    var d = e.detail;
    console.log('[Chat] signalr:incomingCall:', d, '_callActive=', _callActive);
    if (!d || String(d.conversationId) !== CONV_ID) return;
    if (!_callActive && !_lastIncoming) {
        _lastIncoming = true;
        showIncomingOverlay(d.callerName);
    }
});

window.addEventListener('signalr:callDeclined', function(e) {
    var d = e.detail;
    if (!d || String(d.conversationId) !== CONV_ID) return;
    if (_callActive && _isCaller) {
        stopRingtone();
        var el = document.getElementById('call-status');
        if (el) el.textContent = '@Html.Raw(L["Call_Decline"].Value)';
        setTimeout(function() { if (_callActive) endCall(false); }, 2000);
    }
});

// ── PHOTO LIGHTBOX ───────────────────────────────────────
window._openPhoto = function(src) {
    var lb = document.getElementById('photoLightbox');
    document.getElementById('lightboxImg').src = src;
    lb.style.display = 'flex';
};

// ── MEDIA CONTENT RENDERING ──────────────────────────────
function _renderMediaContent(text) {
    if (text.startsWith('[voice]')) {
        var u = _esc(text.substring(7));
        return '<div class="voice-msg" data-src="' + u + '">' +
            '<button class="voice-msg-btn" type="button"><i class="bi bi-play-fill"></i></button>' +
            '<div class="voice-msg-wave"></div>' +
            '<span class="voice-msg-time">0:00</span></div>';
    }
    if (text.startsWith('[photo]')) {
        var u = _esc(text.substring(7));
        return '<div class="chat-media-photo"><img src="' + u + '" alt="photo" loading="lazy" onclick="window._openPhoto(this.src)" /></div>';
    }
    return '<div class="chat-bubble-text">' + _esc(text) + '</div>';
}

// ── REAL-TIME MESSAGES (SignalR) ─────────────────────────
window.addEventListener('signalr:message', function(e) {
    var msg = e.detail;
    if (!msg || String(msg.conversationId) !== CONV_ID) return;
    if (String(msg.senderId) === MY_USER_ID) return;
    _appendBubble(msg.text, msg.createdDate, false);
    fetch('/Messages/MarkRead?conversationId=' + CONV_ID, { method: 'POST', credentials: 'same-origin' });
});

// ── AJAX TEXT SEND ───────────────────────────────────────
(function() {
    var form = document.querySelector('.chat-input-form');
    if (!form) return;
    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        var input = form.querySelector('.chat-input');
        var text  = (input.value || '').trim();
        if (!text) return;
        _appendBubble(text, new Date().toISOString(), true);
        input.value = '';
        input.focus();
        try {
            var fd = new FormData(form);
            fd.set('text', text);
            await fetch('/Messages/Send', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: fd
            });
        } catch(err) { console.error('Send failed:', err); }
    });
})();

// ── PHOTO UPLOAD ─────────────────────────────────────────
(function() {
    var photoInput = document.getElementById('photoInput');
    var photoBtn   = document.getElementById('photoBtn');
    photoBtn.addEventListener('click', function() { photoInput.click(); });
    photoInput.addEventListener('change', async function() {
        var file = photoInput.files[0];
        if (!file) return;
        photoInput.value = '';
        var tempUrl = URL.createObjectURL(file);
        _appendBubble('[photo]' + tempUrl, new Date().toISOString(), true);
        var fd = new FormData();
        fd.append('conversationId', CONV_ID);
        fd.append('file', file);
        fd.append('type', 'photo');
        try {
            var resp = await fetch('/Messages/SendMedia', { method: 'POST', body: fd });
            if (!resp.ok) console.error('Photo upload failed:', resp.status);
        } catch(err) { console.error('Photo upload error:', err); }
    });
})();

// ── VOICE RECORDING ──────────────────────────────────────
(function() {
    var voiceBtn  = document.getElementById('voiceBtn');
    var recPanel  = document.getElementById('voiceRecording');
    var recTime   = document.getElementById('recTime');
    var recCancel = document.getElementById('recCancel');
    var recSend   = document.getElementById('recSend');
    var inputForm = document.querySelector('.chat-input-form');
    var mediaRec = null, chunks = [], recStart = null, timerInt = null;

    function updateTimer() {
        if (!recStart) return;
        var s = Math.floor((Date.now() - recStart) / 1000);
        recTime.textContent = Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
    }
    async function startRecording() {
        try {
            var stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            mediaRec = new MediaRecorder(stream, { mimeType: 'audio/webm;codecs=opus' });
            chunks = [];
            mediaRec.ondataavailable = function(e) { if (e.data.size > 0) chunks.push(e.data); };
            mediaRec.start();
            recStart = Date.now();
            timerInt = setInterval(updateTimer, 1000);
            recTime.textContent = '0:00';
            inputForm.style.display = 'none';
            recPanel.style.display  = 'flex';
            voiceBtn.classList.add('recording');
        } catch(err) { console.error('Mic access denied:', err); }
    }
    function stopRecording() {
        if (mediaRec && mediaRec.state !== 'inactive') {
            mediaRec.stream.getTracks().forEach(function(t) { t.stop(); });
            mediaRec.stop();
        }
        if (timerInt) { clearInterval(timerInt); timerInt = null; }
        recStart = null;
        inputForm.style.display = '';
        recPanel.style.display  = 'none';
        voiceBtn.classList.remove('recording');
    }
    voiceBtn.addEventListener('click', function() {
        if (mediaRec && mediaRec.state === 'recording') stopRecording();
        else startRecording();
    });
    recCancel.addEventListener('click', function() { chunks = []; stopRecording(); });
    recSend.addEventListener('click', function() {
        if (!mediaRec || mediaRec.state === 'inactive') return;
        mediaRec.onstop = async function() {
            var blob = new Blob(chunks, { type: 'audio/webm' });
            chunks = [];
            if (blob.size === 0) return;
            _appendBubble('[voice]#', new Date().toISOString(), true);
            var fd = new FormData();
            fd.append('conversationId', CONV_ID);
            fd.append('file', blob, 'voice.webm');
            fd.append('type', 'voice');
            try {
                var resp = await fetch('/Messages/SendMedia', { method: 'POST', body: fd });
                if (!resp.ok) console.error('Voice upload failed:', resp.status);
            } catch(err) { console.error('Voice upload error:', err); }
        };
        stopRecording();
    });
})();

// ── HELPERS ──────────────────────────────────────────────
function _appendBubble(text, isoDate, isMe) {
    if (!chatBox) return;
    var empty = chatBox.querySelector('.chat-empty');
    if (empty) empty.remove();
    var d    = isoDate ? new Date(isoDate) : new Date();
    var time = d.toLocaleTimeString('ru', { hour: '2-digit', minute: '2-digit' });
    var row  = document.createElement('div');
    row.className = 'chat-msg-row ' + (isMe ? 'chat-msg-me' : 'chat-msg-them');
    row.innerHTML =
        '<div class="chat-bubble ' + (isMe ? 'chat-bubble-me' : 'chat-bubble-them') + '">' +
            _renderMediaContent(text) +
            '<div class="chat-bubble-time' + (isMe ? ' justify-content-end' : '') + '">' +
                '<span>' + time + '</span>' +
                (isMe ? '<i class="bi bi-check2"></i>' : '') +
            '</div>' +
        '</div>';
    chatBox.appendChild(row);
    chatBox.scrollTop = chatBox.scrollHeight;
}
function _esc(s) {
    return String(s)
        .replace(/&/g,'&amp;').replace(/</g,'&lt;')
        .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ── VOICE PLAYER (Telegram-style) ────────────────────────
(function() {
    var BAR_COUNT = 40;
    var _activeAudio = null;
    var _activeEl = null;
    var _rafId = null;

    function hashCode(s) {
        for (var h = 0, i = 0; i < s.length; i++)
            h = ((h << 5) - h + s.charCodeAt(i)) | 0;
        return h;
    }

    function genBars(container, src) {
        if (container.children.length) return;
        var seed = Math.abs(hashCode(src || ''));
        for (var i = 0; i < BAR_COUNT; i++) {
            var bar = document.createElement('div');
            bar.className = 'vbar';
            seed = (seed * 16807 + 7) % 2147483647;
            var h = 4 + Math.round(((seed % 1000) / 1000) * 20);
            bar.style.height = h + 'px';
            container.appendChild(bar);
        }
    }

    function fmtTime(sec) {
        if (!sec || !isFinite(sec)) return '0:00';
        var m = Math.floor(sec / 60);
        var s = Math.floor(sec % 60);
        return m + ':' + (s < 10 ? '0' : '') + s;
    }

    function updateProgress(el, audio) {
        var wave = el.querySelector('.voice-msg-wave');
        var bars = wave.querySelectorAll('.vbar');
        var pct = audio.duration ? audio.currentTime / audio.duration : 0;
        var active = Math.floor(pct * bars.length);
        for (var i = 0; i < bars.length; i++)
            bars[i].classList.toggle('played', i < active);
        el.querySelector('.voice-msg-time').textContent = fmtTime(audio.currentTime);
    }

    function tick() {
        if (_activeAudio && _activeEl && !_activeAudio.paused) {
            updateProgress(_activeEl, _activeAudio);
            _rafId = requestAnimationFrame(tick);
        }
    }

    function stopCurrent() {
        if (_activeAudio) {
            _activeAudio.pause();
            _activeAudio.currentTime = 0;
        }
        if (_activeEl) {
            _activeEl.querySelector('.voice-msg-btn i').className = 'bi bi-play-fill';
            var bars = _activeEl.querySelectorAll('.vbar');
            for (var i = 0; i < bars.length; i++) bars[i].classList.remove('played');
            _activeEl.querySelector('.voice-msg-time').textContent = fmtTime(_activeAudio ? _activeAudio.duration : 0);
        }
        if (_rafId) cancelAnimationFrame(_rafId);
        _activeAudio = null; _activeEl = null;
    }

    function initVoice(el) {
        if (el._voiceInit) return;
        el._voiceInit = true;
        var src = el.getAttribute('data-src');
        if (!src || src === '#') return;
        var wave = el.querySelector('.voice-msg-wave');
        genBars(wave, src);

        var audio = new Audio();
        audio.preload = 'metadata';
        audio.src = src;
        el._audio = audio;

        audio.addEventListener('loadedmetadata', function() {
            el.querySelector('.voice-msg-time').textContent = fmtTime(audio.duration);
        });
        audio.addEventListener('ended', function() {
            stopCurrent();
        });

        el.querySelector('.voice-msg-btn').addEventListener('click', function() {
            if (_activeAudio === audio && !audio.paused) {
                audio.pause();
                el.querySelector('.voice-msg-btn i').className = 'bi bi-play-fill';
                if (_rafId) cancelAnimationFrame(_rafId);
                return;
            }
            if (_activeAudio && _activeAudio !== audio) stopCurrent();
            _activeAudio = audio; _activeEl = el;
            el.querySelector('.voice-msg-btn i').className = 'bi bi-pause-fill';
            audio.play();
            _rafId = requestAnimationFrame(tick);
        });

        wave.addEventListener('click', function(e) {
            if (!audio.duration) return;
            var rect = wave.getBoundingClientRect();
            var pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
            audio.currentTime = pct * audio.duration;
            if (_activeAudio !== audio) {
                if (_activeAudio) stopCurrent();
                _activeAudio = audio; _activeEl = el;
                el.querySelector('.voice-msg-btn i').className = 'bi bi-pause-fill';
                audio.play();
                _rafId = requestAnimationFrame(tick);
            }
            updateProgress(el, audio);
        });
    }

    function initAll() {
        document.querySelectorAll('.voice-msg').forEach(initVoice);
    }
    initAll();

    var obs = new MutationObserver(function() { requestAnimationFrame(initAll); });
    if (chatBox) obs.observe(chatBox, { childList: true, subtree: true });
})();
</script>
}
