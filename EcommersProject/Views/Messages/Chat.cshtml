@model EcommersProject.BLL.DTOs.ConversationGetDto
@{
    ViewData["Title"]         = L["Messages_Title"].Value;
    ViewData["HideFooter"]    = true;
    ViewData["HideNavSearch"] = true;
    var userId       = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isBuyer      = Model.BuyerId.ToString() == userId;
    var otherName    = (isBuyer ? Model.SellerName : Model.BuyerName) ?? "?";
    var otherInitial = otherName.Length > 0 ? char.ToUpper(otherName[0]).ToString() : "?";
    var convId       = Model.Id.ToString();
}

<div class="chat-outer">
<div class="chat-sidebar-col d-none d-md-block">
    @await Html.PartialAsync("_ProfileSidebar")
</div>
<div class="chat-wrap">
    <!-- Header -->
    <div class="chat-header">
        <a href="/Messages" class="chat-back-btn"><i class="bi bi-arrow-left"></i></a>
        @if (Model.ListingImage != null)
        { <img src="@Model.ListingImage" class="chat-header-img" /> }
        else
        { <div class="chat-header-img-ph"><i class="bi bi-image"></i></div> }
        <div class="chat-header-info">
            <div class="chat-header-name">@otherName</div>
            <a href="/Listing/Detail/@Model.ListingId" class="chat-header-listing">
                @Model.ListingTitle@(Model.ListingPrice.HasValue ? $" — {Model.ListingPrice.Value:N0} ₼" : "")
            </a>
        </div>
        <button id="call-btn" class="chat-call-btn" onclick="startCall()">
            <i class="bi bi-telephone-fill"></i>
        </button>
    </div>

    <!-- Messages -->
    <div id="chatBox" class="chat-box">
        @if (Model.Messages == null || !Model.Messages.Any())
        { <div class="chat-empty">@L["Messages_FirstMsg"]</div> }
        @foreach (var msg in Model.Messages ?? [])
        {
            var isMe = msg.SenderId.ToString() == userId;
            <div class="chat-msg-row @(isMe?"chat-msg-me":"chat-msg-them")">
                <div class="chat-bubble @(isMe?"chat-bubble-me":"chat-bubble-them")">
                    <div class="chat-bubble-text">@msg.Text</div>
                    <div class="chat-bubble-time @(isMe?"justify-content-end":"")">
                        <span>@msg.CreatedDate.ToLocalTime().ToString("HH:mm")</span>
                        @if (isMe){ <i class="bi @(msg.IsRead?"bi-check2-all":"bi-check2")"></i> }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Input -->
    <div class="chat-input-wrap">
        <form asp-controller="Messages" asp-action="Send" method="post" class="chat-input-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="conversationId" value="@Model.Id" />
            <input type="text" name="text" class="chat-input"
                   placeholder="@L["Messages_InputPlaceholder"]" required autocomplete="off" />
            <button type="submit" class="chat-send-btn"><i class="bi bi-send-fill"></i></button>
        </form>
    </div>
</div><!-- /chat-wrap -->
</div><!-- /chat-outer -->

<!-- ═══ OUTGOING / ACTIVE CALL OVERLAY ═══ -->
<div id="call-overlay">
    <div class="co-bg"></div>
    <div class="co-body">
        <div class="co-av-wrap">
            <div class="co-ring co-ring-1" id="co-r1"></div>
            <div class="co-ring co-ring-2" id="co-r2"></div>
            <div class="co-av">@otherInitial</div>
        </div>
        <div class="co-name">@otherName</div>
        <div class="co-status" id="call-status">@L["Call_Calling"]</div>
    </div>
    <div class="co-controls">
        <div class="co-ctrl-wrap">
            <button class="co-btn co-btn-mute" id="mute-btn" onclick="toggleMute()">
                <i class="bi bi-mic-fill" id="mute-icon"></i>
            </button>
            <span class="co-btn-lbl">@L["Call_Mic"]</span>
        </div>
        <div class="co-ctrl-wrap">
            <button class="co-btn co-btn-end" onclick="endCall(false)">
                <i class="bi bi-telephone-x-fill"></i>
            </button>
            <span class="co-btn-lbl">@L["Call_End"]</span>
        </div>
    </div>
</div>

<!-- ═══ INCOMING CALL OVERLAY ═══ -->
<div id="incoming-overlay">
    <div class="co-bg co-bg-incoming"></div>
    <div class="co-body">
        <div class="co-incoming-label">@L["Call_Incoming"]</div>
        <div class="co-av-wrap">
            <div class="co-ring co-ring-1 co-ring-g"></div>
            <div class="co-ring co-ring-2 co-ring-g" style="animation-delay:.7s"></div>
            <div class="co-av" id="inc-av">?</div>
        </div>
        <div class="co-name" id="inc-name">...</div>
        <div class="co-status">@L["Call_Incoming"]</div>
    </div>
    <div class="co-controls">
        <div class="co-ctrl-wrap">
            <button class="co-btn co-btn-decline" onclick="declineCall()">
                <i class="bi bi-telephone-x-fill"></i>
            </button>
            <span class="co-btn-lbl">@L["Call_Decline"]</span>
        </div>
        <div class="co-ctrl-wrap">
            <button class="co-btn co-btn-accept" onclick="acceptCall()">
                <i class="bi bi-telephone-fill"></i>
            </button>
            <span class="co-btn-lbl">@L["Call_Accept"]</span>
        </div>
    </div>
</div>

@section Styles {
<style>
/* ── DESKTOP LAYOUT ── */
.chat-outer {
    display:flex; align-items:flex-start; gap:28px;
    max-width:1060px; margin:0 auto;
    padding:32px 16px 0;
    height:calc(100vh - 64px);
}
.chat-sidebar-col { width:240px; flex-shrink:0; align-self:flex-start; }
/* ── CHAT WRAP ── */
.chat-wrap {
    flex:1; display:flex; flex-direction:column; min-width:0;
    align-self:stretch; /* fills full height of chat-outer */
    border:1px solid var(--border); border-radius:14px 14px 0 0; overflow:hidden;
}
/* ── CHAT BOX ── */
.chat-box { min-height:0; } /* allow flex shrink in nested flex */

@@media (max-width:767px) {
    .chat-outer { max-width:100%; margin:0; padding:0; gap:0; height:calc(100vh - 64px); }
    .chat-wrap  { border:none; border-radius:0; align-self:auto; height:100%; }
}

/* ── HEADER ── */
.chat-header { display:flex; align-items:center; gap:12px; padding:12px 16px; background:var(--card); border-bottom:1px solid var(--border); flex-shrink:0; }
.chat-back-btn { display:flex; align-items:center; justify-content:center; width:36px; height:36px; border-radius:50%; background:var(--bg); border:1.5px solid var(--border); color:var(--text); text-decoration:none; flex-shrink:0; transition:background .15s; }
.chat-back-btn:hover { background:var(--accent-soft); color:var(--accent); }
.chat-header-img { width:44px; height:44px; border-radius:10px; object-fit:cover; flex-shrink:0; }
.chat-header-img-ph { width:44px; height:44px; border-radius:10px; flex-shrink:0; background:var(--bg); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; font-size:1.2rem; color:var(--muted); }
.chat-header-info { flex:1; min-width:0; }
.chat-header-name { font-weight:700; font-size:.95rem; color:var(--text); }
.chat-header-listing { display:block; font-size:.75rem; color:var(--accent); text-decoration:none; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.chat-call-btn { width:40px; height:40px; border-radius:50%; flex-shrink:0; background:#22c55e; color:#fff; border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:.95rem; transition:background .15s, transform .1s; box-shadow:0 2px 8px rgba(34,197,94,.4); }
.chat-call-btn:hover { background:#16a34a; }
.chat-call-btn:active { transform:scale(.92); }
.chat-call-btn:disabled { background:var(--muted); box-shadow:none; cursor:not-allowed; }

/* ── MESSAGES ── */
.chat-box { flex:1; overflow-y:auto; padding:16px 12px; display:flex; flex-direction:column; gap:6px; background:var(--bg); scrollbar-width:thin; scrollbar-color:var(--border) transparent; }
.chat-empty { flex:1; display:flex; align-items:center; justify-content:center; color:var(--muted); font-size:.9rem; text-align:center; padding:32px; }
.chat-msg-row { display:flex; }
.chat-msg-me    { justify-content:flex-end; }
.chat-msg-them  { justify-content:flex-start; }
.chat-bubble { max-width:72%; padding:9px 13px; border-radius:16px; word-break:break-word; line-height:1.5; }
.chat-bubble-me   { background:var(--accent); color:#fff; border-bottom-right-radius:4px; }
.chat-bubble-them { background:var(--card); color:var(--text); border:1px solid var(--border); border-bottom-left-radius:4px; }
.chat-bubble-text { font-size:.9rem; }
.chat-bubble-time { display:flex; align-items:center; gap:3px; font-size:.68rem; opacity:.75; margin-top:4px; }
.chat-bubble-me   .chat-bubble-time { color:rgba(255,255,255,.85); }
.chat-bubble-them .chat-bubble-time { color:var(--muted); }

/* ── INPUT ── */
.chat-input-wrap { flex-shrink:0; padding:10px 12px; background:var(--card); border-top:1px solid var(--border); }
.chat-input-form { display:flex; align-items:center; gap:8px; }
.chat-input { flex:1; border:1.5px solid var(--border); border-radius:24px; padding:10px 16px; font-size:.9rem; font-family:inherit; color:var(--text); background:var(--bg); outline:none; transition:border-color .15s; }
.chat-input:focus { border-color:var(--accent); }
.chat-send-btn { width:42px; height:42px; border-radius:50%; flex-shrink:0; background:var(--accent); color:#fff; border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:1rem; transition:background .15s, transform .1s; }
.chat-send-btn:active { transform:scale(.92); }

/* ══════════════════════════════════════════
   CALL OVERLAYS
══════════════════════════════════════════ */
#call-overlay, #incoming-overlay {
    display:none; position:fixed; inset:0; z-index:3000;
    flex-direction:column; align-items:center; overflow:hidden;
}
.co-bg {
    position:absolute; inset:0; z-index:0;
    background:linear-gradient(160deg,#1e1b4b 0%,#111827 55%,#052e16 100%);
}
.co-bg::before { content:''; position:absolute; top:8%; left:12%; width:220px; height:220px; border-radius:50%; background:rgba(99,102,241,.18); filter:blur(50px); }
.co-bg::after  { content:''; position:absolute; bottom:18%; right:8%; width:180px; height:180px; border-radius:50%; background:rgba(34,197,94,.14); filter:blur(40px); }
.co-bg-incoming::before { background:rgba(34,197,94,.22); }
.co-bg-incoming::after  { background:rgba(99,102,241,.12); }
.co-body { position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; flex:1; padding-top:72px; }
.co-incoming-label { font-size:.78rem; font-weight:700; letter-spacing:.8px; color:#86efac; text-transform:uppercase; margin-bottom:32px; }
.co-av-wrap { position:relative; width:100px; height:100px; margin-bottom:28px; }
.co-av { width:100px; height:100px; border-radius:50%; position:relative; z-index:2; background:linear-gradient(135deg,#6366f1,#8b5cf6); color:#fff; font-size:2.4rem; font-weight:900; text-transform:uppercase; display:flex; align-items:center; justify-content:center; box-shadow:0 8px 36px rgba(99,102,241,.45); }
.co-ring { position:absolute; inset:-14px; border-radius:50%; z-index:1; border:2px solid rgba(99,102,241,.45); animation:co-pulse 2.8s ease-out infinite; }
.co-ring-2 { inset:-30px; border-color:rgba(99,102,241,.22); animation-delay:.9s; }
.co-ring-g   { border-color:rgba(34,197,94,.5); }
.co-ring-g.co-ring-2 { border-color:rgba(34,197,94,.22); }
@@keyframes co-pulse { 0% { transform:scale(1); opacity:1; } 100% { transform:scale(1.45); opacity:0; } }
.co-name   { font-size:1.55rem; font-weight:800; color:#fff; margin-bottom:8px; letter-spacing:-.3px; }
.co-status { font-size:.92rem; color:rgba(255,255,255,.5); }
.co-controls { position:relative; z-index:1; display:flex; align-items:flex-start; justify-content:center; gap:36px; padding:40px 24px 56px; }
.co-ctrl-wrap { display:flex; flex-direction:column; align-items:center; gap:9px; }
.co-btn { width:64px; height:64px; border-radius:50%; border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:1.4rem; color:#fff; transition:transform .15s, box-shadow .15s; }
.co-btn:active { transform:scale(.88); }
.co-btn-mute   { background:rgba(255,255,255,.14); backdrop-filter:blur(10px); }
.co-btn-mute.muted { background:rgba(239,68,68,.7); }
.co-btn-mute:hover { background:rgba(255,255,255,.22); }
.co-btn-end    { width:72px; height:72px; font-size:1.65rem; background:#ef4444; box-shadow:0 6px 24px rgba(239,68,68,.55); }
.co-btn-end:hover { box-shadow:0 6px 32px rgba(239,68,68,.75); }
.co-btn-accept { width:72px; height:72px; font-size:1.65rem; background:#22c55e; box-shadow:0 6px 24px rgba(34,197,94,.55); animation:co-accept-glow 1.1s ease-in-out infinite; }
.co-btn-decline { background:rgba(239,68,68,.75); backdrop-filter:blur(10px); }
.co-btn-decline:hover { background:rgba(239,68,68,.9); }
@@keyframes co-accept-glow { 0%,100% { box-shadow:0 6px 24px rgba(34,197,94,.55); } 50% { box-shadow:0 6px 44px rgba(34,197,94,.9); } }
.co-btn-lbl { font-size:.74rem; color:rgba(255,255,255,.45); text-align:center; }
</style>
}

@section Scripts {
<script src="https://unpkg.com/@@daily-co/daily-js"></script>
<script>
// ── CORE CONSTANTS ────────────────────────────────────────
const CONV_ID    = '@convId';
const OTHER_NAME = '@otherName';

const chatBox = document.getElementById('chatBox');
if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;

// ── STATE ─────────────────────────────────────────────────
let _call        = null;
let _callActive  = false;
let _isCaller    = false;
let _isMuted     = false;
let _callStart   = null;
let _timerInt    = null;
let _audioCtx    = null; // persistent, unlocked on first gesture
let _ringCtx     = null, _ringInt = null, _ringStop = null, _ringVibrate = null;
let _pollInt     = null;
let _lastIncoming = false;
const _audioEls  = []; // remote audio elements (createCallObject needs manual playback)

// ── Identity (for real-time message routing) ─────────────
const MY_USER_ID = '@userId';
window._currentConvId = CONV_ID; // tell layout's SignalR handler which chat is open

// ── Localized UI strings (server-rendered) ───────────────
const TXT_CALLING    = '@Html.Raw(L["Call_Calling"].Value.Replace("'","\\'"  ))';
const TXT_CONNECTING = '@Html.Raw(L["Call_Connecting"].Value.Replace("'","\\'"  ))';
const TXT_INCALL     = '@Html.Raw(L["Call_InCall"].Value.Replace("'","\\'"  ))';
const TXT_NO_ANSWER  = '@Html.Raw(L["Call_NoAnswer"].Value.Replace("'","\\'"  ))';
const TXT_LOG_CALL   = '@Html.Raw(L["Call_LogCall"].Value.Replace("'","\\'"  ))';
const TXT_LOG_ENDED  = '@Html.Raw(L["Call_LogEnded"].Value.Replace("'","\\'"  ))';
const TXT_LOG_MISSED = '@Html.Raw(L["Call_LogMissed"].Value.Replace("'","\\'"  ))';


// ── AUDIO CONTEXT — unlock on first user gesture ──────────
function _ensureAudio() {
    if (!_audioCtx) _audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (_audioCtx.state === 'suspended') _audioCtx.resume();
    return _audioCtx;
}
['click','touchstart','keydown'].forEach(ev =>
    document.addEventListener(ev, () => { try { _ensureAudio(); } catch {} }, { once: true })
);

// ── RINGTONE (Web Audio API) ──────────────────────────────
function _beep(ctx, t0, f, d) {
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.connect(g); g.connect(ctx.destination);
    o.type = 'sine'; o.frequency.value = f;
    g.gain.setValueAtTime(0, t0);
    g.gain.linearRampToValueAtTime(0.28, t0 + .02);
    g.gain.setValueAtTime(0.28, t0 + d - .04);
    g.gain.linearRampToValueAtTime(0, t0 + d);
    o.start(t0); o.stop(t0 + d);
}
function playRingtone(incoming = false) {
    stopRingtone();
    try { _ringCtx = _ensureAudio(); } catch { return; }
    const f = incoming ? 520 : 440, iv = incoming ? 2800 : 3200;
    function ring() {
        if (!_ringCtx) return;
        try {
            const t = _ringCtx.currentTime;
            _beep(_ringCtx, t,       f,      .36);
            _beep(_ringCtx, t + .48, f,      .36);
            if (incoming) _beep(_ringCtx, t + .96, f * 1.12, .28); // triple ring for incoming
        } catch {}
    }
    ring();
    _ringInt = setInterval(ring, iv);
    // Vibration for mobile (incoming only)
    if (incoming && navigator.vibrate) {
        navigator.vibrate([350, 150, 350, 150, 350]);
        _ringVibrate = setInterval(() => navigator.vibrate([350, 150, 350, 150, 350]), iv);
    }
}
function stopRingtone() {
    if (_ringInt)     { clearInterval(_ringInt);     _ringInt     = null; }
    if (_ringVibrate) { clearInterval(_ringVibrate); _ringVibrate = null; }
    if (navigator.vibrate) navigator.vibrate(0);
    _ringCtx = null; // don't close _audioCtx — reuse it next time
}

// ── TIMER ─────────────────────────────────────────────────
function startTimer() {
    _callStart = Date.now();
    const el = document.getElementById('call-status');
    _timerInt = setInterval(() => {
        if (!_callStart) return;
        const s = Math.floor((Date.now() - _callStart) / 1000);
        if (el) el.textContent = TXT_INCALL + ' · ' + Math.floor(s/60) + ':' + String(s%60).padStart(2,'0');
    }, 1000);
}
function stopTimer() { if (_timerInt) { clearInterval(_timerInt); _timerInt = null; } }
function getDuration() { return _callStart ? Math.floor((Date.now() - _callStart) / 1000) : 0; }

// ── DAILY-JS CALL OBJECT ──────────────────────────────────
async function initCall() {
    if (_call) return;
    _call = window.DailyIframe.createCallObject({ audioSource: true, videoSource: false });

    _call.on('participant-joined', evt => {
        if (evt.participant.local) return;
        stopRingtone();
        if (_ringStop) { clearTimeout(_ringStop); _ringStop = null; }
        if (!_callStart) startTimer();
        const el = document.getElementById('call-status');
        if (el) el.textContent = TXT_INCALL;
        ['co-r1','co-r2'].forEach(id => {
            const r = document.getElementById(id); if (r) r.style.animationPlayState = 'paused';
        });
    });

    _call.on('participant-left', evt => {
        if (evt.participant.local) return;
        const parts = _call ? Object.keys(_call.participants()).filter(k => k !== 'local') : [];
        if (parts.length === 0 && _callActive) endCall(true);
    });

    // CRITICAL: createCallObject (headless) does NOT auto-play remote audio.
    // We must manually create an <audio> element for each remote track.
    _call.on('track-started', evt => {
        if (evt.participant?.local || evt.track?.kind !== 'audio') return;
        const audio = document.createElement('audio');
        audio.srcObject = new MediaStream([evt.track]);
        audio.autoplay = true;
        document.body.appendChild(audio);
        _audioEls.push(audio);
        audio.play().catch(e => console.warn('audio play:', e));
    });

    _call.on('track-stopped', evt => {
        if (evt.participant?.local || evt.track?.kind !== 'audio') return;
        _audioEls.forEach(a => {
            const tracks = a.srcObject ? a.srcObject.getTracks() : [];
            if (tracks.includes(evt.track)) { a.srcObject = null; a.remove(); }
        });
    });

    _call.on('left-meeting', () => { _callActive = false; });
    _call.on('error', evt => { console.error('Daily error', evt); endCall(false); });
}

// ── OVERLAYS ──────────────────────────────────────────────
function _moveToBody(id) {
    const el = document.getElementById(id);
    if (el && el.parentElement !== document.body) document.body.appendChild(el);
}
function showCallOverlay() {
    _moveToBody('call-overlay'); _moveToBody('incoming-overlay');
    document.getElementById('call-overlay').style.display = 'flex';
    document.getElementById('incoming-overlay').style.display = 'none';
    document.body.style.overflow = 'hidden';
    ['co-r1','co-r2'].forEach(id => { const r = document.getElementById(id); if (r) r.style.animationPlayState = 'running'; });
}
function showIncomingOverlay(callerName) {
    _moveToBody('call-overlay'); _moveToBody('incoming-overlay');
    const av = document.getElementById('inc-av'), nm = document.getElementById('inc-name');
    if (av) av.textContent = callerName ? callerName[0].toUpperCase() : '?';
    if (nm) nm.textContent = callerName || '...';
    document.getElementById('incoming-overlay').style.display = 'flex';
    document.getElementById('call-overlay').style.display = 'none';
    document.body.style.overflow = 'hidden';
    playRingtone(true);
}
function hideOverlays() {
    ['call-overlay','incoming-overlay'].forEach(id => {
        const el = document.getElementById(id); if (el) el.style.display = 'none';
    });
    document.body.style.overflow = '';
}

// ── OUTGOING CALL ─────────────────────────────────────────
async function startCall() {
    const btn = document.getElementById('call-btn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm" style="width:14px;height:14px;"></span>';
    try {
        await navigator.mediaDevices.getUserMedia({ audio: true });

        const resp = await fetch('/Call/Join/' + CONV_ID);
        if (!resp.ok) throw new Error(resp.status);
        const data = await resp.json();
        _isCaller = data.isCaller;

        await initCall();
        showCallOverlay();
        document.getElementById('call-status').textContent = TXT_CALLING;
        playRingtone(false);
        _callActive = true;

        const joinOpts = { url: data.url, startVideoOff: true, startAudioOff: false };
        if (data.token) joinOpts.token = data.token;
        await _call.join(joinOpts);

        _ringStop = setTimeout(() => {
            stopRingtone();
            const el = document.getElementById('call-status');
            if (el && !_callStart) el.textContent = TXT_NO_ANSWER;
        }, 45000);
    } catch(e) {
        console.error(e);
        hideOverlays();
        _callActive = false;
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-telephone-fill"></i>';
    }
}

// ── INCOMING CALL ─────────────────────────────────────────
async function acceptCall() {
    stopRingtone(); stopPoll();
    try { await navigator.mediaDevices.getUserMedia({ audio: true }); } catch {}

    const resp = await fetch('/Call/Join/' + CONV_ID);
    if (!resp.ok) return;
    const data = await resp.json();
    _isCaller = data.isCaller;

    await initCall();
    showCallOverlay();
    document.getElementById('call-status').textContent = TXT_CONNECTING;
    _callActive = true;

    const joinOpts = { url: data.url, startVideoOff: true, startAudioOff: false };
    if (data.token) joinOpts.token = data.token;
    await _call.join(joinOpts);
}

async function declineCall() {
    stopRingtone();
    hideOverlays();
    _lastIncoming = false;
    await fetch('/Call/Decline?conversationId=' + CONV_ID).catch(() => {});
    startPoll();
}

// ── END CALL ──────────────────────────────────────────────
async function endCall(remoteHungUp = false) {
    if (_ringStop) { clearTimeout(_ringStop); _ringStop = null; }
    stopRingtone(); stopTimer(); stopPoll();

    const duration = getDuration();
    const wasCaller = _isCaller;
    _callStart = null; _callActive = false; _isMuted = false; _isCaller = false;

    if (_call) {
        try { await _call.leave(); } catch {}
        try { _call.destroy(); } catch {}
        _call = null;
    }
    // Clean up remote audio elements
    _audioEls.forEach(a => { try { a.srcObject = null; a.remove(); } catch {} });
    _audioEls.length = 0;
    hideOverlays();

    const mi = document.getElementById('mute-icon'), mb = document.getElementById('mute-btn');
    if (mi) mi.className = 'bi bi-mic-fill';
    if (mb) mb.classList.remove('muted');

    const m = Math.floor(duration/60), s = duration%60;
    const timeStr = m + ':' + String(s).padStart(2,'0');
    let msgText;
    if (duration < 5)      msgText = TXT_LOG_MISSED;
    else if (remoteHungUp) msgText = TXT_LOG_ENDED + ' · ' + timeStr;
    else                   msgText = TXT_LOG_CALL  + ' · ' + timeStr;

    appendCallMsg(msgText);

    // Only caller saves log to DB (avoids duplicate messages)
    if (wasCaller) {
        fetch('/Call/Log?conversationId=' + CONV_ID + '&duration=' + duration).catch(() => {});
    }

    startPoll();
}

function appendCallMsg(text) {
    if (!chatBox) return;
    const now = new Date().toLocaleTimeString('ru',{hour:'2-digit',minute:'2-digit'});
    const row = document.createElement('div');
    row.className = 'chat-msg-row chat-msg-me';
    row.innerHTML = '<div class="chat-bubble chat-bubble-me"><div class="chat-bubble-text">' + text + '</div><div class="chat-bubble-time justify-content-end"><span>' + now + '</span></div></div>';
    chatBox.appendChild(row);
    chatBox.scrollTop = chatBox.scrollHeight;
}

// ── MUTE ──────────────────────────────────────────────────
function toggleMute() {
    if (!_call) return;
    _isMuted = !_isMuted;
    _call.setLocalAudio(!_isMuted);
    const mi = document.getElementById('mute-icon'), mb = document.getElementById('mute-btn');
    if (mi) mi.className = _isMuted ? 'bi bi-mic-mute-fill' : 'bi bi-mic-fill';
    if (mb) mb.classList.toggle('muted', _isMuted);
}

// ── INCOMING CALL POLLING ─────────────────────────────────
function startPoll() {
    if (_pollInt) return;
    _pollInt = setInterval(async () => {
        if (_callActive) return;
        try {
            const r = await fetch('/Call/Poll?conversationId=' + CONV_ID);
            const d = await r.json();
            if (d.incoming && !_lastIncoming) {
                _lastIncoming = true;
                showIncomingOverlay(d.callerName);
            } else if (!d.incoming && _lastIncoming) {
                _lastIncoming = false;
                if (document.getElementById('incoming-overlay')?.style.display === 'flex')
                    hideOverlays();
            }
        } catch {}
    }, 3000);
}
function stopPoll() { if (_pollInt) { clearInterval(_pollInt); _pollInt = null; } _lastIncoming = false; }

document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (document.getElementById('call-overlay')?.style.display === 'flex') endCall(false);
    if (document.getElementById('incoming-overlay')?.style.display === 'flex') declineCall();
});
window.addEventListener('beforeunload', () => {
    if (_call) { try { _call.leave(); } catch {} }
    stopRingtone();
});

startPoll();

// ── AUTO-ACCEPT if navigated from global overlay ──────────
if (new URLSearchParams(location.search).get('accept') === '1') {
    setTimeout(function() {
        if (!_callActive) acceptCall().catch(function(){});
    }, 600);
}

// ── SIGNALR: incoming call pushed by layout ───────────────
window.addEventListener('signalr:incomingCall', function(e) {
    var d = e.detail;
    if (!d || String(d.conversationId) !== CONV_ID) return;
    if (!_callActive && !_lastIncoming) {
        _lastIncoming = true;
        showIncomingOverlay(d.callerName);
    }
});

// ── SIGNALR: callee declined — show on caller side ────────
window.addEventListener('signalr:callDeclined', function(e) {
    var d = e.detail;
    if (!d || String(d.conversationId) !== CONV_ID) return;
    if (_callActive && _isCaller) {
        stopRingtone();
        const el = document.getElementById('call-status');
        if (el) el.textContent = '@Html.Raw(L["Call_Decline"].Value)';
        setTimeout(function() { if (_callActive) endCall(false); }, 2000);
    }
});

// ── REAL-TIME MESSAGES (SignalR) ──────────────────────────
window.addEventListener('signalr:message', function(e) {
    var msg = e.detail;
    if (!msg || String(msg.conversationId) !== CONV_ID) return;
    // Only append messages from the OTHER person (we already append ours optimistically)
    if (String(msg.senderId) === MY_USER_ID) return;
    _appendBubble(msg.text, msg.createdDate, false);
    // Mark as read since user is actively viewing this conversation
    fetch('/Messages/MarkRead?conversationId=' + CONV_ID, { method: 'POST', credentials: 'same-origin' });
});

// ── AJAX MESSAGE SEND ─────────────────────────────────────
(function() {
    var form = document.querySelector('.chat-input-form');
    if (!form) return;
    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        var input = form.querySelector('.chat-input');
        var text  = (input.value || '').trim();
        if (!text) return;

        // Optimistic append — sender sees their message immediately
        _appendBubble(text, new Date().toISOString(), true);
        input.value = '';
        input.focus();

        try {
            var fd = new FormData(form);
            fd.set('text', text);
            await fetch('/Messages/Send', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: fd
            });
        } catch(err) {
            console.error('Send failed:', err);
        }
    });
})();

// ── HELPERS ───────────────────────────────────────────────
function _appendBubble(text, isoDate, isMe) {
    if (!chatBox) return;
    var d    = isoDate ? new Date(isoDate) : new Date();
    var time = d.toLocaleTimeString('ru', { hour: '2-digit', minute: '2-digit' });
    var row  = document.createElement('div');
    row.className = 'chat-msg-row ' + (isMe ? 'chat-msg-me' : 'chat-msg-them');
    row.innerHTML =
        '<div class="chat-bubble ' + (isMe ? 'chat-bubble-me' : 'chat-bubble-them') + '">' +
            '<div class="chat-bubble-text">' + _esc(text) + '</div>' +
            '<div class="chat-bubble-time' + (isMe ? ' justify-content-end' : '') + '">' +
                '<span>' + time + '</span>' +
                (isMe ? '<i class="bi bi-check2"></i>' : '') +
            '</div>' +
        '</div>';
    chatBox.appendChild(row);
    chatBox.scrollTop = chatBox.scrollHeight;
}
function _esc(s) {
    return String(s)
        .replace(/&/g,'&amp;').replace(/</g,'&lt;')
        .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
</script>
}
