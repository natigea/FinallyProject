@model ListingFormViewModel
@{
    ViewData["Title"] = L["Edit_PageTitle"].Value;
}

<div class="container py-4" style="max-width:700px;">
    <h1 class="h3 fw-bold mb-4">@L["Edit_PageTitle"]</h1>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="bg-white rounded-3 border p-4 mb-3">
            <h6 class="fw-bold mb-3 text-muted text-uppercase" style="font-size:.75rem;">@L["Edit_SectionMain"]</h6>

            <div class="mb-3">
                <label class="form-label fw-semibold">@L["Edit_Category"] <span class="text-danger">*</span></label>
                <select asp-for="CategoryId" class="form-select" required>
                    <option value="">@L["Edit_SelectCat"]</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId)">@(L["Cat_" + cat.Slug] is { ResourceNotFound: false } ck ? ck.Value : cat.Name)</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">@L["Edit_Title"] <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">@L["Edit_Description"] <span class="text-danger">*</span></label>
                <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
        </div>

        <div class="bg-white rounded-3 border p-4 mb-3">
            <h6 class="fw-bold mb-3 text-muted text-uppercase" style="font-size:.75rem;">@L["Edit_SectionPrice"]</h6>
            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label fw-semibold">@L["Edit_Price"] <span class="text-danger">*</span></label>
                    <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label class="form-label fw-semibold">@L["Edit_City"] <span class="text-danger">*</span></label>
                    <select asp-for="City" class="form-select" required>
                        <option value="">— Şəhər seçin —</option>
                        <option>Bakı</option>
                        <option>Sumqayıt</option>
                        <option>Gəncə</option>
                        <option>Mingəçevir</option>
                        <option>Naxçıvan</option>
                        <option>Lənkəran</option>
                        <option>Şəki</option>
                        <option>Quba</option>
                        <option>Şirvan</option>
                        <option>Masallı</option>
                        <option>Ağcabədi</option>
                        <option>Ağdaş</option>
                        <option>Ağstafa</option>
                        <option>Astara</option>
                        <option>Balakən</option>
                        <option>Bərdə</option>
                        <option>Beyləqan</option>
                        <option>Biləsuvar</option>
                        <option>Cəlilabad</option>
                        <option>Daşkəsən</option>
                        <option>Füzuli</option>
                        <option>Gədəbəy</option>
                        <option>Goranboy</option>
                        <option>Göyçay</option>
                        <option>Göygöl</option>
                        <option>Hacıqabul</option>
                        <option>İmişli</option>
                        <option>İsmayıllı</option>
                        <option>Kəlbəcər</option>
                        <option>Kürdəmir</option>
                        <option>Laçın</option>
                        <option>Lerik</option>
                        <option>Neftçala</option>
                        <option>Oğuz</option>
                        <option>Saatlı</option>
                        <option>Sabirabad</option>
                        <option>Salyan</option>
                        <option>Şamaxı</option>
                        <option>Şəmkir</option>
                        <option>Samux</option>
                        <option>Siyəzən</option>
                        <option>Tovuz</option>
                        <option>Ucar</option>
                        <option>Xaçmaz</option>
                        <option>Xızı</option>
                        <option>Yardımlı</option>
                        <option>Zaqatala</option>
                        <option>Zərdab</option>
                    </select>
                    <span asp-validation-for="City" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">@L["Edit_Phone"] <span class="text-danger">*</span></label>
                    <input asp-for="ContactPhone" type="tel" class="form-control" />
                    <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- Existing images -->
        @if (Model.ExistingImages.Any())
        {
            <div class="bg-white rounded-3 border p-4 mb-3">
                <h6 class="fw-bold mb-3 text-muted text-uppercase" style="font-size:.75rem;">@L["Edit_CurrentPhotos"]</h6>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var img in Model.ExistingImages)
                    {
                        <div class="position-relative">
                            <img src="@img.Url" class="rounded" style="width:80px;height:70px;object-fit:cover;" alt="" />
                            <div class="form-check position-absolute top-0 start-0 m-1">
                                <input type="checkbox" name="DeleteImageIds" value="@img.Id"
                                       class="form-check-input" id="del_@img.Id" />
                                <label for="del_@img.Id" class="form-check-label"></label>
                            </div>
                            <label for="del_@img.Id" class="badge bg-danger position-absolute top-0 end-0 m-1 cursor-pointer"
                                   style="cursor:pointer; font-size:.65rem;">✕</label>
                        </div>
                    }
                </div>
                <div class="text-muted small mt-1">@L["Edit_DeleteHint"]</div>
            </div>
        }

        <div class="bg-white rounded-3 border p-4 mb-4">
            <h6 class="fw-bold mb-2 text-muted text-uppercase" style="font-size:.75rem;">@L["Edit_AddPhotos"]</h6>
            <input type="file" name="NewImages" class="form-control" multiple
                   accept="image/jpeg,image/png,image/webp" />
        </div>

        <div class="d-flex gap-3">
            <button type="submit" class="btn btn-success btn-lg px-5 fw-bold">
                <i class="bi bi-check-lg me-2"></i>@L["Edit_Save"]
            </button>
            <a href="/Listing/Detail/@Model.Id" class="btn btn-outline-secondary btn-lg">@L["Edit_Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
