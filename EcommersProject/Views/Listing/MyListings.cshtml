@model IReadOnlyList<EcommersProject.BLL.DTOs.ListingGetDto>
@{
    ViewData["Title"] = L["MyListings_Title"].Value;
    var active  = Model.Where(l => l.Status == "Active").ToList();
    var pending = Model.Where(l => l.Status == "Pending").ToList();
    var closed  = Model.Where(l => l.Status != "Active" && l.Status != "Pending").ToList();
}

<div class="profile-wrap">
    <div class="profile-layout">
        @await Html.PartialAsync("_ProfileSidebar")

        <div class="profile-main">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 fw-bold mb-0">@L["MyListings_Title"]</h1>
                <a href="/Listing/Create" class="btn-dark-custom">
                    <i class="bi bi-plus-lg me-1"></i>@L["MyListings_New"]
                </a>
            </div>

            @if (!Model.Any())
            {
                <div class="section-card text-center py-5">
                    <i class="bi bi-card-list fs-1 text-muted d-block mb-3"></i>
                    <h5>@L["MyListings_Empty"]</h5>
                    <p class="text-muted">@L["MyListings_EmptyDesc"]</p>
                    <a href="/Listing/Create" class="btn-dark-custom mt-2">@L["MyListings_Post"]</a>
                </div>
            }
            else
            {
                <!-- Tabs -->
                <ul class="nav nav-tabs mb-4 border-0" id="myListingsTabs">
                    <li class="nav-item">
                        <button class="nav-link active fw-semibold" data-bs-toggle="tab" data-bs-target="#activeTab">
                            @L["MyListings_Active"] <span class="badge bg-success ms-1">@active.Count</span>
                        </button>
                    </li>
                    @if (pending.Any())
                    {
                        <li class="nav-item">
                            <button class="nav-link fw-semibold" data-bs-toggle="tab" data-bs-target="#pendingTab">
                                @L["MyListings_Pending"] <span class="badge bg-warning text-dark ms-1">@pending.Count</span>
                            </button>
                        </li>
                    }
                    <li class="nav-item">
                        <button class="nav-link fw-semibold" data-bs-toggle="tab" data-bs-target="#closedTab">
                            @L["MyListings_Closed"] <span class="badge bg-secondary ms-1">@closed.Count</span>
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- Active -->
                    <div class="tab-pane fade show active" id="activeTab">
                        @if (!active.Any())
                        {
                            <div class="text-muted text-center py-5">@L["MyListings_NoActive"]</div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var l in active) { @await Html.PartialAsync("_MyListingRow", l) }
                            </div>
                        }
                    </div>

                    <!-- Pending -->
                    <div class="tab-pane fade" id="pendingTab">
                        @if (!pending.Any())
                        {
                            <div class="text-muted text-center py-5">@L["MyListings_NoPending"]</div>
                        }
                        else
                        {
                            <div class="alert alert-warning d-flex gap-2 align-items-center mb-3" role="alert">
                                <i class="bi bi-hourglass-split flex-shrink-0"></i>
                                <span>@L["MyListings_PendingHint"]</span>
                            </div>
                            <div class="d-flex flex-column gap-3">
                                @foreach (var l in pending) { @await Html.PartialAsync("_MyListingRow", l) }
                            </div>
                        }
                    </div>

                    <!-- Closed -->
                    <div class="tab-pane fade" id="closedTab">
                        @if (!closed.Any())
                        {
                            <div class="text-muted text-center py-5">@L["MyListings_NoClosed"]</div>
                        }
                        else
                        {
                            var closedTotal = closed.Sum(l => l.Price);
                            <div class="earnings-banner mb-3">
                                <i class="bi bi-cash-stack me-2"></i>
                                <span>@L["MyListings_TotalEarned"]:</span>
                                <strong class="ms-2">@closedTotal.ToString("N0") ₼</strong>
                            </div>
                            <div class="d-flex flex-column gap-3">
                                @foreach (var l in closed) { @await Html.PartialAsync("_MyListingRow", l) }
                            </div>
                        }
                    </div>
                </div>
            }
        </div><!-- /profile-main -->
    </div><!-- /profile-layout -->
</div><!-- /profile-wrap -->

@section Styles {
<style>
    .nav-tabs { border-bottom: 2px solid #e5e7eb; }
    .nav-tabs .nav-link { border: none; color: #6b7280; padding-bottom: 12px; }
    .nav-tabs .nav-link.active { color: #1a1a1a; border-bottom: 2px solid #1a1a1a; background: none; }
    .earnings-banner {
        display: flex; align-items: center;
        background: #f0fdf4; border: 1px solid #bbf7d0;
        border-radius: 10px; padding: 12px 16px;
        font-size: .875rem; color: #166534;
    }
</style>
}
@section Scripts {
<script>
    // Auto-switch to pending tab when there are no active listings
    @if (pending.Any() && !active.Any())
    {
        <text>
        const pendingBtn = document.querySelector('[data-bs-target="#pendingTab"]');
        if (pendingBtn) {
            const activeBtn = document.querySelector('[data-bs-target="#activeTab"]');
            if (activeBtn) activeBtn.classList.remove('active');
            document.getElementById('activeTab')?.classList.remove('show','active');
            pendingBtn.classList.add('active');
            document.getElementById('pendingTab')?.classList.add('show','active');
        }
        </text>
    }
</script>
}
