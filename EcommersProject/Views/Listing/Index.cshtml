@model BrowseViewModel
@{
    ViewData["Title"] = L["Browse_Title"].Value;
}

<!-- ─── Category chips ────────────────────────── -->
<div class="browse-cats-bar">
    <div class="container">
        <div class="cats-scroll">
            <a href="/Listing@(Model.SortBy != null || !string.IsNullOrEmpty(Model.Query) ? "?q=" + (Model.Query ?? "") + "&sortBy=" + (Model.SortBy ?? "") : "")"
               class="cat-chip @(Model.CategoryId == null ? "active" : "")">
                <i class="bi bi-grid"></i> @L["Browse_All"]
            </a>
            @foreach (var cat in Model.Categories)
            {
                <a href="/Listing?categoryId=@cat.Id@(!string.IsNullOrEmpty(Model.Query) ? "&q=" + Model.Query : "")@(!string.IsNullOrEmpty(Model.City) ? "&city=" + Model.City : "")"
                   class="cat-chip @(Model.CategoryId == cat.Id ? "active" : "")">
                    <i class="bi @cat.Icon"></i>
                    @(L["Cat_" + cat.Slug] is { ResourceNotFound: false } cp ? cp.Value : cat.Name)
                </a>
            }
        </div>
    </div>
</div>

<!-- ─── Main layout ───────────────────────────── -->
<div class="container py-3">
    <div class="browse-layout">

        <!-- Sidebar -->
        <aside class="browse-sidebar d-none d-lg-block">
            <div class="surface p-3">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="filter-head mb-0">@L["Browse_Filters"]</h6>
                    <a href="/Listing@(!string.IsNullOrEmpty(Model.Query) ? "?q=" + Model.Query : "")" class="filter-reset-link">
                        <i class="bi bi-x-circle me-1"></i>@L["Browse_Clear"]
                    </a>
                </div>
                <form method="get" action="/Listing">
                    <input type="hidden" name="q" value="@Model.Query" />
                    <input type="hidden" name="categoryId" value="@Model.CategoryId" />

                    <!-- City -->
                    <div class="filter-section">
                        <label class="filter-lbl">@L["Browse_City"]</label>
                        <select name="city" class="form-select form-select-sm filter-select">
                            <option value="">@L["Home_AllCities"]</option>
                            @{ ViewData["SelectedCity"] = Model.City; }
                            @await Html.PartialAsync("_CityOptions")
                        </select>
                    </div>

                    <!-- Price -->
                    <div class="filter-section">
                        <label class="filter-lbl">@L["Browse_Price"]</label>
                        <div class="d-flex gap-2">
                            <input type="number" name="priceMin" value="@Model.PriceMin"
                                   class="form-control form-control-sm" placeholder="@L["Browse_From"]" min="0" />
                            <input type="number" name="priceMax" value="@Model.PriceMax"
                                   class="form-control form-control-sm" placeholder="@L["Browse_PriceTo"]" min="0" />
                        </div>
                    </div>

                    <!-- Sort -->
                    <div class="filter-section">
                        <label class="filter-lbl">@L["Browse_Sort"]</label>
                        <select name="sortBy" class="form-select form-select-sm filter-select">
                            <option value="newest" selected="@(Model.SortBy == "newest" || Model.SortBy == null)">@L["Browse_SortNewest"]</option>
                            <option value="price_asc" selected="@(Model.SortBy == "price_asc")">@L["Browse_SortCheapest"]</option>
                            <option value="price_desc" selected="@(Model.SortBy == "price_desc")">@L["Browse_SortExpensive"]</option>
                        </select>
                    </div>

                    <!-- Extra -->
                    <div class="filter-section">
                        <label class="filter-lbl">@L["Browse_Extra"]</label>
                        <div class="filter-checks">
                            <label class="filter-check-item">
                                <input type="checkbox" name="onlyWithPhoto" value="true" @(Model.OnlyWithPhoto ? "checked" : "") />
                                <span><i class="bi bi-image me-1 text-muted"></i>@L["Browse_WithPhoto"]</span>
                            </label>
                            <label class="filter-check-item">
                                <input type="checkbox" name="onlyVip" value="true" @(Model.OnlyVip ? "checked" : "") />
                                <span><i class="bi bi-star-fill me-1" style="color:#f59e0b;"></i>@L["Browse_VipOnly"]</span>
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn-dark-custom w-100 mt-1">@L["Browse_Apply"]</button>
                </form>
            </div>
        </aside>

        <!-- Listings -->
        <div class="browse-main">
            <div class="browse-toolbar">
                <span style="color:var(--muted);font-size:.85rem;">
                    @L["Browse_Found"] <strong style="color:var(--text);">@Model.Total</strong> @L["Browse_FoundListings"]
                    @if (!string.IsNullOrEmpty(Model.Query)) { <span>@L["Browse_ForQuery"] «@Model.Query»</span> }
                </span>
                <div class="d-flex align-items-center gap-2">
                    <form method="get" action="/Listing" class="d-lg-none">
                        <input type="hidden" name="q" value="@Model.Query" />
                        <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                        <input type="hidden" name="city" value="@Model.City" />
                        <input type="hidden" name="priceMin" value="@Model.PriceMin" />
                        <input type="hidden" name="priceMax" value="@Model.PriceMax" />
                        <select name="sortBy" class="form-select form-select-sm" onchange="this.form.submit()" style="max-width:155px;">
                            <option value="newest" selected="@(Model.SortBy == "newest" || Model.SortBy == null)">@L["Browse_SortNewest"]</option>
                            <option value="price_asc" selected="@(Model.SortBy == "price_asc")">@L["Browse_SortCheapest"]</option>
                            <option value="price_desc" selected="@(Model.SortBy == "price_desc")">@L["Browse_SortExpensive"]</option>
                        </select>
                    </form>
                    <a href="/Listing/Create" class="btn-dark-custom px-3 py-2" style="font-size:.82rem;white-space:nowrap;">
                        <i class="bi bi-plus-lg me-1"></i>@L["Browse_AddListing"]
                    </a>
                </div>
            </div>

            @if (Model.Listings.Any())
            {
                <div class="browse-grid">
                    @foreach (var listing in Model.Listings)
                    {
                        @await Html.PartialAsync("_ListingCard", listing)
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-4 d-flex justify-content-center">
                        <ul class="pagination">
                            @if (Model.Page > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?q=@Model.Query&categoryId=@Model.CategoryId&city=@Model.City&priceMin=@Model.PriceMin&priceMax=@Model.PriceMax&sortBy=@Model.SortBy&page=@(Model.Page-1)">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                            }
                            @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                            {
                                <li class="page-item @(p == Model.Page ? "active" : "")">
                                    <a class="page-link" href="?q=@Model.Query&categoryId=@Model.CategoryId&city=@Model.City&priceMin=@Model.PriceMin&priceMax=@Model.PriceMax&sortBy=@Model.SortBy&page=@p">@p</a>
                                </li>
                            }
                            @if (Model.Page < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?q=@Model.Query&categoryId=@Model.CategoryId&city=@Model.City&priceMin=@Model.PriceMin&priceMax=@Model.PriceMax&sortBy=@Model.SortBy&page=@(Model.Page+1)">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-search"></i>
                    <h5 style="font-size:1rem;color:var(--text);">@L["Browse_NothingFound"]</h5>
                    <p>@L["Browse_TryChange"]</p>
                    <a href="/Listing" class="btn-dark-custom d-inline-block px-4 py-2 mt-2">@L["Browse_ShowAll"]</a>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
<style>
    /* Cats bar */
    .browse-cats-bar { background: var(--bg); border-bottom: 1px solid var(--border); padding: 10px 0; }
    .cats-scroll { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; }
    .cats-scroll::-webkit-scrollbar { display: none; }

    /* Layout */
    .browse-layout { display: grid; grid-template-columns: 262px 1fr; gap: 20px; align-items: start; }
    @@media (max-width: 991px) { .browse-layout { grid-template-columns: 1fr; } }

    /* Sidebar */
    .browse-sidebar { position: sticky; top: 80px; }
    .filter-head { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .7px; color: var(--muted); }
    .filter-reset-link { font-size: .76rem; color: var(--muted); text-decoration: none; transition: color .15s; }
    .filter-reset-link:hover { color: #dc2626; }
    .filter-section { border-top: 1px solid var(--border); padding: 14px 0; }
    .filter-section:last-of-type { border-bottom: 1px solid var(--border); }
    .filter-lbl { display: block; font-size: .78rem; font-weight: 600; color: var(--sub); margin-bottom: 7px; }
    .filter-select { cursor: pointer; }
    .form-control-sm, .form-select-sm { border-color: var(--border); border-radius: 10px; font-size: .85rem; }
    .form-control-sm:focus, .form-select-sm:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(37,99,235,.08); }
    .filter-checks { display: flex; flex-direction: column; gap: 8px; }
    .filter-check-item {
        display: flex; align-items: center; gap: 9px;
        font-size: .84rem; color: var(--sub); cursor: pointer; user-select: none;
        padding: 6px 8px; border-radius: 8px; transition: background .15s;
    }
    .filter-check-item:hover { background: var(--accent-soft); color: var(--accent); }
    .filter-check-item input[type="checkbox"] {
        width: 15px; height: 15px; accent-color: var(--accent); flex-shrink: 0; cursor: pointer;
    }

    /* Toolbar */
    .browse-toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; flex-wrap: wrap; gap: 8px; }

    /* Grid */
    .browse-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(175px, 1fr)); gap: 14px; }
    @@media (max-width: 576px) { .browse-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; } }
</style>
}
