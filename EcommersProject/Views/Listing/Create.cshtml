@model ListingFormViewModel
@{
    ViewData["Title"] = L["Create_PageTitle"].Value;
}

<div class="container py-4" style="max-width:700px;">
    <h1 class="h3 fw-bold mb-4">@L["Create_PageTitle"]</h1>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="bg-white rounded-3 border p-4 mb-3">
            <h6 class="fw-bold mb-3 text-muted text-uppercase" style="font-size:.75rem; letter-spacing:.5px;">@L["Create_SectionMain"]</h6>

            <div class="mb-3">
                <label class="form-label fw-semibold">@L["Create_Category"] <span class="text-danger">*</span></label>
                <select asp-for="CategoryId" class="form-select" required>
                    <option value="">@L["Create_SelectCategory"]</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id">@(L["Cat_" + cat.Slug] is { ResourceNotFound: false } ck ? ck.Value : cat.Name)</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">@L["Create_ListingTitle"] <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control" placeholder="@L["Create_TitlePlaceholder"]" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">@L["Create_Description"] <span class="text-danger">*</span></label>
                <textarea asp-for="Description" class="form-control" rows="6"
                          placeholder="@L["Create_DescPlaceholder"]"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
        </div>

        <div class="bg-white rounded-3 border p-4 mb-3">
            <h6 class="fw-bold mb-3 text-muted text-uppercase" style="font-size:.75rem; letter-spacing:.5px;">@L["Create_SectionPrice"]</h6>

            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label fw-semibold">@L["Create_Price"] <span class="text-danger">*</span></label>
                    <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label class="form-label fw-semibold">@L["Create_City"] <span class="text-danger">*</span></label>
                    <select asp-for="City" class="form-select" required>
                        <option value="">— Şəhər seçin —</option>
                        <option>Bakı</option>
                        <option>Sumqayıt</option>
                        <option>Gəncə</option>
                        <option>Mingəçevir</option>
                        <option>Naxçıvan</option>
                        <option>Lənkəran</option>
                        <option>Şəki</option>
                        <option>Quba</option>
                        <option>Şirvan</option>
                        <option>Masallı</option>
                        <option>Ağcabədi</option>
                        <option>Ağdaş</option>
                        <option>Ağstafa</option>
                        <option>Astara</option>
                        <option>Balakən</option>
                        <option>Bərdə</option>
                        <option>Beyləqan</option>
                        <option>Biləsuvar</option>
                        <option>Cəlilabad</option>
                        <option>Daşkəsən</option>
                        <option>Füzuli</option>
                        <option>Gədəbəy</option>
                        <option>Goranboy</option>
                        <option>Göyçay</option>
                        <option>Göygöl</option>
                        <option>Hacıqabul</option>
                        <option>İmişli</option>
                        <option>İsmayıllı</option>
                        <option>Kəlbəcər</option>
                        <option>Kürdəmir</option>
                        <option>Laçın</option>
                        <option>Lerik</option>
                        <option>Neftçala</option>
                        <option>Oğuz</option>
                        <option>Saatlı</option>
                        <option>Sabirabad</option>
                        <option>Salyan</option>
                        <option>Şamaxı</option>
                        <option>Şəmkir</option>
                        <option>Samux</option>
                        <option>Siyəzən</option>
                        <option>Tovuz</option>
                        <option>Ucar</option>
                        <option>Xaçmaz</option>
                        <option>Xızı</option>
                        <option>Yardımlı</option>
                        <option>Zaqatala</option>
                        <option>Zərdab</option>
                    </select>
                    <span asp-validation-for="City" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">@L["Create_Phone"] <span class="text-danger">*</span></label>
                    <input asp-for="ContactPhone" type="tel" class="form-control" placeholder="+994 50 000 00 00" />
                    <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-3 border p-4 mb-4">
            <h6 class="fw-bold mb-3 text-muted text-uppercase" style="font-size:.75rem; letter-spacing:.5px;">@L["Create_SectionPhotos"]</h6>
            <div class="mb-2 text-muted small">@L["Create_PhotosHint"]</div>
            <input type="file" name="NewImages" class="form-control" multiple
                   accept="image/jpeg,image/png,image/webp" />
        </div>

        <div class="d-flex gap-3">
            <button type="submit" class="btn btn-success btn-lg px-5 fw-bold">
                <i class="bi bi-check-lg me-2"></i>@L["Create_Publish"]
            </button>
            <a href="/Listing" class="btn btn-outline-secondary btn-lg">@L["Create_Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
