        ("Naxçıvan",   "Нахичевань",   "Naxçıvan",   "Nakhchivan"),
        ("Lənkəran",   "Ленкорань",    "Lənkəran",   "Lankaran"),
        ("Şəki",       "Шеки",         "Şəki",       "Sheki"),
        ("Quba",       "Куба",         "Quba",       "Quba"),
        ("Şirvan",     "Ширван",       "Şirvan",     "Shirvan"),
        ("Masallı",    "Масаллы",      "Masallı",    "Masally"),
        ("Ağcabədi",   "Агджабеди",    "Ağcabədi",   "Aghjabadi"),
        ("Ağdaş",      "Агдаш",        "Ağdaş",      "Agdash"),
        ("Ağstafa",    "Акстафа",      "Ağstafa",    "Agstafa"),
        ("Astara",     "Астара",       "Astara",     "Astara"),
        ("Balakən",    "Балакен",      "Balakən",    "Balakan"),
        ("Bərdə",      "Барда",        "Bərdə",      "Barda"),
        ("Beyləqan",   "Бейлаган",     "Beyləqan",   "Beylagan"),
        ("Biləsuvar",  "Билясувар",    "Biləsuvar",  "Bilasuvar"),
        ("Cəlilabad",  "Джалилабад",   "Cəlilabad",  "Jalilabad"),
        ("Daşkəsən",   "Дашкесан",     "Daşkəsən",   "Dashkasan"),
        ("Füzuli",     "Физули",       "Füzuli",     "Fuzuli"),
        ("Gədəbəy",    "Кедабек",      "Gədəbəy",    "Gadabay"),
        ("Goranboy",   "Горанбой",     "Goranboy",   "Goranboy"),
        ("Göyçay",     "Геокчай",      "Göyçay",     "Goychay"),
