        ("Zərdab",     "Зердаб",       "Zərdab",     "Zardab"),
    };

    string Label((string val, string ru, string az, string en) c) => lang switch
    {
        "az" => c.az,
        "en" => c.en,
        _    => c.ru
    };
}
@{
    var _selCity = ViewData["SelectedCity"] as string ?? "";
}
@foreach (var c in cities)
{
    if (c.Item1 == _selCity)
    {
        <option value="@c.Item1" selected>@Label(c)</option>
    }
    else
    {
        <option value="@c.Item1">@Label(c)</option>
    }
}
