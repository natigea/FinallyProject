        ("İsmayıllı",  "Исмаиллы",     "İsmayıllı",  "Ismayilli"),
        ("Kəlbəcər",   "Кельбаджар",   "Kəlbəcər",   "Kalbajar"),
        ("Kürdəmir",   "Кюрдамир",     "Kürdəmir",   "Kurdamir"),
        ("Laçın",      "Лачин",        "Laçın",      "Lachin"),
        ("Lerik",      "Лерик",        "Lerik",      "Lerik"),
        ("Neftçala",   "Нефтчала",     "Neftçala",   "Neftchala"),
        ("Oğuz",       "Огуз",         "Oğuz",       "Oguz"),
        ("Saatlı",     "Саатлы",       "Saatlı",     "Saatly"),
