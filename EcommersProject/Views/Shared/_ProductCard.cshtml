@using Microsoft.Extensions.Localization
@using EcommersProject.Resources
@inject IStringLocalizer<SharedResource> L
@model EcommersProject.BLL.DTOs.ProductGetDto
<div class="card product-card h-100">
    <a href="/Shop/Detail/@Model.Id" class="text-decoration-none">
        @if (Model.Images.Any())
        {
            <img src="@Model.Images.First().Url" class="card-img-top" alt="@Model.Name" />
        }
        else
        {
            <div class="card-img-placeholder">
                <i class="bi bi-image"></i>
            </div>
        }
    </a>
    <div class="card-body d-flex flex-column p-3">
        <p class="text-muted small mb-1">@Model.CategoryName</p>
        <a href="/Shop/Detail/@Model.Id" class="text-decoration-none text-dark fw-semibold mb-1 lh-sm">@Model.Name</a>
        <div class="rating-stars small mb-2">
            @for (int i = 1; i <= 5; i++)
            {
                <i class="bi @(i <= (int)Model.RatingAverage ? "bi-star-fill" : "bi-star")"></i>
            }
            <span class="text-muted ms-1">(@Model.RatingAverage.ToString("N1"))</span>
        </div>
        <div class="mt-auto d-flex align-items-center justify-content-between">
            <span class="price-tag">@Model.Price.ToString("N2") ₼</span>
            @if (Model.StockQuantity > 0)
            {
                <form method="post" action="/Cart/AddItem">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="quantity" value="1" />
                    <button class="btn btn-primary btn-sm">
                        <i class="bi bi-cart-plus"></i>
                    </button>
                </form>
            }
            else
            {
                <span class="badge-stock-out">@L["Product_OutOfStock"]</span>
            }
        </div>
    </div>
</div>
