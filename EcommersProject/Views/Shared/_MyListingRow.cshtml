@model EcommersProject.BLL.DTOs.ListingGetDto
@{
    var img = Model.Images.FirstOrDefault()?.Url;
    var statusClass = Model.Status switch {
        "Active"  => "badge-active",
        "Closed"  => "badge-closed",
        "Pending" => "bg-warning text-dark",
        _         => "badge-expired"
    };
    var statusLabel = Model.Status switch {
        "Active"  => L["Status_Active"].Value,
        "Closed"  => L["Status_Closed"].Value,
        "Pending" => L["Status_Pending"].Value,
        _         => L["Status_Expired"].Value
    };
}
<div class="bg-white rounded-3 border p-3 d-flex gap-3">
    @if (img != null)
    {
        <img src="@img" class="rounded" style="width:80px;height:70px;object-fit:cover;flex-shrink:0;" />
    }
    else
    {
        <div class="rounded bg-light d-flex align-items-center justify-content-center flex-shrink-0"
             style="width:80px;height:70px;font-size:1.5rem;color:#d1d5db;">
            <i class="bi bi-image"></i>
        </div>
    }
    <div class="flex-grow-1 min-width-0">
        <div class="d-flex flex-wrap gap-2 align-items-start">
            <a href="/Listing/Detail/@Model.Id" class="fw-semibold text-dark text-decoration-none flex-grow-1"
               style="min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                @Model.Title
            </a>
            <span class="badge @statusClass rounded-pill px-2">@statusLabel</span>
        </div>
        <div class="fw-bold mt-1">@Model.Price.ToString("N0") ₼</div>
        <div class="text-muted small mt-1">
            <i class="bi bi-geo-alt me-1"></i>@Model.City &nbsp;·&nbsp;
            <i class="bi bi-clock me-1"></i>@Model.CreatedDate.ToString("dd.MM.yyyy")
        </div>
    </div>
    <div class="d-flex flex-column gap-1 flex-shrink-0">
        @if (Model.Status != "Pending")
        {
            <a href="/Listing/Edit/@Model.Id" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-pencil"></i>
            </a>
        }
        @if (Model.Status == "Active")
        {
            <form asp-controller="Listing" asp-action="Close" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-sm btn-outline-warning" title="@L["MyListings_CloseTitle"]">
                    <i class="bi bi-check-circle"></i>
                </button>
            </form>
        }
        @if (Model.Status != "Pending")
        {
            <form asp-controller="Listing" asp-action="Delete" method="post"
                  onsubmit="return confirm('@L["MyListings_DeleteConfirm"]')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-sm btn-outline-danger" title="@L["Common_Delete"]">
                    <i class="bi bi-trash"></i>
                </button>
            </form>
        }
    </div>
</div>
