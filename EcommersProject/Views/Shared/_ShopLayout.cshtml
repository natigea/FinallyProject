@using Microsoft.Extensions.Localization
@using EcommersProject.Resources
@inject IStringLocalizer<SharedResource> L
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString);
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — " : "")EcommersShop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root { --primary: #6366f1; --primary-dark: #4f46e5; --accent: #8b5cf6; }
        body { background: #f8f9fa; font-family: 'Segoe UI', system-ui, sans-serif; }
        .navbar { background: #fff; box-shadow: 0 1px 6px rgba(0,0,0,.08); padding: 10px 0; }
        .navbar-brand { font-weight: 800; font-size: 1.35rem; color: var(--primary) !important; letter-spacing: -0.5px; }
        .navbar-brand i { color: var(--accent); }
        .nav-search { width: 340px; }
        .nav-search .form-control { border-right: none; border-radius: 8px 0 0 8px; }
        .nav-search .btn { border-radius: 0 8px 8px 0; }
        .nav-icon-btn { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 10px; color: #374151; text-decoration: none; transition: background .15s; }
        .nav-icon-btn:hover { background: #f3f4f6; color: var(--primary); }
        .cart-badge { font-size: .6rem; padding: 2px 5px; min-width: 18px; }
        .product-card { border: none; border-radius: 14px; box-shadow: 0 2px 10px rgba(0,0,0,.07); transition: transform .2s, box-shadow .2s; overflow: hidden; background: #fff; }
        .product-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(99,102,241,.15); }
        .product-card .card-img-top { height: 200px; object-fit: cover; }
        .product-card .card-img-placeholder { height: 200px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #e0e7ff, #ede9fe); font-size: 3.5rem; color: var(--primary); }
        .price-tag { font-size: 1.1rem; font-weight: 700; color: var(--primary); }
        .badge-stock-out { background: #fee2e2; color: #dc2626; font-size: .72rem; padding: 3px 8px; border-radius: 20px; }
        .badge-stock-ok { background: #d1fae5; color: #059669; font-size: .72rem; padding: 3px 8px; border-radius: 20px; }
        .rating-stars { color: #f59e0b; }
        .category-pill { display: inline-flex; align-items: center; gap: 6px; padding: 7px 18px; border-radius: 999px; background: #fff; border: 1.5px solid #e5e7eb; font-size: .88rem; text-decoration: none; color: #374151; transition: all .2s; font-weight: 500; }
        .category-pill:hover, .category-pill.active { background: var(--primary); border-color: var(--primary); color: #fff; }
        .section-title { font-weight: 800; font-size: 1.5rem; }
        .order-status-badge { font-size: .75rem; padding: 4px 10px; border-radius: 20px; font-weight: 600; display: inline-block; }
        .status-pending { background: #fef3c7; color: #92400e; }
        .status-paid { background: #dbeafe; color: #1e40af; }
        .status-processing { background: #dbeafe; color: #1e40af; }
        .status-shipped { background: #cffafe; color: #0e7490; }
        .status-delivered { background: #d1fae5; color: #065f46; }
        .status-cancelled { background: #fee2e2; color: #991b1b; }
        footer { background: #0f0e1a; color: #a5b4fc; padding: 4rem 0 2rem; margin-top: 5rem; }
        footer .footer-brand { font-size: 1.3rem; font-weight: 800; color: #fff; }
        footer h6 { color: #e0e7ff; font-weight: 700; margin-bottom: 1rem; }
        footer a { color: #a5b4fc; text-decoration: none; transition: color .15s; }
        footer a:hover { color: #fff; }
        footer .footer-bottom { border-top: 1px solid #1e1b4b; padding-top: 1.5rem; margin-top: 2rem; }
        .empty-state { text-align: center; padding: 4rem; color: #9ca3af; }
        .empty-state i { font-size: 3.5rem; display: block; margin-bottom: 1rem; }
        .page-hero { background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%); color: #fff; padding: 3.5rem 0; }
        .feature-icon { width: 56px; height: 56px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
        /* Language switcher */
        .lang-btn { font-size: .78rem; font-weight: 700; padding: 4px 9px; border-radius: 7px; border: 1.5px solid #e5e7eb; color: #374151; text-decoration: none; transition: all .15s; }
        .lang-btn:hover { border-color: var(--primary); color: var(--primary); }
        .lang-btn.active { background: var(--primary); border-color: var(--primary); color: #fff; }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>

<!-- Top bar -->
<div class="d-none d-md-block" style="background:#0f0e1a; color:#a5b4fc; font-size:.8rem; padding:6px 0;">
    <div class="container d-flex justify-content-between align-items-center">
        <span><i class="bi bi-truck me-1"></i>@L["TopBar_Delivery"]</span>
        <span><i class="bi bi-telephone me-1"></i>+994 12 000 00 00 &nbsp;|&nbsp; <i class="bi bi-envelope me-1"></i>support@ecommers.com</span>
    </div>
</div>

<!-- Main navbar -->
<nav class="navbar navbar-expand-lg sticky-top">
    <div class="container gap-3">
        <a class="navbar-brand" href="/"><i class="bi bi-bag-heart-fill"></i> EcommersShop</a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMain">
            <!-- Search -->
            <form class="mx-auto nav-search d-flex" action="/Shop" method="get">
                <input type="text" name="q" class="form-control" placeholder="@L["Search_Placeholder"]" />
                <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i></button>
            </form>
            <!-- Icons + language -->
            <div class="d-flex align-items-center gap-1 ms-auto">
                <a href="/Shop" class="nav-icon-btn" title="@L["Nav_Catalog"]">
                    <i class="bi bi-grid fs-5"></i>
                </a>
                <a href="/Favorites" class="nav-icon-btn" title="@L["Nav_Favorites"]">
                    <i class="bi bi-heart fs-5"></i>
                </a>
                @await Component.InvokeAsync("CartBadge")

                <!-- Language switcher -->
                <div class="d-flex gap-1 ms-1">
                    <a href="/Language/Set?culture=ru&returnUrl=@returnUrl"
                       class="lang-btn @(currentCulture == "ru" ? "active" : "")">RU</a>
                    <a href="/Language/Set?culture=az&returnUrl=@returnUrl"
                       class="lang-btn @(currentCulture == "az" ? "active" : "")">AZ</a>
                    <a href="/Language/Set?culture=en&returnUrl=@returnUrl"
                       class="lang-btn @(currentCulture == "en" ? "active" : "")">EN</a>
                </div>

                <!-- Account -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button class="nav-icon-btn border-0 bg-transparent dropdown-toggle" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle fs-5"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-1" style="min-width:220px;">
                            <li class="px-3 py-2">
                                <p class="fw-semibold mb-0 small">@User.Identity.Name</p>
                                <p class="text-muted mb-0" style="font-size:.78rem;">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
                            </li>
                            <li><hr class="dropdown-divider my-1" /></li>
                            <li><a class="dropdown-item rounded-2 py-2" href="/Account/Profile"><i class="bi bi-person me-2 text-muted"></i>@L["Nav_Profile"]</a></li>
                            <li><a class="dropdown-item rounded-2 py-2" href="/Account/Orders"><i class="bi bi-bag me-2 text-muted"></i>@L["Nav_MyOrders"]</a></li>
                            <li><a class="dropdown-item rounded-2 py-2" href="/Favorites"><i class="bi bi-heart me-2 text-muted"></i>@L["Nav_Favorites"]</a></li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li><hr class="dropdown-divider my-1" /></li>
                                <li><a class="dropdown-item rounded-2 py-2 text-primary" href="/Admin/Dashboard"><i class="bi bi-shield-check me-2"></i>@L["Nav_AdminPanel"]</a></li>
                            }
                            @if (User.IsInRole("Seller"))
                            {
                                <li><hr class="dropdown-divider my-1" /></li>
                                <li><a class="dropdown-item rounded-2 py-2 text-success" href="/Seller/Dashboard"><i class="bi bi-shop me-2"></i>@L["Nav_SellerPanel"]</a></li>
                            }
                            <li><hr class="dropdown-divider my-1" /></li>
                            <li>
                                <form method="post" asp-controller="Account" asp-action="Logout">
                                    <button class="dropdown-item rounded-2 py-2 text-danger" type="submit">
                                        <i class="bi bi-box-arrow-right me-2"></i>@L["Nav_Logout"]
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-primary btn-sm px-3 ms-1" href="/Account/Login">
                        <i class="bi bi-person me-1"></i>@L["Nav_Login"]
                    </a>
                }
            </div>
        </div>
    </div>
</nav>

<!-- Category nav bar -->
<div class="bg-white border-bottom d-none d-lg-block">
    <div class="container">
        <nav class="d-flex gap-1 py-1 overflow-auto" style="scrollbar-width:none;">
            <a href="/Shop" class="btn btn-sm btn-link text-dark text-decoration-none px-3 py-2 fw-medium">
                <i class="bi bi-grid me-1"></i>@L["Nav_AllProducts"]
            </a>
            <a href="/About" class="btn btn-sm btn-link text-dark text-decoration-none px-3 py-2">@L["Nav_About"]</a>
            <a href="/Contact" class="btn btn-sm btn-link text-dark text-decoration-none px-3 py-2">@L["Nav_Contacts"]</a>
        </nav>
    </div>
</div>

<!-- Flash messages -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-0 border-0 rounded-0 py-2" role="alert">
        <div class="container"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button></div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-0 border-0 rounded-0 py-2" role="alert">
        <div class="container"><i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button></div>
    </div>
}

<main>@RenderBody()</main>

<!-- Footer -->
<footer>
    <div class="container">
        <div class="row g-5 mb-4">
            <div class="col-lg-4">
                <div class="footer-brand mb-3"><i class="bi bi-bag-heart-fill me-2" style="color:#8b5cf6;"></i>EcommersShop</div>
                <p class="small mb-3" style="line-height:1.7;">@L["Footer_Description"]</p>
                <div class="d-flex gap-2">
                    <a href="#" class="nav-icon-btn" style="background:#1e1b4b; color:#a5b4fc;"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="nav-icon-btn" style="background:#1e1b4b; color:#a5b4fc;"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="nav-icon-btn" style="background:#1e1b4b; color:#a5b4fc;"><i class="bi bi-telegram"></i></a>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <h6>@L["Footer_ForBuyers"]</h6>
                <ul class="list-unstyled small d-flex flex-column gap-2">
                    <li><a href="/Shop">@L["Footer_Catalog"]</a></li>
                    <li><a href="/Cart">@L["Footer_Cart"]</a></li>
                    <li><a href="/Account/Orders">@L["Footer_Orders"]</a></li>
                    <li><a href="/Favorites">@L["Footer_Favorites"]</a></li>
                </ul>
            </div>
            <div class="col-6 col-lg-2">
                <h6>@L["Footer_Account"]</h6>
                <ul class="list-unstyled small d-flex flex-column gap-2">
                    <li><a href="/Account/Login">@L["Nav_Login"]</a></li>
                    <li><a href="/Account/Register">@L["Footer_Register"]</a></li>
                    <li><a href="/Account/Profile">@L["Nav_Profile"]</a></li>
                </ul>
            </div>
            <div class="col-6 col-lg-2">
                <h6>@L["Footer_Company"]</h6>
                <ul class="list-unstyled small d-flex flex-column gap-2">
                    <li><a href="/About">@L["Nav_About"]</a></li>
                    <li><a href="/Contact">@L["Nav_Contacts"]</a></li>
                    <li><a href="/Account/Register?seller=1">@L["Footer_BecomeASeller"]</a></li>
                </ul>
            </div>
            <div class="col-6 col-lg-2">
                <h6>@L["Footer_Contacts"]</h6>
                <ul class="list-unstyled small d-flex flex-column gap-2">
                    <li><a href="tel:+994120000000"><i class="bi bi-telephone me-1"></i>+994 12 000 00 00</a></li>
                    <li><a href="mailto:support@ecommers.com"><i class="bi bi-envelope me-1"></i>support@ecommers.com</a></li>
                    <li><span style="color:#a5b4fc;"><i class="bi bi-geo-alt me-1"></i>Bakı, Azərbaycan</span></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <p class="small mb-0">© @DateTime.Now.Year EcommersShop. @L["Footer_Rights"]</p>
            <div class="d-flex gap-3 small">
                <a href="#">@L["Footer_Privacy"]</a>
                <a href="#">@L["Footer_Terms"]</a>
            </div>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
