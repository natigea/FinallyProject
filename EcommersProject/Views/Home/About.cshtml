@{
    ViewData["Title"] = "О нас";
}

<div class="page-hero text-center">
    <div class="container">
        <h1 class="display-5 fw-bold mb-3">О компании EcommersShop</h1>
        <p class="lead opacity-90">Мы создаём лучший опыт покупок в Азербайджане</p>
    </div>
</div>

<div class="container py-5">

    <!-- Mission -->
    <div class="row align-items-center g-5 mb-6">
        <div class="col-lg-6">
            <span class="badge bg-primary bg-opacity-10 text-primary fw-semibold mb-3 px-3 py-2">Наша миссия</span>
            <h2 class="fw-bold mb-4">Делаем покупки простыми и доступными</h2>
            <p class="text-muted mb-3">EcommersShop — это современная торговая платформа, соединяющая тысячи продавцов с миллионами покупателей по всему Азербайджану.</p>
            <p class="text-muted mb-4">Мы верим, что каждый заслуживает доступа к качественным товарам по честным ценам, а каждый предприниматель должен иметь возможность легко начать продавать онлайн.</p>
            <div class="d-flex gap-3">
                <a href="/Shop" class="btn btn-primary px-4">Начать покупки</a>
                <a href="/Account/Register" class="btn btn-outline-secondary px-4">Стать продавцом</a>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="row g-3">
                <div class="col-6">
                    <div class="about-stat-card" style="background: linear-gradient(135deg, #e0e7ff, #ede9fe);">
                        <div class="about-stat-num text-primary">10K+</div>
                        <div class="about-stat-label">Товаров на платформе</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="about-stat-card" style="background: linear-gradient(135deg, #d1fae5, #a7f3d0);">
                        <div class="about-stat-num text-success">500+</div>
                        <div class="about-stat-label">Активных продавцов</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="about-stat-card" style="background: linear-gradient(135deg, #fef3c7, #fde68a);">
                        <div class="about-stat-num text-warning">50K+</div>
                        <div class="about-stat-label">Довольных покупателей</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="about-stat-card" style="background: linear-gradient(135deg, #fee2e2, #fecaca);">
                        <div class="about-stat-num text-danger">4.9★</div>
                        <div class="about-stat-label">Средняя оценка сервиса</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Values -->
    <section class="mb-6">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Наши ценности</h2>
            <p class="text-muted">Принципы, которыми мы руководствуемся каждый день</p>
        </div>
        <div class="row g-4">
            <div class="col-md-3 text-center">
                <div class="value-icon" style="background:#e0e7ff; color:#6366f1;"><i class="bi bi-shield-check"></i></div>
                <h5 class="fw-bold mt-3">Надёжность</h5>
                <p class="text-muted small">Гарантируем качество каждого товара и честность каждой сделки</p>
            </div>
            <div class="col-md-3 text-center">
                <div class="value-icon" style="background:#d1fae5; color:#059669;"><i class="bi bi-lightning-charge"></i></div>
                <h5 class="fw-bold mt-3">Скорость</h5>
                <p class="text-muted small">Быстрая обработка заказов и оперативная доставка по всей стране</p>
            </div>
            <div class="col-md-3 text-center">
                <div class="value-icon" style="background:#fef3c7; color:#d97706;"><i class="bi bi-people"></i></div>
                <h5 class="fw-bold mt-3">Сообщество</h5>
                <p class="text-muted small">Создаём экосистему, где продавцы и покупатели растут вместе</p>
            </div>
            <div class="col-md-3 text-center">
                <div class="value-icon" style="background:#fee2e2; color:#dc2626;"><i class="bi bi-heart"></i></div>
                <h5 class="fw-bold mt-3">Забота</h5>
                <p class="text-muted small">Поддержка клиентов 24/7 и программа защиты покупателей</p>
            </div>
        </div>
    </section>

    <!-- Team -->
    <section>
        <div class="text-center mb-5">
            <h2 class="fw-bold">Наша команда</h2>
            <p class="text-muted">Люди, которые делают EcommersShop лучше каждый день</p>
        </div>
        <div class="row g-4 justify-content-center">
            @{
                var team = new[] {
                    new { Name = "Natig E.", Role = "CEO & Co-Founder", Avatar = "N", Color = "#6366f1" },
                    new { Name = "Aytac M.", Role = "Head of Product", Avatar = "A", Color = "#8b5cf6" },
                    new { Name = "Rauf A.", Role = "Lead Developer", Avatar = "R", Color = "#10b981" },
                    new { Name = "Nigar H.", Role = "Marketing Director", Avatar = "N", Color = "#ec4899" },
                };
            }
            @foreach (var member in team)
            {
                <div class="col-6 col-md-3 text-center">
                    <div class="team-avatar mx-auto mb-3" style="background: @member.Color;">@member.Avatar</div>
                    <h6 class="fw-bold mb-0">@member.Name</h6>
                    <small class="text-muted">@member.Role</small>
                </div>
            }
        </div>
    </section>
</div>

@section Styles {
<style>
    .mb-6 { margin-bottom: 4rem; }
    .about-stat-card { border-radius: 14px; padding: 1.5rem; text-align: center; }
    .about-stat-num { font-size: 2rem; font-weight: 800; }
    .about-stat-label { font-size: .8rem; color: #6b7280; margin-top: 4px; }
    .value-icon { width: 64px; height: 64px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; margin: 0 auto; }
    .team-avatar { width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1.8rem; font-weight: 700; }
</style>
}
