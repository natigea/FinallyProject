@{
    ViewData["Title"] = L["Footer_About"].Value;
}

@section Styles {
<style>
    .about-hero {
        background: #1a1a1a;
        color: #fff;
        padding: 64px 0 56px;
        text-align: center;
    }
    .about-hero h1 { font-size: 2rem; font-weight: 800; letter-spacing: -.5px; margin-bottom: 10px; }
    .about-hero p  { font-size: 1rem; color: rgba(255,255,255,.55); margin: 0; }

    .about-wrap { max-width: 1020px; margin: 0 auto; padding: 0 16px; }

    /* ── Section spacing ── */
    .about-section { padding: 56px 0; border-bottom: 1px solid #e8eaed; }
    .about-section:last-child { border-bottom: none; }

    /* ── Why ── */
    .why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
    .why-text h2 { font-size: 1.5rem; font-weight: 800; color: #1a1a1a; margin-bottom: 16px; letter-spacing: -.4px; }
    .why-text p  { font-size: .9rem; color: #555; line-height: 1.75; margin-bottom: 12px; }
    .why-text p:last-of-type { margin-bottom: 24px; }
    .why-btns { display: flex; gap: 10px; flex-wrap: wrap; }
    .btn-dark-solid {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 10px 20px; border-radius: 9px;
        background: #1a1a1a; color: #fff;
        font-size: .875rem; font-weight: 600;
        text-decoration: none; transition: opacity .15s;
    }
    .btn-dark-solid:hover { opacity: .85; color: #fff; }
    .btn-outline-neutral {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 9px 18px; border-radius: 9px;
        border: 1.5px solid #e0e4ec; color: #1a1a1a;
        font-size: .875rem; font-weight: 600;
        text-decoration: none; transition: border-color .15s;
    }
    .btn-outline-neutral:hover { border-color: #aaa; }

    /* Stats grid */
    .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .stat-card {
        background: #f4f5f7;
        border-radius: 14px;
        padding: 20px;
        text-align: center;
    }
    .stat-num { font-size: 1.75rem; font-weight: 800; color: #1a1a1a; line-height: 1; }
    .stat-label { font-size: .78rem; color: #888; margin-top: 6px; }

    /* ── How ── */
    .steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
    .step-card {
        background: #fff;
        border: 1.5px solid #e8eaed;
        border-radius: 14px;
        padding: 28px 22px;
        text-align: center;
    }
    .step-icon {
        width: 56px; height: 56px;
        border-radius: 14px;
        background: #f4f5f7;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem; color: #1a1a1a;
        margin: 0 auto 16px;
    }
    .step-card h5 { font-size: .95rem; font-weight: 700; color: #1a1a1a; margin-bottom: 8px; }
    .step-card p  { font-size: .82rem; color: #666; line-height: 1.65; margin: 0; }

    /* ── Values ── */
    .values-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
    .value-card { text-align: center; }
    .value-icon {
        width: 56px; height: 56px;
        border-radius: 14px;
        background: #f4f5f7;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem; color: #1a1a1a;
        margin: 0 auto 14px;
    }
    .value-card h5 { font-size: .9rem; font-weight: 700; color: #1a1a1a; margin-bottom: 6px; }
    .value-card p  { font-size: .8rem; color: #777; line-height: 1.6; margin: 0; }

    /* ── Team ── */
    .team-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; justify-items: center; }
    .team-card { text-align: center; }
    .team-avatar {
        width: 68px; height: 68px;
        border-radius: 50%;
        background: #1a1a1a;
        color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.5rem; font-weight: 700;
        margin: 0 auto 12px;
    }
    .team-card h6 { font-size: .88rem; font-weight: 700; color: #1a1a1a; margin-bottom: 2px; }
    .team-card small { font-size: .75rem; color: #888; }

    /* Section heading */
    .sec-title { font-size: 1.35rem; font-weight: 800; color: #1a1a1a; margin-bottom: 6px; letter-spacing: -.4px; }
    .sec-sub   { font-size: .875rem; color: #888; margin-bottom: 32px; }
    .sec-header { text-align: center; margin-bottom: 36px; }

    @@media (max-width: 768px) {
        .why-grid    { grid-template-columns: 1fr; gap: 28px; }
        .steps-grid  { grid-template-columns: 1fr; }
        .values-grid { grid-template-columns: 1fr 1fr; }
        .team-grid   { grid-template-columns: 1fr 1fr; }
        .stats-grid  { grid-template-columns: 1fr 1fr; }
    }
</style>
}

<!-- Hero -->
<div class="about-hero">
    <div class="about-wrap">
        <h1>@L["About_HeroTitle"]</h1>
        <p>@L["About_HeroSub"]</p>
    </div>
</div>

<div class="about-wrap">

    <!-- Why section -->
    <div class="about-section">
        <div class="why-grid">
            <div class="why-text">
                <h2>@L["About_WhyTitle"]</h2>
                <p>@L["About_P1"]</p>
                <p>@L["About_P2"]</p>
                <div class="why-btns">
                    <a href="/Listing" class="btn-dark-solid"><i class="bi bi-grid"></i>@L["Common_BrowseListings"]</a>
                    <a href="/Listing/Create" class="btn-outline-neutral"><i class="bi bi-plus-lg"></i>@L["Nav_PostListing"]</a>
                </div>
            </div>
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-num">10K+</div>
                    <div class="stat-label">@L["About_StatListings"]</div>
                </div>
                <div class="stat-card">
                    <div class="stat-num">5K+</div>
                    <div class="stat-label">@L["About_StatUsers"]</div>
                </div>
                <div class="stat-card">
                    <div class="stat-num">80+</div>
                    <div class="stat-label">@L["About_StatCities"]</div>
                </div>
                <div class="stat-card">
                    <div class="stat-num">@L["About_StatFree"]</div>
                    <div class="stat-label">@L["About_StatFreeLabel"]</div>
                </div>
            </div>
        </div>
    </div>

    <!-- How it works -->
    <div class="about-section">
        <div class="sec-header">
            <div class="sec-title">@L["About_HowTitle"]</div>
            <div class="sec-sub">@L["About_HowSub"]</div>
        </div>
        <div class="steps-grid">
            <div class="step-card">
                <div class="step-icon"><i class="bi bi-person-plus"></i></div>
                <h5>1. @L["About_Step1T"]</h5>
                <p>@L["About_Step1D"]</p>
            </div>
            <div class="step-card">
                <div class="step-icon"><i class="bi bi-camera"></i></div>
                <h5>2. @L["About_Step2T"]</h5>
                <p>@L["About_Step2D"]</p>
            </div>
            <div class="step-card">
                <div class="step-icon"><i class="bi bi-chat-dots"></i></div>
                <h5>3. @L["About_Step3T"]</h5>
                <p>@L["About_Step3D"]</p>
            </div>
        </div>
    </div>

    <!-- Values -->
    <div class="about-section">
        <div class="sec-header">
            <div class="sec-title">@L["About_ValTitle"]</div>
            <div class="sec-sub">@L["About_ValSub"]</div>
        </div>
        <div class="values-grid">
            <div class="value-card">
                <div class="value-icon"><i class="bi bi-shield-check"></i></div>
                <h5>@L["About_Val1T"]</h5>
                <p>@L["About_Val1D"]</p>
            </div>
            <div class="value-card">
                <div class="value-icon"><i class="bi bi-lightning-charge"></i></div>
                <h5>@L["About_Val2T"]</h5>
                <p>@L["About_Val2D"]</p>
            </div>
            <div class="value-card">
                <div class="value-icon"><i class="bi bi-people"></i></div>
                <h5>@L["About_Val3T"]</h5>
                <p>@L["About_Val3D"]</p>
            </div>
            <div class="value-card">
                <div class="value-icon"><i class="bi bi-geo-alt"></i></div>
                <h5>@L["About_Val4T"]</h5>
                <p>@L["About_Val4D"]</p>
            </div>
        </div>
    </div>

    <!-- Team -->
    <div class="about-section">
        <div class="sec-header">
            <div class="sec-title">@L["About_TeamTitle"]</div>
            <div class="sec-sub">@L["About_TeamSub"]</div>
        </div>
        <div class="team-grid">
            @{
                var team = new[] {
                    new { Name = "Natig E.",  Role = "Founder", Init = "N" },
                    new { Name = "Aytac M.", Role = "Design",   Init = "A" },
                    new { Name = "Rauf A.",  Role = "Backend",  Init = "R" },
                    new { Name = "Nigar H.", Role = "Marketing",Init = "N" },
                };
            }
            @foreach (var m in team)
            {
                <div class="team-card">
                    <div class="team-avatar">@m.Init</div>
                    <h6>@m.Name</h6>
                    <small>@m.Role</small>
                </div>
            }
        </div>
    </div>

</div>
