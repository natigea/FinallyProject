@{
    ViewData["Title"] = L["Footer_Contacts"].Value;
}

@section Styles {
<style>
    .contact-hero {
        background: #1a1a1a;
        color: #fff;
        padding: 64px 0 56px;
        text-align: center;
    }
    .contact-hero h1 { font-size: 2rem; font-weight: 800; letter-spacing: -.5px; margin-bottom: 10px; }
    .contact-hero p  { font-size: 1rem; color: rgba(255,255,255,.55); margin: 0; }

    .contact-wrap { max-width: 1020px; margin: 0 auto; padding: 0 16px; }

    /* ── Main content row ── */
    .contact-body {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 36px;
        padding: 48px 0 60px;
    }

    /* ── Info panel ── */
    .info-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 20px;
    }
    .info-items { display: flex; flex-direction: column; gap: 14px; margin-bottom: 36px; }
    .info-item { display: flex; align-items: flex-start; gap: 12px; }
    .info-icon {
        width: 40px; height: 40px;
        border-radius: 10px;
        background: #f4f5f7;
        color: #1a1a1a;
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }
    .info-item-label { font-size: .78rem; font-weight: 600; color: #1a1a1a; margin-bottom: 1px; }
    .info-item-val   { font-size: .82rem; color: #666; }
    .info-item-val a { color: #666; text-decoration: none; }
    .info-item-val a:hover { color: #1a1a1a; text-decoration: underline; }

    .social-title { font-size: .85rem; font-weight: 700; color: #1a1a1a; margin-bottom: 10px; }
    .social-row { display: flex; gap: 8px; }
    .soc-link {
        width: 36px; height: 36px;
        border-radius: 8px;
        border: 1.5px solid #e0e4ec;
        display: flex; align-items: center; justify-content: center;
        color: #555; font-size: .95rem;
        text-decoration: none;
        transition: border-color .15s, color .15s;
    }
    .soc-link:hover { border-color: #1a1a1a; color: #1a1a1a; }

    /* ── Form card ── */
    .form-card {
        background: #fff;
        border: 1.5px solid #e8eaed;
        border-radius: 16px;
        padding: 32px;
    }
    .form-card-title { font-size: 1rem; font-weight: 700; color: #1a1a1a; margin-bottom: 20px; }
    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px; }
    .field-group { margin-bottom: 14px; }
    .field-label {
        display: block; font-size: .78rem; font-weight: 600;
        color: #555; margin-bottom: 5px; letter-spacing: .1px;
    }
    .field-input {
        width: 100%;
        border: 1.5px solid #e0e4ec;
        border-radius: 9px;
        padding: 10px 14px;
        font-size: .875rem;
        font-family: inherit;
        color: #1a1a1a;
        background: #fff;
        outline: none;
        transition: border-color .2s, box-shadow .2s;
        -webkit-appearance: none;
    }
    .field-input:focus {
        border-color: #1a1a1a;
        box-shadow: 0 0 0 3px rgba(17,17,17,.07);
    }
    .field-input::placeholder { color: #ccc; }
    .submit-btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 11px 28px;
        background: #1a1a1a; color: #fff;
        border: none; border-radius: 9px;
        font-size: .875rem; font-weight: 600; font-family: inherit;
        cursor: pointer; transition: opacity .15s;
    }
    .submit-btn:hover { opacity: .85; }
    .sent-alert {
        border-radius: 10px; padding: 12px 16px;
        background: #d1fae5; color: #065f46;
        font-size: .875rem; margin-bottom: 20px;
        display: flex; align-items: center; gap: 8px;
    }

    /* ── FAQ ── */
    .faq-section { padding: 0 0 60px; }
    .faq-title { font-size: 1.35rem; font-weight: 800; color: #1a1a1a; text-align: center; margin-bottom: 28px; letter-spacing: -.4px; }
    .faq-list { display: flex; flex-direction: column; gap: 8px; }
    .faq-item {
        border: 1.5px solid #e8eaed;
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
    }
    .faq-q {
        width: 100%;
        background: none;
        border: none;
        padding: 16px 20px;
        text-align: left;
        font-size: .875rem;
        font-weight: 600;
        font-family: inherit;
        color: #1a1a1a;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        transition: background .15s;
    }
    .faq-q:hover { background: #f8f9fa; }
    .faq-q i { transition: transform .2s; flex-shrink: 0; color: #999; }
    .faq-q.open i { transform: rotate(180deg); }
    .faq-a {
        display: none;
        padding: 0 20px 16px;
        font-size: .855rem;
        color: #555;
        line-height: 1.7;
    }
    .faq-a.open { display: block; }

    @@media (max-width: 768px) {
        .contact-body { grid-template-columns: 1fr; gap: 24px; }
        .field-row    { grid-template-columns: 1fr; }
    }
</style>
}

<!-- Hero -->
<div class="contact-hero">
    <div class="contact-wrap">
        <h1>@L["Contact_HeroTitle"]</h1>
        <p>@L["Contact_HeroSub"]</p>
    </div>
</div>

<div class="contact-wrap">

    <div class="contact-body">

        <!-- Left: info -->
        <aside>
            <div class="info-title">@L["Contact_InfoTitle"]</div>
            <div class="info-items">
                <div class="info-item">
                    <div class="info-icon"><i class="bi bi-envelope-fill"></i></div>
                    <div>
                        <div class="info-item-label">@L["Contact_EmailLabel"]</div>
                        <div class="info-item-val"><a href="mailto:support@alisveris.az">support@alisveris.az</a></div>
                    </div>
                </div>
                <div class="info-item">
                    <div class="info-icon"><i class="bi bi-telegram"></i></div>
                    <div>
                        <div class="info-item-label">@L["Contact_TelegramLabel"]</div>
                        <div class="info-item-val"><a href="https://t.me/alisverisaz" target="_blank">@@alisverisaz</a></div>
                    </div>
                </div>
                <div class="info-item">
                    <div class="info-icon"><i class="bi bi-geo-alt-fill"></i></div>
                    <div>
                        <div class="info-item-label">@L["Contact_AddressLabel"]</div>
                        <div class="info-item-val">@L["Contact_AddressVal"]</div>
                    </div>
                </div>
                <div class="info-item">
                    <div class="info-icon"><i class="bi bi-clock-fill"></i></div>
                    <div>
                        <div class="info-item-label">@L["Contact_HoursLabel"]</div>
                        <div class="info-item-val">@L["Contact_HoursVal"]</div>
                    </div>
                </div>
            </div>

            <div class="social-title">@L["Contact_SocialTitle"]</div>
            <div class="social-row">
                <a href="#" class="soc-link"><i class="bi bi-instagram"></i></a>
                <a href="#" class="soc-link"><i class="bi bi-facebook"></i></a>
                <a href="#" class="soc-link"><i class="bi bi-telegram"></i></a>
                <a href="#" class="soc-link"><i class="bi bi-twitter-x"></i></a>
            </div>
        </aside>

        <!-- Right: form -->
        <div class="form-card">
            <div class="form-card-title">@L["Contact_FormTitle"]</div>

            @if (TempData["ContactSent"] != null)
            {
                <div class="sent-alert">
                    <i class="bi bi-check-circle-fill"></i>@L["Contact_Sent"]
                </div>
            }

            <form asp-controller="Home" asp-action="Contact" method="post">
                <div class="field-row">
                    <div>
                        <label class="field-label">@L["Contact_NameLabel"]</label>
                        <input type="text" name="name" class="field-input" placeholder="..." required />
                    </div>
                    <div>
                        <label class="field-label">@L["Contact_EmailFieldLabel"]</label>
                        <input type="email" name="email" class="field-input" placeholder="your@email.com" required />
                    </div>
                </div>
                <div class="field-group">
                    <label class="field-label">@L["Contact_SubjectLabel"]</label>
                    <select name="subject" class="field-input">
                        <option value="">@L["Contact_SubjectPh"]</option>
                        <option value="listing">@L["Contact_Subj_Listing"]</option>
                        <option value="account">@L["Contact_Subj_Account"]</option>
                        <option value="safety">@L["Contact_Subj_Safety"]</option>
                        <option value="seller">@L["Contact_Subj_Seller"]</option>
                        <option value="other">@L["Contact_Subj_Other"]</option>
                    </select>
                </div>
                <div class="field-group">
                    <label class="field-label">@L["Contact_MessageLabel"]</label>
                    <textarea name="message" class="field-input" rows="5"
                              placeholder="@L["Contact_MessagePh"]" required style="resize:vertical;"></textarea>
                </div>
                <button type="submit" class="submit-btn">
                    <i class="bi bi-send"></i>@L["Contact_Send"]
                </button>
            </form>
        </div>
    </div>

    <!-- FAQ -->
    <div class="faq-section">
        <div class="faq-title">@L["Contact_FaqTitle"]</div>
        <div class="faq-list">
            @{
                var faqs = new[] {
                    new { Q = L["Contact_Faq1Q"].Value, A = L["Contact_Faq1A"].Value },
                    new { Q = L["Contact_Faq2Q"].Value, A = L["Contact_Faq2A"].Value },
                    new { Q = L["Contact_Faq3Q"].Value, A = L["Contact_Faq3A"].Value },
                    new { Q = L["Contact_Faq4Q"].Value, A = L["Contact_Faq4A"].Value },
                    new { Q = L["Contact_Faq5Q"].Value, A = L["Contact_Faq5A"].Value },
                };
                int fi = 0;
            }
            @foreach (var faq in faqs)
            {
                <div class="faq-item">
                    <button class="faq-q @(fi == 0 ? "open" : "")" onclick="toggleFaq(this)">
                        @faq.Q
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <div class="faq-a @(fi == 0 ? "open" : "")">@faq.A</div>
                </div>
                fi++;
            }
        </div>
    </div>

</div>

@section Scripts {
<script>
    function toggleFaq(btn) {
        const item = btn.closest('.faq-item');
        const ans  = item.querySelector('.faq-a');
        const isOpen = btn.classList.contains('open');
        // close all
        document.querySelectorAll('.faq-q').forEach(b => b.classList.remove('open'));
        document.querySelectorAll('.faq-a').forEach(a => a.classList.remove('open'));
        // open clicked if it was closed
        if (!isOpen) {
            btn.classList.add('open');
            ans.classList.add('open');
        }
    }
</script>
}
