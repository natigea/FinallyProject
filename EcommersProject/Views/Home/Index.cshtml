<!-- ─── Categories ────────────────────────────── -->
@if (Model.Categories.Any())
{
    <div class="container" style="margin-top:24px;">
        <div class="cat-section surface p-3">
            <div class="cat-grid">
                @{ int ci = 0; }
                @foreach (var cat in Model.Categories)
                {
                    var color = catColors[ci % catColors.Length];
                    ci++;
                    <a href="/Listing?categoryId=@cat.Id" class="cat-item">
                        <div class="cat-icon" style="background:@(color)14;color:@color;">
                            <i class="bi @cat.Icon"></i>
                        </div>
                        <span class="cat-label">@(L["Cat_" + cat.Slug] is { ResourceNotFound: false } ck ? ck.Value : cat.Name)</span>
                    </a>
                }
            </div>
        </div>
    </div>
}

<!-- ─── Recent listings ───────────────────────── -->
<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="sec-heading mb-0">@L["Home_FreshListings"]</h2>
        <a href="/Listing" class="btn-outline-dark-custom px-4 py-2 d-flex align-items-center gap-1" style="font-size:.82rem;">
            @L["Home_ViewAll"] <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    @if (Model.RecentListings.Any())
    {
        <div class="home-grid">
            @foreach (var l in Model.RecentListings)
            {
                @await Html.PartialAsync("_ListingCard", l)
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-card-list"></i>
            <p>@L["Home_NoListings"] <a href="/Listing/Create" class="fw-semibold">@L["Home_PostFirst"]</a></p>
        </div>
    }
</div>


@section Styles {
<style>
    /* ──── Hero ──────────────────────────────────── */
    .hero {
        background: linear-gradient(155deg, #020c1e 0%, #081d50 40%, #1340a0 72%, #1a56db 100%);
        padding: 5.5rem 0 4.5rem;
        position: relative;
        overflow: hidden;
    }
    .hero::before {
        content: '';
        position: absolute; inset: 0;
        background:
            radial-gradient(ellipse at 8% 65%, rgba(26,86,219,.32) 0%, transparent 50%),
            radial-gradient(ellipse at 92% 18%, rgba(96,165,250,.2) 0%, transparent 45%),
            radial-gradient(ellipse at 55% 85%, rgba(37,99,235,.18) 0%, transparent 40%);
        pointer-events: none;
    }
    .hero::after {
        content: '';
        position: absolute; inset: 0;
        background-image: radial-gradient(circle, rgba(255,255,255,.055) 1px, transparent 1px);
        background-size: 26px 26px;
        pointer-events: none;
    }
    .hero-inner { position: relative; z-index: 1; }
    .hero-title {
        font-size: clamp(2rem, 4.5vw, 3rem);
        font-weight: 800;
        margin-bottom: 1.75rem;
        color: #fff;
        letter-spacing: -.6px;
        line-height: 1.15;
    }
    /* Hero search */
    .hero-input-wrap {
        display: flex; align-items: center;
        background: #fff;
        border-radius: 50px;
        overflow: hidden;
        max-width: 700px;
        box-shadow: 0 20px 60px rgba(0,0,0,.32), 0 4px 24px rgba(26,86,219,.22);
        padding: 5px;
    }
    .hero-ico { padding: 0 10px 0 20px; color: var(--muted); font-size: 1.05rem; flex-shrink: 0; }
    .hero-input {
        flex: 1; border: none; outline: none; background: transparent;
        padding: 15px 8px; font-size: .95rem; font-family: inherit; color: var(--text); min-width: 0;
    }
    .hero-btn {
        background: var(--accent);
        color: #fff;
        border: none; border-radius: 40px;
        padding: 13px 28px;
        font-size: .9rem; font-weight: 700; font-family: inherit;
        cursor: pointer; white-space: nowrap; flex-shrink: 0;
        transition: background .15s, box-shadow .15s;
        box-shadow: 0 4px 16px rgba(26,86,219,.48);
    }
    .hero-btn:hover { background: var(--accent-h); box-shadow: 0 6px 22px rgba(26,86,219,.62); }

    /* Hero support */
    .hero-support { display: flex; align-items: center; gap: 22px; margin-top: 2.2rem; flex-wrap: wrap; }
    .hero-support-item {
        display: flex; align-items: center; gap: 8px;
        color: rgba(255,255,255,.72); font-size: .82rem; font-weight: 500;
    }
    .hero-support-item i { font-size: .85rem; color: rgba(255,255,255,.45); }
    .hero-support-item a {
        color: rgba(255,255,255,.85); text-decoration: none; transition: color .15s;
    }
    .hero-support-item a:hover { color: #fff; }
    .hero-support-sep { width: 1px; height: 22px; background: rgba(255,255,255,.14); flex-shrink: 0; }
    @@media (max-width: 480px) { .hero-support { gap: 12px; } .hero-support-sep { display: none; } }
    @@media (max-width: 600px) { .hero-input-wrap { border-radius: 16px; } .hero-btn { border-radius: 12px; } }
    /* Filter icon button */
    .hero-filter-btn {
        display: flex;
        align-items: center; justify-content: center;
        width: 42px; height: 42px; flex-shrink: 0;
        color: var(--sub); font-size: 1.15rem;
        border-radius: 10px; border: none; background: transparent; cursor: pointer;
        transition: background .15s, color .15s;
        margin-right: 2px;
    }
    .hero-filter-btn:hover { color: var(--accent); background: rgba(26,86,219,.07); }

    /* ──── Category section ──────────────────── */
    .cat-section { padding: 18px 22px; }
    .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: 4px; }
    .cat-item {
        display: flex; flex-direction: column; align-items: center; gap: 8px;
        padding: 15px 6px; border-radius: 12px;
        transition: background .15s, transform .2s; color: var(--text); cursor: pointer;
    }
    .cat-item:hover { background: var(--accent-soft); transform: translateY(-3px); }
    .cat-item:hover .cat-label { color: var(--accent); }
    .cat-icon {
        width: 52px; height: 52px; border-radius: 15px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem; transition: transform .2s;
    }
    .cat-item:hover .cat-icon { transform: scale(1.1); }
    .cat-label { font-size: .71rem; font-weight: 600; text-align: center; line-height: 1.2; color: var(--sub); }

    /* ──── Brand marquee ───────────────────────── */
    .brand-marquee-wrap {
        margin-top: 2.5rem;
        overflow: hidden;
        mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
        -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .brand-marquee { overflow: hidden; }
    .brand-track {
        display: flex;
        gap: 10px;
        width: max-content;
        will-change: transform;
    }
    .brand-marquee-left .brand-track {
        animation: marqueeLeft 28s linear infinite;
    }
    .brand-marquee-right .brand-track {
        animation: marqueeRight 32s linear infinite;
    }
    @@keyframes marqueeLeft {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
    @@keyframes marqueeRight {
        0%   { transform: translateX(-50%); }
        100% { transform: translateX(0); }
    }
    .brand-card {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        border-radius: 28px;
        background: rgba(255,255,255,.1);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,.12);
        color: rgba(255,255,255,.85);
        font-size: .78rem;
        font-weight: 600;
        white-space: nowrap;
        transition: transform .2s, background .2s;
        cursor: default;
    }
    .brand-card:hover {
        transform: scale(1.08);
        background: rgba(255,255,255,.18);
    }
    .brand-marquee-wrap:hover .brand-track {
        animation-play-state: paused;
    }

    /* ──── Home grid ─────────────────────────── */
    .home-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; }
    @@media (max-width: 576px) { .home-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; } }
</style>
}
