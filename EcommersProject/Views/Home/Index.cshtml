                    <span class="brand-card">🎮 Sony</span>
                    <span class="brand-card">👟 Nike</span>
                    <span class="brand-card">⚡ Adidas</span>
                    <span class="brand-card">🏎️ BMW</span>
                    <span class="brand-card">⭐ Mercedes</span>
                    <span class="brand-card">📺 LG</span>
                    <span class="brand-card">📡 Huawei</span>
                    <span class="brand-card">🔋 Xiaomi</span>
                    <span class="brand-card">💻 HP</span>
                    <span class="brand-card">🖥️ Dell</span>
                    <span class="brand-card">🎯 Asus</span>
                    <!-- duplicate for seamless loop -->
                    <span class="brand-card">🚗 Toyota</span>
                    <span class="brand-card">📱 Samsung</span>
                    <span class="brand-card">🍎 Apple</span>
                    <span class="brand-card">🎮 Sony</span>
                    <span class="brand-card">👟 Nike</span>
                    <span class="brand-card">⚡ Adidas</span>
                    <span class="brand-card">🏎️ BMW</span>
                    <span class="brand-card">⭐ Mercedes</span>
                    <span class="brand-card">📺 LG</span>
                    <span class="brand-card">📡 Huawei</span>
                    <span class="brand-card">🔋 Xiaomi</span>
                    <span class="brand-card">💻 HP</span>
                    <span class="brand-card">🖥️ Dell</span>
                    <span class="brand-card">🎯 Asus</span>
                </div>
            </div>
            <div class="brand-marquee brand-marquee-right">
                <div class="brand-track">
                    <span class="brand-card">🧥 Lenovo</span>
                    <span class="brand-card">🐆 Puma</span>
                    <span class="brand-card">👗 Zara</span>
                    <span class="brand-card">👕 H&amp;M</span>
                    <span class="brand-card">🏠 IKEA</span>
                    <span class="brand-card">👜 Gucci</span>
                    <span class="brand-card">💎 Louis Vuitton</span>
                    <span class="brand-card">🌸 Chanel</span>
                    <span class="brand-card">⌚ Rolex</span>
