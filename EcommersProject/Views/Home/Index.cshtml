@model HomeViewModel
@{
    ViewData["Title"] = L["Common_Home"].Value;
    var catColors = new[] { "#1a56db","#0284c7","#0369a1","#1e40af","#2563eb","#0891b2","#1d4ed8","#3b82f6","#0ea5e9","#155e75" };
}

<!-- ─── Hero ──────────────────────────────────── -->
<section class="hero">
    <div class="container hero-inner">
        <h1 class="hero-title">@L["Home_FindEverything"]</h1>
        <form action="/Listing" method="get" class="hero-form">
            <div class="hero-input-wrap">
                <i class="bi bi-search hero-ico"></i>
                <input type="text" name="q" placeholder="@L["Home_WhatLooking"]" class="hero-input" id="heroSearchInput" />
                <button type="button" class="hero-filter-btn" data-bs-toggle="modal" data-bs-target="#filterModal" title="@L["Browse_Filters"]">
                    <i class="bi bi-sliders2"></i>
                </button>
                <button type="submit" class="hero-btn">@L["Home_Find"]</button>
            </div>
        </form>
        <div class="hero-support">
            <div class="hero-support-item">
                <i class="bi bi-telephone-fill"></i>
                <a href="tel:+994993838898">+994 99 383 88 98</a>
            </div>
            <div class="hero-support-sep"></div>
            <div class="hero-support-item">
                <i class="bi bi-envelope-fill"></i>
                <a href="mailto:alisverisaze@gmail.com">alisverisaze&#64;gmail.com</a>
            </div>
            <div class="hero-support-sep"></div>
            <div class="hero-support-item">
                <i class="bi bi-clock-fill"></i>
                <span>@L["Home_SupportHours"]</span>
            </div>
        </div>

