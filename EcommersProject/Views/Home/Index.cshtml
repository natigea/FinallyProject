@model HomeViewModel
@{
    ViewData["Title"] = L["Common_Home"].Value;
    var catColors = new[] { "#6366f1","#0284c7","#d97706","#16a34a","#db2777","#7c3aed","#dc2626","#0891b2","#ea580c","#0d9488" };
}

<!-- ─── Hero ──────────────────────────────────── -->
<section class="hero">
    <div class="container">
        <h1 class="hero-title">@L["Home_FindEverything"]</h1>
        <form action="/Listing" method="get" class="hero-form">
            <div class="hero-input-wrap">
                <i class="bi bi-search hero-ico"></i>
                <input type="text" name="q" placeholder="@L["Home_WhatLooking"]" class="hero-input" />
                <div class="hero-sep"></div>
                <select name="city" class="hero-city">
                    <option value="">@L["Home_AllCities"]</option>
                    <option>Bakı</option><option>Sumqayıt</option><option>Gəncə</option>
                    <option>Mingəçevir</option><option>Naxçıvan</option><option>Lənkəran</option>
                    <option>Şəki</option><option>Quba</option><option>Şirvan</option>
                </select>
                <button type="submit" class="hero-btn">@L["Home_Find"]</button>
            </div>
        </form>
    </div>
</section>

<!-- ─── Categories ────────────────────────────── -->
@if (Model.Categories.Any())
{
    <div class="container" style="margin-top:24px;">
        <div class="cat-section surface p-3">
            <div class="cat-grid">
                @{ int ci = 0; }
                @foreach (var cat in Model.Categories)
                {
                    var color = catColors[ci % catColors.Length];
                    ci++;
                    <a href="/Listing?categoryId=@cat.Id" class="cat-item">
                        <div class="cat-icon" style="background:@(color)14;color:@color;">
                            <i class="bi @cat.Icon"></i>
                        </div>
                        <span class="cat-label">@(L["Cat_" + cat.Slug] is { ResourceNotFound: false } ck ? ck.Value : cat.Name)</span>
                    </a>
                }
            </div>
        </div>
    </div>
}

<!-- ─── Recent listings ───────────────────────── -->
<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="sec-heading mb-0">@L["Home_FreshListings"]</h2>
        <a href="/Listing" class="btn-outline-dark-custom px-4 py-2 d-flex align-items-center gap-1" style="font-size:.82rem;">
            @L["Home_ViewAll"] <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    @if (Model.RecentListings.Any())
    {
        <div class="home-grid">
            @foreach (var l in Model.RecentListings)
            {
                @await Html.PartialAsync("_ListingCard", l)
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-card-list"></i>
            <p>@L["Home_NoListings"] <a href="/Listing/Create" class="fw-semibold">@L["Home_PostFirst"]</a></p>
        </div>
    }
</div>


@section Styles {
<style>
    /* Hero */
    .hero {
        background: #fff;
        border-bottom: 1px solid var(--border);
        padding: 3rem 0 2.5rem;
    }
    .hero-eyebrow { font-size: .78rem; color: var(--muted); text-transform: uppercase; letter-spacing: .8px; margin-bottom: .5rem; }
    .hero-title { font-size: clamp(1.5rem, 3.5vw, 2rem); font-weight: 800; margin-bottom: 1.25rem; color: var(--text); }

    .hero-input-wrap {
        display: flex;
        align-items: center;
        background: var(--bg);
        border: 1.5px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        max-width: 640px;
    }
    .hero-input-wrap:focus-within { border-color: #aaa; }
    .hero-ico { padding: 0 10px 0 14px; color: var(--muted); font-size: 1rem; flex-shrink: 0; }
    .hero-input {
        flex: 1; border: none; outline: none; background: transparent;
        padding: 11px 8px; font-size: .9rem; font-family: inherit; color: var(--text); min-width: 0;
    }
    .hero-sep { width: 1px; height: 22px; background: var(--border); flex-shrink: 0; margin: 0 4px; }
    .hero-city {
        border: none; outline: none; background: transparent;
        padding: 11px 10px; font-size: .85rem; font-family: inherit;
        color: var(--sub); cursor: pointer; flex-shrink: 0; max-width: 130px;
    }
    .hero-btn {
        background: var(--text); color: #fff;
        border: none; padding: 11px 20px;
        font-size: .875rem; font-weight: 600; font-family: inherit;
        cursor: pointer; white-space: nowrap; flex-shrink: 0; transition: opacity .15s;
    }
    .hero-btn:hover { opacity: .85; }

    .hero-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 1rem; }
    .hero-tags span { font-size: .76rem; color: var(--muted); }
    .hero-tags a {
        font-size: .78rem; color: var(--sub);
        border: 1px solid var(--border);
        padding: 3px 10px; border-radius: 20px;
        background: var(--bg); transition: all .15s;
    }
    .hero-tags a:hover { border-color: #aaa; color: var(--text); }

    /* Cat section */
    .cat-section { padding: 1rem; }
    .cat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(85px, 1fr));
        gap: 4px;
    }
    .cat-item {
        display: flex; flex-direction: column; align-items: center; gap: 6px;
        padding: 12px 6px; border-radius: var(--radius); transition: background .15s; color: var(--text);
    }
    .cat-item:hover { background: var(--bg); }
    .cat-icon {
        width: 44px; height: 44px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.2rem; transition: transform .18s;
    }
    .cat-item:hover .cat-icon { transform: scale(1.08); }
    .cat-label { font-size: .72rem; font-weight: 500; text-align: center; line-height: 1.2; color: var(--sub); }

    /* Grid */
    .home-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(185px, 1fr));
        gap: 10px;
    }
    @@media (max-width: 576px) { .home-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; } }

</style>
}
