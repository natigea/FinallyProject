@model EcommersProject.Models.VipViewModel
@using EcommersProject.BLL.Services
@{
    ViewData["Title"] = L["Checkout_VipTitle"];
    var l = Model.Listing;
    var stripeKey = ViewBag.StripePublishableKey as string ?? "";
}

<div class="container py-4" style="max-width:860px;">
    <nav class="mb-4"><ol class="breadcrumb" style="font-size:.78rem;">
        <li class="breadcrumb-item"><a href="/" style="color:var(--accent);">@L["Common_Home"]</a></li>
        <li class="breadcrumb-item"><a href="/Listing/Detail/@l.Id" style="color:var(--accent);">@l.Title</a></li>
        <li class="breadcrumb-item active">@L["Checkout_VipTitle"]</li>
    </ol></nav>

    <div class="row g-4">
        <!-- Form -->
        <div class="col-lg-7">
            <form asp-action="Vip" asp-route-listingId="@l.Id" method="post" id="vipForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="StripePaymentIntentId" id="stripePaymentIntentId" />

                <!-- Plan selector -->
                <div class="form-block mb-3">
                    <h6 class="block-title"><i class="bi bi-star me-2 text-warning"></i>@L["Checkout_VipPlanSection"]</h6>
                    <div class="plan-grid">
                        @foreach (var (days, price) in new[] { (7, 4.99m), (14, 7.99m), (30, 14.99m) })
                        {
                            <label class="plan-card @(days == Model.VipDays ? "selected" : "")" onclick="selectPlan(this, @days, @price.ToString("N2", System.Globalization.CultureInfo.InvariantCulture))">
                                <input type="radio" name="VipDays" value="@days" @(days == Model.VipDays ? "checked" : "") />
                                @if (days == 30)
                                {
                                    <span class="plan-popular">@L["Checkout_VipGoodDeal"]</span>
                                }
                                <div class="plan-days">@string.Format(L["Checkout_Result_Days"], days)</div>
                                <div class="plan-price">@price.ToString("N2") ₼</div>
                                <div class="plan-per">@((price / days).ToString("N2")) ₼/d</div>
                            </label>
                        }
                    </div>
                    <span asp-validation-for="VipDays" class="val-msg"></span>
                </div>

                <!-- Perks -->
                <div class="vip-perks mb-3">
                    <div class="perk"><i class="bi bi-arrow-up-circle-fill text-warning"></i><span>@L["Checkout_VipBenefit1"]</span></div>
                    <div class="perk"><i class="bi bi-star-fill text-warning"></i><span>@L["Checkout_VipBenefit2"]</span></div>
                    <div class="perk"><i class="bi bi-eye-fill text-warning"></i><span>@L["Checkout_VipBenefit3"]</span></div>
                </div>

                <!-- Stripe Card -->
                <div class="form-block mb-4">
                    <h6 class="block-title"><i class="bi bi-credit-card me-2"></i>@L["Checkout_CardSection"]</h6>
                    <div id="stripe-card-element" class="stripe-card-wrap"></div>
                    <div id="stripe-error" class="val-msg mt-2" role="alert"></div>
                    <div class="stripe-secure mt-2">
                        <i class="bi bi-shield-lock-fill me-1 text-success"></i>
                        <span>@L["Checkout_CardProtected"]</span>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div id="pay-error-global" class="alert alert-danger d-none mb-3"></div>

                <button type="button" class="btn-pay" id="payBtn" onclick="handlePay()">
                    <i class="bi bi-star-fill me-2"></i><span id="payBtnText">@L["Checkout_VipActivateBtn"]</span>
                </button>
                <p class="text-center text-muted mt-2" style="font-size:.72rem;">
                    <i class="bi bi-stripe me-1"></i>Оплата через Stripe · SSL шифрование
                </p>
            </form>
        </div>

        <!-- Listing preview -->
        <div class="col-lg-5">
            <div class="form-block mb-3">
                <h6 class="block-title">@L["Checkout_YourListing"]</h6>
                <div class="d-flex gap-3 align-items-start">
                    @if (l.Images.Any())
                    { <img src="@l.Images[0].Url" class="rounded" style="width:72px;height:60px;object-fit:cover;flex-shrink:0;" /> }
                    else
                    { <div style="width:72px;height:60px;background:#f4f5f7;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="bi bi-image text-muted"></i></div> }
                    <div>
                        <div class="fw-semibold" style="font-size:.875rem;">@l.Title</div>
                        <div class="fw-bold" style="font-size:1rem;">@l.Price.ToString("N0") ₼</div>
                        <div class="text-muted" style="font-size:.78rem;"><i class="bi bi-geo-alt me-1"></i>@l.City</div>
                        @if (l.IsVip && l.VipExpiresAt.HasValue)
                        {
                            <div class="mt-1 text-warning" style="font-size:.75rem;"><i class="bi bi-star-fill me-1"></i>@L["Checkout_VipUntil"] @l.VipExpiresAt.Value.ToString("dd.MM.yyyy")</div>
                        }
                    </div>
                </div>
            </div>

            <div class="form-block" style="background:#fafafa;">
                <p class="fw-semibold mb-2" style="font-size:.8rem;">@L["Checkout_TestCards"]</p>
                <div class="d-flex gap-2 mb-1 align-items-center" style="font-size:.75rem;">
                    <span class="test-badge ok">@L["Checkout_TestSuccess"]</span> 4242 4242 4242 4242
                </div>
                <div class="d-flex gap-2 mb-1 align-items-center" style="font-size:.75rem;">
                    <span class="test-badge fail">3D-Secure</span> 4000 0027 6000 3184
                </div>
                <div class="d-flex gap-2 align-items-center" style="font-size:.75rem;">
                    <span class="test-badge fail">@L["Checkout_TestDeclined"]</span> 4000 0000 0000 9995
                </div>
                <p class="text-muted mt-2 mb-0" style="font-size:.72rem;">@L["Checkout_TestCardHint"]</p>
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
    .form-block { background:#fff; border:1px solid var(--border); border-radius:12px; padding:20px 22px; }
    .block-title { font-size:.83rem; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:var(--muted); margin-bottom:16px; }
    .form-label-sm { font-size:.83rem; font-weight:600; margin-bottom:5px; display:block; }
    .form-ctrl { width:100%; border:1.5px solid var(--border); border-radius:8px; padding:9px 12px; font-size:.875rem; font-family:inherit; outline:none; transition:border-color .2s; }
    .val-msg { font-size:.73rem; color:#dc2626; }

    .plan-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
    .plan-card { position:relative; border:2px solid var(--border); border-radius:10px; padding:14px 10px; text-align:center; cursor:pointer; transition:all .15s; }
    .plan-card input[type=radio] { position:absolute; opacity:0; width:0; height:0; }
    .plan-card:hover { border-color:#f59e0b; }
    .plan-card.selected { border-color:#f59e0b; background:#fffbeb; }
    .plan-popular { position:absolute; top:-9px; left:50%; transform:translateX(-50%); background:#f59e0b; color:#fff; font-size:.6rem; font-weight:700; padding:2px 8px; border-radius:20px; white-space:nowrap; }
    .plan-days { font-size:.9rem; font-weight:700; color:var(--text); }
    .plan-price { font-size:1.15rem; font-weight:800; color:#f59e0b; }
    .plan-per { font-size:.65rem; color:var(--muted); }

    .vip-perks { background:#fffbeb; border:1px solid #fde68a; border-radius:10px; padding:14px 16px; display:flex; flex-direction:column; gap:8px; }
    .perk { display:flex; align-items:center; gap:10px; font-size:.875rem; color:var(--sub); }
    .perk i { font-size:1rem; flex-shrink:0; }

    .btn-pay { width:100%; padding:13px; background:linear-gradient(135deg,#f59e0b,#d97706); color:#fff; border:none; border-radius:10px; font-size:.95rem; font-weight:700; font-family:inherit; cursor:pointer; transition:all .2s; display:flex; align-items:center; justify-content:center; box-shadow:0 4px 14px rgba(245,158,11,.35); }
    .btn-pay:hover:not(:disabled) { transform:translateY(-1px); box-shadow:0 6px 20px rgba(245,158,11,.45); }
    .btn-pay:disabled { opacity:.65; cursor:not-allowed; }

    .test-badge { display:inline-block; padding:2px 8px; border-radius:20px; font-size:.68rem; font-weight:600; }
    .test-badge.ok { background:#dcfce7; color:#166534; }
    .test-badge.fail { background:#fee2e2; color:#991b1b; }

    .stripe-card-wrap { border:1.5px solid var(--border); border-radius:8px; padding:11px 13px; transition:border-color .2s; }
    .stripe-card-wrap.StripeElement--focus { border-color:#f59e0b; box-shadow:0 0 0 3px rgba(245,158,11,.1); }
    .stripe-card-wrap.StripeElement--invalid { border-color:#dc2626; }
    .stripe-secure { font-size:.72rem; color:var(--muted); display:flex; align-items:center; }
</style>
}
@section Scripts {
<script src="https://js.stripe.com/v3/"></script>
<script>
    const stripe = Stripe('@stripeKey');
    const elements = stripe.elements();
    const cardElement = elements.create('card', {
        style: {
            base: { fontSize: '15px', color: '#1a1a1a', fontFamily: 'inherit', '::placeholder': { color: '#9ca3af' } },
            invalid: { color: '#dc2626' }
        },
        hidePostalCode: true
    });
    cardElement.mount('#stripe-card-element');

    let selectedDays = @Model.VipDays;
    let selectedPrice = @(PurchaseService.GetVipPrice(Model.VipDays).ToString("N2", System.Globalization.CultureInfo.InvariantCulture));

    function selectPlan(card, days, price) {
        document.querySelectorAll('.plan-card').forEach(c => c.classList.remove('selected'));
        card.classList.add('selected');
        card.querySelector('input').checked = true;
        selectedDays = days;
        selectedPrice = price;
    }

    async function handlePay() {
        const btn = document.getElementById('payBtn');
        const errGlobal = document.getElementById('pay-error-global');
        const errStripe = document.getElementById('stripe-error');
        errGlobal.classList.add('d-none');
        errStripe.textContent = '';

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Обработка...';

        try {
            // Step 1: create payment intent for selected plan
            const piResp = await fetch('/Checkout/CreatePaymentIntent', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ type: 'vip', listingId: '@l.Id', vipDays: selectedDays })
            });
            if (!piResp.ok) throw new Error('Ошибка создания платежа');
            const { clientSecret } = await piResp.json();

            // Step 2: confirm card payment
            const { paymentIntent, error } = await stripe.confirmCardPayment(clientSecret, {
                payment_method: { card: cardElement }
            });

            if (error) {
                errStripe.textContent = error.message;
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-star-fill me-2"></i>@L["Checkout_VipActivateBtn"]';
                return;
            }

            // Step 3: submit form
            document.getElementById('stripePaymentIntentId').value = paymentIntent.id;
            document.getElementById('vipForm').submit();

        } catch (e) {
            errGlobal.textContent = e.message || 'Неизвестная ошибка. Попробуйте снова.';
            errGlobal.classList.remove('d-none');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-star-fill me-2"></i>@L["Checkout_VipActivateBtn"]';
        }
    }
</script>
}
