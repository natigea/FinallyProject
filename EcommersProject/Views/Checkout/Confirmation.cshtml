@model OrderConfirmationViewModel
@{
    ViewData["Title"] = "Заказ оформлен";
    var o = Model.Order;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 text-center">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                 style="width:96px; height:96px; background: linear-gradient(135deg, #d1fae5, #a7f3d0);">
                <i class="bi bi-check-circle-fill text-success" style="font-size:3rem;"></i>
            </div>
            <h2 class="fw-bold mb-2">Заказ оформлен!</h2>
            <p class="text-muted mb-1">Номер заказа: <strong class="text-dark">@o.OrderNumber</strong></p>
            <p class="text-muted mb-4">Мы отправим подтверждение на ваш email.</p>

            <div class="card border-0 shadow-sm rounded-3 text-start mb-4">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Состав заказа</h6>
                    @foreach (var item in o.Items)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small">@item.ProductName × @item.Quantity</span>
                            <span class="small fw-semibold">@item.TotalPrice.ToString("N2") ₼</span>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Доставка</span>
                        <span>@o.ShippingAmount.ToString("N2") ₼</span>
                    </div>
                    @if (o.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between text-success">
                            <span>Скидка</span>
                            <span>−@o.DiscountAmount.ToString("N2") ₼</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between fw-bold fs-5 mt-2">
                        <span>Итого</span>
                        <span class="text-primary">@o.TotalAmount.ToString("N2") ₼</span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 justify-content-center">
                <a href="/Account/Orders" class="btn btn-outline-primary px-4">
                    <i class="bi bi-bag me-2"></i>Мои заказы
                </a>
                <a href="/Shop" class="btn btn-primary px-4">
                    <i class="bi bi-grid me-2"></i>Продолжить покупки
                </a>
            </div>
        </div>
    </div>
</div>
