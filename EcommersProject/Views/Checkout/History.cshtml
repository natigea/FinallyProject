@model IReadOnlyList<EcommersProject.BLL.DTOs.PurchaseGetDto>
@{
    ViewData["Title"] = L["Checkout_History_Title"];
}

<div class="container py-4" style="max-width:780px;">
    <h2 class="fw-bold mb-4"><i class="bi bi-bag-check me-2"></i>@L["Checkout_History_Title"]</h2>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-bag-x fs-1 text-muted"></i>
            <h5 class="mt-3 text-muted">@L["Checkout_History_Empty"]</h5>
            <a href="/Listing" class="btn btn-primary mt-3">@L["Checkout_History_Browse"]</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var p in Model)
            {
                bool ok = p.Status == "Completed";
                bool isVip = p.Type == "Vip";
                <div class="ph-card">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="type-badge @(isVip ? "type-vip" : "type-delivery")">
                                    <i class="bi @(isVip ? "bi-star-fill" : "bi-truck") me-1"></i>
                                    @(isVip ? L["Checkout_History_Vip"].Value : L["Checkout_History_Delivery"].Value)
                                </span>
                                <span class="fw-bold" style="font-size:.9rem;">@p.OrderNumber</span>
                            </div>
                            <div class="text-muted mt-1" style="font-size:.75rem;">@p.CreatedDate.ToString("dd MMMM yyyy, HH:mm")</div>
                        </div>
                        <div class="text-end">
                            <span class="status-badge status-@p.Status.ToLower()">
                                @if (p.Status == "Completed") { @L["Checkout_History_StatusPaid"] }
                                else if (p.Status == "Failed") { @L["Checkout_History_StatusDeclined"] }
                                else { @L["Checkout_History_StatusPending"] }
                            </span>
                            <div class="fw-bold mt-1">@p.TotalAmount.ToString("N2") ₼</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div>
                            <div style="font-size:.875rem;">@p.ListingTitle</div>
                            @if (isVip && p.VipDays.HasValue)
                            {
                                <div class="text-muted" style="font-size:.75rem;"><i class="bi bi-calendar3 me-1"></i>@p.VipDays @L["Checkout_History_Vip"]</div>
                            }
                            else if (!isVip && p.DeliveryCity != null)
                            {
                                <div class="text-muted" style="font-size:.75rem;"><i class="bi bi-geo-alt me-1"></i>@p.DeliveryCity</div>
                            }
                            @if (ok && p.CardLast4 != null)
                            {
                                <div class="text-muted" style="font-size:.75rem;"><i class="bi bi-credit-card me-1"></i>•••• @p.CardLast4</div>
                            }
                            @if (!isVip && ok && !string.IsNullOrEmpty(p.SellerApprovalStatus))
                            {
                                <div class="mt-1 seller-status seller-@p.SellerApprovalStatus.ToLower()">
                                    @if (p.SellerApprovalStatus == "Pending")
                                    {
                                        <i class="bi bi-hourglass-split me-1"></i>@L["Checkout_History_SellerPending"]
                                    }
                                    else if (p.SellerApprovalStatus == "Approved")
                                    {
                                        <i class="bi bi-check-circle-fill me-1"></i>@L["Checkout_History_SellerApproved"]
                                    }
                                    else if (p.SellerApprovalStatus == "Rejected")
                                    {
                                        <i class="bi bi-x-circle-fill me-1"></i>@L["Checkout_History_SellerRejected"]
                                    }
                                </div>
                            }
                        </div>
                        <a href="/Listing/Detail/@p.ListingId" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-box-arrow-up-right me-1"></i>@L["Checkout_History_GoListing"]
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Styles {
<style>
    .ph-card { background:#fff; border:1px solid var(--border); border-radius:12px; padding:18px 20px; transition:transform .15s, box-shadow .15s; }
    .ph-card:hover { transform:translateY(-2px); box-shadow:0 6px 20px rgba(0,0,0,.07); }
    .type-badge { display:inline-flex; align-items:center; padding:2px 9px; border-radius:20px; font-size:.7rem; font-weight:700; }
    .type-vip      { background:#fef9c3; color:#854d0e; }
    .type-delivery { background:#e0f2fe; color:#0369a1; }
    .status-badge { display:inline-block; padding:2px 9px; border-radius:20px; font-size:.7rem; font-weight:600; }
    .status-completed { background:#dcfce7; color:#166534; }
    .status-failed    { background:#fee2e2; color:#991b1b; }
    .status-pending   { background:#fef9c3; color:#854d0e; }
    .seller-status { font-size:.74rem; font-weight:600; display:flex; align-items:center; }
    .seller-pending  { color:#d97706; }
    .seller-approved { color:#16a34a; }
    .seller-rejected { color:#dc2626; }
</style>
}
