@using Microsoft.Extensions.Localization
@using EcommersProject.Resources
@inject IStringLocalizer<SharedResource> L
@model CartViewModel
@{
    ViewData["Title"] = L["Cart_Title"].Value;
}

<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-cart3 me-2"></i>@L["Cart_Title"]</h2>

    @if (Model.Cart == null || !Model.Cart.Items.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x fs-1 text-muted"></i>
            <h5 class="mt-3 text-muted">@L["Cart_Empty"]</h5>
            <a href="/Shop" class="btn btn-primary mt-3">
                <i class="bi bi-grid me-2"></i>@L["Cart_GoToShop"]
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-0">
                        @foreach (var item in Model.Cart.Items)
                        {
                            <div class="d-flex align-items-center gap-3 p-3 border-bottom">
                                <div style="width:70px; height:70px; background:#f1f5f9; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                    <i class="bi bi-image text-muted fs-4"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <p class="fw-semibold mb-0">@item.ProductName</p>
                                    <small class="text-muted">@item.UnitPrice.ToString("N2") ₼ @L["Cart_PerUnit"]</small>
                                </div>
                                <form method="post" action="/Cart/UpdateQuantity" class="d-flex align-items-center gap-1">
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="adjustInput(this, -1)">−</button>
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm text-center" style="width:55px" />
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="adjustInput(this, 1)">+</button>
                                    <button class="btn btn-outline-primary btn-sm ms-1" type="submit">
                                        <i class="bi bi-check"></i>
                                    </button>
                                </form>
                                <div class="fw-bold" style="min-width:80px; text-align:right;">
                                    @((item.UnitPrice * item.Quantity).ToString("N2")) ₼
                                </div>
                                <form method="post" action="/Cart/RemoveItem">
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <button class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        }
                        <div class="p-3 d-flex justify-content-between">
                            <a href="/Shop" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-arrow-left me-1"></i>@L["Cart_Continue"]
                            </a>
                            <form method="post" action="/Cart/Clear">
                                <button class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash me-1"></i>@L["Cart_Clear"]
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Summary -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-3 p-4">
                    <h5 class="fw-bold mb-4">@L["Cart_Summary"]</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">@L["Cart_Products"]</span>
                        <span>@Model.Subtotal.ToString("N2") ₼</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">@L["Cart_Delivery"]</span>
                        <span>@Model.Shipping.ToString("N2") ₼</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
                        <span>@L["Cart_Total"]</span>
                        <span class="text-primary">@Model.Total.ToString("N2") ₼</span>
                    </div>
                    <a href="/Checkout" class="btn btn-primary w-100 py-2 fw-semibold">
                        @L["Cart_Checkout"] <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
function adjustInput(btn, delta) {
    const form = btn.closest('form');
    const input = form.querySelector('input[type=number]');
    const newVal = parseInt(input.value) + delta;
    if (newVal >= 1) input.value = newVal;
}
</script>
}
