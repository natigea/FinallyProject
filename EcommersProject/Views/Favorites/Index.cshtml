@model FavoritesViewModel
@{
    ViewData["Title"] = "Избранное";
}

<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-heart me-2 text-danger"></i>Избранное</h2>

    @if (!Model.Items.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-heart fs-1 text-muted"></i>
            <h5 class="mt-3 text-muted">Список избранного пуст</h5>
            <a href="/Shop" class="btn btn-primary mt-3">Перейти в каталог</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model.Items)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card product-card h-100">
                        <div class="card-img-placeholder">
                            <i class="bi bi-image"></i>
                        </div>
                        <div class="card-body p-3">
                            <a href="/Shop/Detail/@item.ProductId" class="text-decoration-none text-dark fw-semibold d-block mb-2">
                                @item.ProductName
                            </a>
                            <div class="d-flex gap-2">
                                <form method="post" action="/Cart/AddItem" class="flex-grow-1">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button class="btn btn-primary btn-sm w-100">
                                        <i class="bi bi-cart-plus me-1"></i>В корзину
                                    </button>
                                </form>
                                <form method="post" action="/Favorites/Toggle">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button class="btn btn-outline-danger btn-sm" title="Удалить из избранного">
                                        <i class="bi bi-heart-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
