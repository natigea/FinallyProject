@using Microsoft.Extensions.Localization
@using EcommersProject.Resources
@inject IStringLocalizer<SharedResource> L
@model ShopViewModel
@{
    ViewData["Title"] = L["Shop_Title"].Value;
}

<div class="container py-4">
    <div class="row g-4">

        <!-- Sidebar filters -->
        <div class="col-md-3 filter-sidebar">
            <div class="card border-0 shadow-sm rounded-3 p-3 mb-3">
                <h6 class="fw-bold mb-3">@L["Shop_Categories"]</h6>
                <div class="d-flex flex-column gap-1">
                    <a href="/Shop@(string.IsNullOrEmpty(Model.SearchQuery) ? "" : "?q=" + Model.SearchQuery)"
                       class="category-pill @(Model.CategoryId == null ? "active" : "")">
                        @L["Shop_AllCategories"]
                    </a>
                    @foreach (var cat in Model.Categories)
                    {
                        <a href="/Shop?categoryId=@cat.Id@(!string.IsNullOrEmpty(Model.SearchQuery) ? "&q=" + Model.SearchQuery : "")"
                           class="category-pill @(Model.CategoryId == cat.Id ? "active" : "")">
                            @cat.Name
                        </a>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-3 p-3 mb-3">
                <h6 class="fw-bold mb-3">@L["Shop_Brands"]</h6>
                <div class="d-flex flex-column gap-1">
                    @foreach (var brand in Model.Brands)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="brand-@brand.Id"
                                   @(Model.BrandId == brand.Id ? "checked" : "")
                                   onchange="applyBrand('@brand.Id', this.checked)" />
                            <label class="form-check-label" for="brand-@brand.Id">@brand.Name</label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Products grid -->
        <div class="col-md-9">
            <!-- Toolbar -->
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    @if (!string.IsNullOrEmpty(Model.SearchQuery))
                    {
                        <span class="text-muted">@L["Shop_SearchResults"] <strong>@Model.SearchQuery</strong> — </span>
                    }
                    <span class="text-muted small">@L["Shop_Found"] @Model.Products.Count @L["Shop_Products"]</span>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <label class="text-muted small me-1">@L["Shop_Sort"]</label>
                    <select class="form-select form-select-sm" style="width: auto" onchange="applySort(this.value)">
                        @if (Model.Sort == null) { <option value="" selected>@L["Shop_SortDefault"]</option> } else { <option value="">@L["Shop_SortDefault"]</option> }
                        @if (Model.Sort == "price_asc") { <option value="price_asc" selected>@L["Shop_SortPriceAsc"]</option> } else { <option value="price_asc">@L["Shop_SortPriceAsc"]</option> }
                        @if (Model.Sort == "price_desc") { <option value="price_desc" selected>@L["Shop_SortPriceDesc"]</option> } else { <option value="price_desc">@L["Shop_SortPriceDesc"]</option> }
                        @if (Model.Sort == "rating") { <option value="rating" selected>@L["Shop_SortRating"]</option> } else { <option value="rating">@L["Shop_SortRating"]</option> }
                    </select>
                </div>
            </div>

            @if (!Model.Products.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-search fs-1 text-muted"></i>
                    <p class="text-muted mt-3">@L["Shop_NotFound"]</p>
                    <a href="/Shop" class="btn btn-outline-primary">@L["Shop_ResetFilters"]</a>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var p in Model.Products)
                    {
                        <div class="col-6 col-xl-4">
                            @await Html.PartialAsync("_ProductCard", p)
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-4">
                        <ul class="pagination justify-content-center">
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" href="/Shop?page=@i@(!string.IsNullOrEmpty(Model.SearchQuery) ? "&q=" + Model.SearchQuery : "")@(Model.CategoryId.HasValue ? "&categoryId=" + Model.CategoryId : "")@(Model.Sort != null ? "&sort=" + Model.Sort : "")">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
function applySort(val) {
    const url = new URL(window.location.href);
    if (val) url.searchParams.set('sort', val); else url.searchParams.delete('sort');
    window.location.href = url.toString();
}
function applyBrand(id, checked) {
    const url = new URL(window.location.href);
    if (checked) url.searchParams.set('brandId', id); else url.searchParams.delete('brandId');
    window.location.href = url.toString();
}
</script>
}
