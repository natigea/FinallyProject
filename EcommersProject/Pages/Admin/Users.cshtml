@page
@model EcommersProject.Pages.Admin.UsersModel
@using System.Security.Claims
@{
    ViewData["Title"] = L["Admin_Users"].Value;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-1 fw-bold" style="letter-spacing:-.3px;">@L["Admin_ManageUsers"]</h5>
        <span class="small" style="color:var(--text-muted);">@L["Admin_TotalLabel"] @Model.Users.Count</span>
    </div>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body filter-card">
        <form method="get" class="d-flex gap-2 align-items-center flex-wrap">
            <div class="position-relative" style="min-width:260px;">
                <i class="bi bi-search position-absolute" style="left:12px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:.85rem;"></i>
                <input asp-for="Search" type="text" class="form-control form-control-sm ps-5"
                       placeholder="@L["Admin_SearchUsers"]" />
            </div>
            <button type="submit" class="btn btn-sm btn-primary" style="border-radius:8px;">
                <i class="bi bi-search"></i>
            </button>
            <a href="/Admin/Users" class="btn btn-sm btn-outline-secondary" style="border-radius:8px;">@L["Admin_Reset"]</a>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card">
    <div class="card-body p-0">
        @if (!Model.Users.Any())
        {
            <div class="empty-state">
                <i class="bi bi-people"></i>
                @L["Admin_NoUsers"]
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@L["Admin_ColName"]</th>
                            <th>@L["Admin_ColEmail"]</th>
                            <th>@L["Admin_ColPhone"]</th>
                            <th>@L["Admin_ColRole"]</th>
                            <th>@L["Admin_ColStatus"]</th>
                            <th>@L["Admin_ColDate"]</th>
                            <th>@L["Admin_ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Users)
                        {
                            var isSelf = u.Id.ToString() == currentUserId;
                            var isAdmin = u.Role == "Admin";
                            var isSuperAdmin = u.Email.Trim().ToLowerInvariant() == Model.SuperAdminEmail;
                            var currentEmail = User.FindFirstValue(System.Security.Claims.ClaimTypes.Email)?.Trim().ToLowerInvariant();
                            var currentIsSuperAdmin = currentEmail == Model.SuperAdminEmail;
                            <tr style="@(isSelf ? "background:var(--accent-soft);" : "")">
                                <td class="fw-semibold">
                                    @u.FirstName @u.LastName
                                    @if (isSelf)
                                    {
                                        <span class="badge ms-1" style="font-size:.6rem; background:var(--accent-soft); color:var(--accent);">@L["Admin_You"]</span>
                                    }
                                    @if (isSuperAdmin)
                                    {
                                        <span class="badge bg-danger ms-1" style="font-size:.6rem;"><i class="bi bi-star-fill me-1"></i>@L["Admin_SuperAdmin"]</span>
                                    }
                                </td>
                                <td class="small" style="color:var(--text-muted);">@u.Email</td>
                                <td class="small">@(string.IsNullOrEmpty(u.PhoneNumber) ? "—" : u.PhoneNumber)</td>
                                <td>
                                    @if (isAdmin)
                                    {
                                        <span class="badge" style="background:linear-gradient(135deg,#6366f1,#8b5cf6); color:#fff;">
                                            <i class="bi bi-shield-fill me-1"></i>@L["Admin_RoleAdmin"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">@L["Admin_RoleUser"]</span>
                                    }
                                </td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            <i class="bi bi-check-circle me-1"></i>@L["Admin_UserActive"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger">
                                            <i class="bi bi-x-circle me-1"></i>@L["Admin_UserInactive"]
                                        </span>
                                    }
                                </td>
                                <td class="small" style="color:var(--text-muted);">@u.CreatedDate.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        @if (isSuperAdmin)
                                        {
                                            <span class="small fst-italic" style="color:var(--text-muted);">@L["Admin_Protected"]</span>
                                        }
                                        else if (!isSelf)
                                        {
                                            @if (!isAdmin)
                                            {
                                                <form method="post" asp-page-handler="SetRole"
                                                      onsubmit="return confirm('@L["Admin_MakeAdminConfirm"]')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id"   value="@u.Id" />
                                                    <input type="hidden" name="role" value="Admin" />
                                                    <button class="btn btn-sm btn-outline-danger btn-action"
                                                            title="@L["Admin_MakeAdmin"]">
                                                        <i class="bi bi-shield-plus"></i>
                                                    </button>
                                                </form>
                                            }
                                            else if (currentIsSuperAdmin)
                                            {
                                                <form method="post" asp-page-handler="SetRole"
                                                      onsubmit="return confirm('@L["Admin_RemoveAdminConfirm"]')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id"   value="@u.Id" />
                                                    <input type="hidden" name="role" value="Customer" />
                                                    <button class="btn btn-sm btn-outline-warning btn-action"
                                                            title="@L["Admin_RemoveAdmin"]">
                                                        <i class="bi bi-shield-minus"></i>
                                                    </button>
                                                </form>
                                            }

                                            @if (u.IsActive)
                                            {
                                                <form method="post" asp-page-handler="Deactivate">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@u.Id" />
                                                    <button class="btn btn-sm btn-outline-warning btn-action"
                                                            title="@L["Admin_Deactivate"]">
                                                        <i class="bi bi-pause-circle"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form method="post" asp-page-handler="Activate">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@u.Id" />
                                                    <button class="btn btn-sm btn-outline-success btn-action"
                                                            title="@L["Admin_Activate"]">
                                                        <i class="bi bi-play-circle"></i>
                                                    </button>
                                                </form>
                                            }

                                            <form method="post" asp-page-handler="Delete"
                                                  onsubmit="return confirm('@L["Admin_DeleteUserConfirm"]')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@u.Id" />
                                                <button class="btn btn-sm btn-outline-danger btn-action"
                                                        title="@L["Common_Delete"]">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="small fst-italic" style="color:var(--text-muted);">—</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
