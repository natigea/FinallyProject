@page
@model EcommersProject.Pages.Admin.CouponsModel
@{
    ViewData["Title"] = L["SP_Categories"];
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span><i class="bi bi-tags-fill me-2" style="color:var(--accent);"></i>@L["SP_Categories"]</span>
                <span class="badge" style="background:var(--accent-soft); color:var(--accent);">@Model.Categories.Count</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Categories.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-tags"></i>
                        @L["SP_NoCategoriesYet"]
                    </div>
                }
                else
                {
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:48px;">#</th>
                                <th style="width:56px;">@L["SP_Icon"]</th>
                                <th>@L["SP_Name"]</th>
                                <th>@L["SP_Description"]</th>
                                <th style="width:64px;">@L["SP_Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Categories.Count; i++)
                            {
                                var c = Model.Categories[i];
                                <tr>
                                    <td class="small" style="color:var(--text-muted);">@(i + 1)</td>
                                    <td>
                                        <div style="width:36px;height:36px;border-radius:10px;background:var(--accent-soft);display:flex;align-items:center;justify-content:center;">
                                            <i class="bi @c.Icon" style="font-size:1.1rem;color:var(--accent);"></i>
                                        </div>
                                    </td>
                                    <td class="fw-semibold">@c.Name</td>
                                    <td class="small" style="color:var(--text-muted);">@(string.IsNullOrEmpty(c.Description) ? "—" : c.Description)</td>
                                    <td>
                                        <form method="post" asp-page-handler="Delete"
                                              onsubmit="return confirm('@L["SP_ConfirmDeleteCategory"]')">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button class="btn btn-sm btn-outline-danger btn-action">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card" style="border-top:3px solid #10b981;">
            <div class="card-header">
                <i class="bi bi-plus-circle-fill me-2 text-success"></i>@L["SP_NewCategory"]
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="Create">
                    <div class="mb-3">
                        <label class="form-label">@L["SP_Name"] <span class="text-danger">*</span></label>
                        <input asp-for="NewName" type="text" class="form-control" placeholder="@L["SP_CategoryNamePlaceholder"]" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["SP_Description"]</label>
                        <textarea asp-for="NewDescription" class="form-control" rows="2"
                                  placeholder="@L["SP_CategoryDescPlaceholder"]"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Bootstrap Icon</label>
                        <div class="input-group">
                            <span class="input-group-text" style="border-radius:8px 0 0 8px; background:var(--accent-soft); border-color:var(--card-border);">
                                <i id="iconPreview" class="bi bi-tag" style="color:var(--accent);"></i>
                            </span>
                            <input asp-for="NewIcon" type="text" class="form-control" placeholder="bi-tag"
                                   oninput="document.getElementById('iconPreview').className='bi '+this.value" />
                        </div>
                        <div class="form-text" style="font-size:.75rem;">@L["SP_IconExamples"]</div>
                    </div>
                    <button type="submit" class="btn btn-success w-100" style="border-radius:10px; font-weight:600;">
                        <i class="bi bi-plus-lg me-1"></i>@L["SP_AddCategory"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
