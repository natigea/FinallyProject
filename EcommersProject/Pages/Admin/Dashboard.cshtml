@page
@model EcommersProject.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = L["Admin_Dashboard"].Value;
}

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card bg-gradient-primary">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">@Model.TotalListings</div>
                    <div class="stat-label">@L["Admin_TotalListings"]</div>
                </div>
                <i class="bi bi-grid-3x3-gap stat-icon"></i>
            </div>
            <div class="mt-2 small opacity-75">
                @L["Admin_ActiveLabel"] @Model.ActiveListings
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card bg-gradient-success">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">@Model.TotalUsers</div>
                    <div class="stat-label">@L["Admin_TotalUsers"]</div>
                </div>
                <i class="bi bi-people stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card bg-gradient-warning">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">@Model.TotalCategories</div>
                    <div class="stat-label">@L["Admin_TotalCategories"]</div>
                </div>
                <i class="bi bi-tag stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a href="/Admin/Products" class="text-decoration-none">
            <div class="stat-card @(Model.PendingListings > 0 ? "bg-gradient-danger" : "bg-gradient-info")">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-value">@Model.PendingListings</div>
                        <div class="stat-label">@L["Admin_PendingListings"]</div>
                    </div>
                    <i class="bi bi-hourglass-split stat-icon"></i>
                </div>
                @if (Model.PendingListings > 0)
                {
                    <div class="mt-2 small opacity-75">@L["Admin_RequireReview"]</div>
                }
            </div>
        </a>
    </div>
</div>

<!-- Recent Listings -->
<div class="card">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <span><i class="bi bi-clock-history me-2 text-warning"></i>@L["Admin_RecentListings"]</span>
        <a href="/Admin/Products" class="btn btn-sm btn-outline-secondary">@L["Admin_AllListings"]</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.RecentListings.Any())
        {
            <div class="empty-state"><i class="bi bi-inbox"></i>@L["Admin_NoListings"]</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>@L["Admin_ColTitle"]</th>
                            <th>@L["Admin_ColCategory"]</th>
                            <th>@L["Admin_ColCity"]</th>
                            <th>@L["Admin_ColPrice"]</th>
                            <th>@L["Admin_ColAuthor"]</th>
                            <th>@L["Admin_ColStatus"]</th>
                            <th>@L["Admin_ColDate"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.RecentListings)
                        {
                            <tr>
                                <td class="fw-medium">
                                    <a href="/Listing/Detail/@l.Id" class="text-decoration-none text-dark">@l.Title</a>
                                </td>
                                <td class="small text-muted">@(l.CategoryName ?? "—")</td>
                                <td class="small">@l.City</td>
                                <td class="fw-medium">@l.Price.ToString("N0") ₼</td>
                                <td class="small">@(l.UserName ?? "—")</td>
                                <td>
                                    @if (l.Status == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success">@L["Status_Active"]</span>
                                    }
                                    else if (l.Status == "Closed")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">@L["Status_Closed"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">@L["Status_Pending"]</span>
                                    }
                                </td>
                                <td class="small text-muted">@l.CreatedDate.ToString("dd.MM.yy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
