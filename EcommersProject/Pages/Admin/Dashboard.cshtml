@page
@model EcommersProject.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = L["Admin_Dashboard"].Value;
}

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="kpi bg-g-indigo">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="kpi-icon"><i class="bi bi-grid-3x3-gap-fill"></i></div>
            </div>
            <div class="kpi-value">@Model.TotalListings</div>
            <div class="kpi-label">@L["Admin_TotalListings"]</div>
            <div class="kpi-sub">
                <i class="bi bi-check-circle me-1"></i>@L["Admin_ActiveLabel"] @Model.ActiveListings
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi bg-g-emerald">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="kpi-icon"><i class="bi bi-people-fill"></i></div>
            </div>
            <div class="kpi-value">@Model.TotalUsers</div>
            <div class="kpi-label">@L["Admin_TotalUsers"]</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi bg-g-amber">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="kpi-icon"><i class="bi bi-tags-fill"></i></div>
            </div>
            <div class="kpi-value">@Model.TotalCategories</div>
            <div class="kpi-label">@L["Admin_TotalCategories"]</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a href="/Admin/Products" class="text-decoration-none">
            <div class="kpi @(Model.PendingListings > 0 ? "bg-g-rose" : "bg-g-sky")">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="kpi-icon"><i class="bi bi-hourglass-split"></i></div>
                </div>
                <div class="kpi-value">@Model.PendingListings</div>
                <div class="kpi-label">@L["Admin_PendingListings"]</div>
                @if (Model.PendingListings > 0)
                {
                    <div class="kpi-sub">
                        <i class="bi bi-arrow-right me-1"></i>@L["Admin_RequireReview"]
                    </div>
                }
            </div>
        </a>
    </div>
</div>

<!-- Recent Listings -->
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <span><i class="bi bi-clock-history me-2" style="color:var(--accent);"></i>@L["Admin_RecentListings"]</span>
        <a href="/Admin/Products" class="btn btn-sm btn-outline-secondary" style="border-radius:8px; font-size:.8rem;">
            @L["Admin_AllListings"] <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
    <div class="card-body p-0">
        @if (!Model.RecentListings.Any())
        {
            <div class="empty-state"><i class="bi bi-inbox"></i>@L["Admin_NoListings"]</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>@L["Admin_ColTitle"]</th>
                            <th>@L["Admin_ColCategory"]</th>
                            <th>@L["Admin_ColCity"]</th>
                            <th>@L["Admin_ColPrice"]</th>
                            <th>@L["Admin_ColAuthor"]</th>
                            <th>@L["Admin_ColStatus"]</th>
                            <th>@L["Admin_ColDate"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.RecentListings)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    <a href="/Listing/Detail/@l.Id" class="text-decoration-none" style="color:var(--text-primary);">@l.Title</a>
                                </td>
                                <td class="small" style="color:var(--text-muted);">@(l.CategoryName ?? "—")</td>
                                <td class="small">@l.City</td>
                                <td class="fw-semibold">@l.Price.ToString("N0") ₼</td>
                                <td class="small" style="color:var(--text-secondary);">@(l.UserName ?? "—")</td>
                                <td>
                                    @if (l.Status == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success">@L["Status_Active"]</span>
                                    }
                                    else if (l.Status == "Closed")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">@L["Status_Closed"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">@L["Status_Pending"]</span>
                                    }
                                </td>
                                <td class="small" style="color:var(--text-muted);">@l.CreatedDate.ToString("dd.MM.yy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
