@page
@model EcommersProject.Pages.Admin.OrdersModel
@{
    ViewData["Title"] = "Все объявления";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-1 fw-bold" style="letter-spacing:-.3px;">Все объявления</h5>
        <span class="small" style="color:var(--text-muted);">Найдено: @Model.Listings.Count</span>
    </div>
</div>

<!-- Search filter -->
<div class="card mb-3">
    <div class="card-body filter-card">
        <form method="get" class="d-flex gap-2 align-items-center flex-wrap">
            <div class="position-relative" style="min-width:260px;">
                <i class="bi bi-search position-absolute" style="left:12px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:.85rem;"></i>
                <input asp-for="Search" type="text" class="form-control form-control-sm ps-5"
                       placeholder="Поиск по названию..." />
            </div>
            <button type="submit" class="btn btn-sm btn-primary" style="border-radius:8px;">
                <i class="bi bi-search"></i>
            </button>
            <a href="/Admin/Orders" class="btn btn-sm btn-outline-secondary" style="border-radius:8px;">Сброс</a>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Listings.Any())
        {
            <div class="empty-state">
                <i class="bi bi-grid-3x3-gap"></i>
                Объявления не найдены.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Категория</th>
                            <th>Город</th>
                            <th>Цена</th>
                            <th>Автор</th>
                            <th>Статус</th>
                            <th>Дата</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Listings)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    <a href="/Listing/Detail/@l.Id" class="text-decoration-none" style="color:var(--text-primary);">@l.Title</a>
                                </td>
                                <td class="small" style="color:var(--text-muted);">@(l.CategoryName ?? "—")</td>
                                <td class="small">@l.City</td>
                                <td class="fw-semibold">@l.Price.ToString("N0") ₼</td>
                                <td class="small" style="color:var(--text-secondary);">@(l.UserName ?? "—")</td>
                                <td>
                                    @if (l.Status == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            <i class="bi bi-check-circle me-1"></i>Активно
                                        </span>
                                    }
                                    else if (l.Status == "Closed")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Закрыто</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">
                                            <i class="bi bi-clock me-1"></i>@l.Status
                                        </span>
                                    }
                                </td>
                                <td class="small" style="color:var(--text-muted);">@l.CreatedDate.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        @if (l.Status == "Active")
                                        {
                                            <form method="post" asp-page-handler="Close">
                                                <input type="hidden" name="id" value="@l.Id" />
                                                <button class="btn btn-sm btn-outline-warning btn-action" title="Закрыть">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        <form method="post" asp-page-handler="Delete"
                                              onsubmit="return confirm('Удалить объявление?')">
                                            <input type="hidden" name="id" value="@l.Id" />
                                            <button class="btn btn-sm btn-outline-danger btn-action" title="Удалить">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
