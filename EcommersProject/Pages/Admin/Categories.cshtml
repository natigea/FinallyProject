@page
@model EcommersProject.Pages.Admin.CategoriesModel
@{
    ViewData["Title"] = L["Admin_Categories"].Value;
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span><i class="bi bi-tags-fill me-2" style="color:var(--accent);"></i>@L["Admin_CatSectionTitle"]</span>
                <span class="badge" style="background:var(--accent-soft); color:var(--accent);">@Model.Categories.Count</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Categories.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-tags"></i>
                        @L["Admin_NoCats"]
                    </div>
                }
                else
                {
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:48px;">#</th>
                                <th>@L["Admin_ColName"]</th>
                                <th>@L["Admin_ColDescription"]</th>
                                <th style="width:64px;">@L["Admin_ColActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Categories.Count; i++)
                            {
                                var c = Model.Categories[i];
                                <tr>
                                    <td class="small" style="color:var(--text-muted);">@(i + 1)</td>
                                    <td class="fw-semibold">@c.Name</td>
                                    <td class="small" style="color:var(--text-muted);">@(string.IsNullOrEmpty(c.Description) ? "—" : c.Description)</td>
                                    <td>
                                        <form method="post" asp-page-handler="Delete"
                                              onsubmit="return confirm('@L["Admin_DeleteCatConfirm"]')">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button class="btn btn-sm btn-outline-danger btn-action">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card" style="border-top:3px solid #10b981;">
            <div class="card-header">
                <i class="bi bi-plus-circle-fill me-2 text-success"></i>@L["Admin_NewCategory"]
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="Create">
                    <div class="mb-3">
                        <label class="form-label">@L["Admin_CategoryNameLabel"]</label>
                        <input asp-for="NewName" type="text" class="form-control"
                               placeholder="@L["Admin_CategoryNamePh"]" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["Admin_CategoryDescLabel"]</label>
                        <textarea asp-for="NewDescription" class="form-control" rows="3"
                                  placeholder="@L["Admin_CategoryDescPh"]"></textarea>
                    </div>
                    <button type="submit" class="btn btn-success w-100" style="border-radius:10px; font-weight:600;">
                        <i class="bi bi-plus-lg me-1"></i>@L["Admin_CreateCategory"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
