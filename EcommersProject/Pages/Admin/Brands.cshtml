@page
@model EcommersProject.Pages.Admin.BrandsModel
@{
    ViewData["Title"] = "Модерация объявлений";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-0 fw-bold">Модерация объявлений</h5>
        <small class="text-muted">Всего: @Model.TotalCount</small>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Listings.Any())
        {
            <div class="empty-state">
                <i class="bi bi-grid-3x3-gap"></i>
                Объявлений нет.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Название</th>
                            <th>Категория</th>
                            <th>Город</th>
                            <th>Цена</th>
                            <th>Автор</th>
                            <th>Статус</th>
                            <th>Дата</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Listings)
                        {
                            <tr>
                                <td class="fw-medium">
                                    <a href="/Listing/Detail/@l.Id" class="text-decoration-none text-dark">@l.Title</a>
                                </td>
                                <td class="small text-muted">@(l.CategoryName ?? "—")</td>
                                <td class="small">@l.City</td>
                                <td class="fw-medium">@l.Price.ToString("N0") ₼</td>
                                <td class="small">@(l.UserName ?? "—")</td>
                                <td>
                                    @if (l.Status == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success">Активно</span>
                                    }
                                    else if (l.Status == "Closed")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Закрыто</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">@l.Status</span>
                                    }
                                </td>
                                <td class="small text-muted">@l.CreatedDate.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <form method="post" asp-page-handler="Delete"
                                          onsubmit="return confirm('Удалить объявление «@l.Title»?')">
                                        <input type="hidden" name="id" value="@l.Id" />
                                        <button class="btn btn-sm btn-outline-danger btn-action" title="Удалить">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
