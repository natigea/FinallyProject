@page
@model EcommersProject.Pages.Admin.DeliveryOrdersModel
@{
    ViewData["Title"] = L["DO_Title"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-1 fw-bold" style="letter-spacing:-.3px;">
            <i class="bi bi-truck me-2"></i>@L["DO_Title"]
        </h5>
        <span class="small" style="color:var(--text-muted);">@L["DO_Total"] @Model.Orders.Count</span>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Orders.Any())
        {
            <div class="empty-state">
                <i class="bi bi-truck"></i>
                @L["DO_Empty"]
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@L["DO_Order"]</th>
                            <th>@L["DO_Buyer"]</th>
                            <th>@L["DO_Seller"]</th>
                            <th>@L["DO_Product"]</th>
                            <th>@L["DO_Total2"]</th>
                            <th>@L["DO_Status"]</th>
                            <th>@L["DO_Date"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Orders)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold" style="font-size:.8rem; color:var(--text-primary);">@o.OrderNumber</span>
                                </td>
                                <td>
                                    <span class="fw-semibold" style="color:var(--text-primary);">@(o.BuyerName ?? "—")</span>
                                </td>
                                <td>
                                    <span style="color:var(--text-secondary);">@(o.SellerName ?? "—")</span>
                                </td>
                                <td>
                                    <a href="/Listing/Detail/@o.ListingId" class="text-decoration-none fw-semibold" style="color:var(--accent);">
                                        @o.ListingTitle
                                    </a>
                                </td>
                                <td class="fw-bold" style="color:var(--accent);">@o.TotalAmount.ToString("N2") ₼</td>
                                <td>
                                    @if (o.SellerApprovalStatus == "Approved")
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            <i class="bi bi-check-circle me-1"></i>@L["DO_Approved"]
                                        </span>
                                    }
                                    else if (o.SellerApprovalStatus == "Rejected")
                                    {
                                        <span class="badge bg-danger-subtle text-danger">
                                            <i class="bi bi-x-circle me-1"></i>@L["DO_Rejected"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">
                                            <i class="bi bi-clock me-1"></i>@L["DO_Pending"]
                                        </span>
                                    }
                                </td>
                                <td class="small" style="color:var(--text-muted); white-space:nowrap;">
                                    @o.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modal-@o.Id">
                                        <i class="bi bi-eye me-1"></i>@L["DO_Details"]
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@foreach (var o in Model.Orders)
{
    <div class="modal fade" id="modal-@o.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:16px; border:none; box-shadow:0 8px 40px rgba(0,0,0,.12);">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-bold"><i class="bi bi-receipt me-2"></i>@L["DO_Order"] @o.OrderNumber</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-2">
                    <table class="table table-borderless mb-0" style="font-size:.88rem;">
                        <tbody>
                            <tr>
                                <td class="text-muted" style="width:40%;">@L["DO_Buyer"]</td>
                                <td class="fw-semibold">@(o.BuyerName ?? "—")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">@L["DO_Seller"]</td>
                                <td class="fw-semibold">@(o.SellerName ?? "—")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">@L["DO_Product"]</td>
                                <td>
                                    <a href="/Listing/Detail/@o.ListingId" class="text-decoration-none fw-semibold" style="color:var(--accent);">@o.ListingTitle</a>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted">@L["DO_Price"]</td>
                                <td class="fw-semibold">@o.ListingPrice.ToString("N2") ₼</td>
                            </tr>
                            <tr>
                                <td class="text-muted">@L["DO_Fee"]</td>
                                <td>@o.DeliveryFee.ToString("N2") ₼</td>
                            </tr>
                            <tr>
                                <td class="text-muted">@L["DO_Total2"]</td>
                                <td class="fw-bold" style="color:var(--accent);">@o.TotalAmount.ToString("N2") ₼</td>
                            </tr>
                            <tr>
                                <td class="text-muted">@L["DO_City"]</td>
                                <td>@(o.DeliveryCity ?? "—")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">@L["DO_Address"]</td>
                                <td>@(o.DeliveryAddress ?? "—")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">@L["DO_Phone"]</td>
                                <td>@(o.DeliveryPhone ?? "—")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">@L["DO_Card"]</td>
                                <td>@(o.CardLast4 != null ? $"•••• {o.CardLast4}" : "—")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">@L["DO_PaidAt"]</td>
                                <td>@(o.PaidAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">@L["DO_Status"]</td>
                                <td>
                                    @if (o.SellerApprovalStatus == "Approved")
                                    {
                                        <span class="badge bg-success-subtle text-success">@L["DO_Approved"]</span>
                                    }
                                    else if (o.SellerApprovalStatus == "Rejected")
                                    {
                                        <span class="badge bg-danger-subtle text-danger">@L["DO_Rejected"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">@L["DO_Pending"]</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted">@L["DO_CreatedAt"]</td>
                                <td>@o.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
