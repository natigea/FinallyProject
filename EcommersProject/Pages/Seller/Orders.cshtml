@page
@model EcommersProject.Pages.Seller.OrdersModel
@{
    ViewData["Title"] = "Мои сообщения";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-0 fw-bold">Мои переписки</h5>
        <small class="text-muted">Всего: @Model.Conversations.Count</small>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Conversations.Any())
        {
            <div class="empty-state">
                <i class="bi bi-chat-dots"></i>
                Переписок нет.
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var c in Model.Conversations)
                {
                    <a href="/Messages/Chat/@c.Id"
                       class="list-group-item list-group-item-action d-flex align-items-center gap-3 p-3">
                        @if (c.ListingImage != null)
                        {
                            <img src="@c.ListingImage" class="rounded" style="width:48px;height:48px;object-fit:cover;flex-shrink:0" />
                        }
                        else
                        {
                            <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                 style="width:48px;height:48px;flex-shrink:0">
                                <i class="bi bi-image text-muted"></i>
                            </div>
                        }
                        <div class="flex-grow-1 min-width-0">
                            <div class="d-flex justify-content-between align-items-start">
                                <span class="fw-semibold text-truncate">@(c.ListingTitle ?? "Объявление")</span>
                                <small class="text-muted ms-2 flex-shrink-0">
                                    @(c.LastMessage?.CreatedDate.ToLocalTime().ToString("dd.MM HH:mm") ?? c.CreatedDate.ToLocalTime().ToString("dd.MM"))
                                </small>
                            </div>
                            <div class="small text-muted text-truncate">
                                @(c.LastMessage?.Text ?? "Нет сообщений")
                            </div>
                            <div class="small text-muted">
                                С: @(c.BuyerId == Guid.Empty ? c.SellerName : c.BuyerName)
                            </div>
                        </div>
                        @if (c.UnreadCount > 0)
                        {
                            <span class="badge bg-success rounded-pill">@c.UnreadCount</span>
                        }
                    </a>
                }
            </div>
        }
    </div>
</div>
