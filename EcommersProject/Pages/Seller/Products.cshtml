@page
@model EcommersProject.Pages.Seller.ProductsModel
@{
    ViewData["Title"] = "Мои объявления";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-0 fw-bold">Мои объявления</h5>
        <small class="text-muted">Всего: @Model.Listings.Count</small>
    </div>
    <a href="/Listing/Create" class="btn btn-success">
        <i class="bi bi-plus-lg me-1"></i>Подать объявление
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Listings.Any())
        {
            <div class="empty-state">
                <i class="bi bi-grid-3x3-gap"></i>
                У вас ещё нет объявлений. <a href="/Listing/Create">Подайте первое!</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Фото</th>
                            <th>Название</th>
                            <th>Категория</th>
                            <th>Город</th>
                            <th>Цена</th>
                            <th>Статус</th>
                            <th>Дата</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Listings)
                        {
                            var thumb = l.Images.OrderBy(i => i.SortOrder).FirstOrDefault()?.Url;
                            <tr>
                                <td>
                                    @if (thumb != null)
                                    {
                                        <img src="@thumb" class="rounded" style="width:44px;height:44px;object-fit:cover" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                             style="width:44px;height:44px;">
                                            <i class="bi bi-image text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td class="fw-medium">
                                    <a href="/Listing/Detail/@l.Id" class="text-decoration-none text-dark">@l.Title</a>
                                </td>
                                <td class="small text-muted">@(l.CategoryName ?? "—")</td>
                                <td class="small">@l.City</td>
                                <td class="fw-medium">@l.Price.ToString("N0") ₼</td>
                                <td>
                                    @if (l.Status == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success">Активно</span>
                                    }
                                    else if (l.Status == "Closed")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Закрыто</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">@l.Status</span>
                                    }
                                </td>
                                <td class="small text-muted">@l.CreatedDate.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a href="/Listing/Edit/@l.Id"
                                           class="btn btn-sm btn-outline-primary btn-action" title="Редактировать">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post" asp-page-handler="Delete"
                                              onsubmit="return confirm('Удалить объявление «@l.Title»?')">
                                            <input type="hidden" name="id" value="@l.Id" />
                                            <button class="btn btn-sm btn-outline-danger btn-action" title="Удалить">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
