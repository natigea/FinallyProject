@page
@model EcommersProject.Pages.Seller.ProductsModel
@{
    ViewData["Title"] = L["SP_MyListings"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-1 fw-bold" style="letter-spacing:-.3px;">@L["SP_MyListings"]</h5>
        <span class="small" style="color:var(--text-muted);">@L["SP_Total"]: @Model.Listings.Count</span>
    </div>
    <a href="/Listing/Create" class="btn btn-success" style="border-radius:10px; font-weight:600;">
        <i class="bi bi-plus-lg me-1"></i>@L["SP_CreateListing"]
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Listings.Any())
        {
            <div class="empty-state">
                <i class="bi bi-grid-3x3-gap"></i>
                @L["SP_NoListings"] <a href="/Listing/Create" style="color:var(--accent); font-weight:600;">@L["SP_CreateFirst"]</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width:60px;">@L["SP_Photo"]</th>
                            <th>@L["SP_Title"]</th>
                            <th>@L["SP_Category"]</th>
                            <th>@L["SP_City"]</th>
                            <th>@L["SP_Price"]</th>
                            <th>@L["SP_Status"]</th>
                            <th>@L["SP_Date"]</th>
                            <th>@L["SP_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Listings)
                        {
                            var thumb = l.Images.OrderBy(i => i.SortOrder).FirstOrDefault()?.Url;
                            <tr>
                                <td>
                                    @if (thumb != null)
                                    {
                                        <img src="@thumb" style="width:44px;height:44px;object-fit:cover;border-radius:10px;" />
                                    }
                                    else
                                    {
                                        <div style="width:44px;height:44px;border-radius:10px;background:var(--page-bg);display:flex;align-items:center;justify-content:center;">
                                            <i class="bi bi-image" style="color:var(--text-muted);"></i>
                                        </div>
                                    }
                                </td>
                                <td class="fw-semibold">
                                    <a href="/Listing/Detail/@l.Id" class="text-decoration-none" style="color:var(--text-primary);">@l.Title</a>
                                </td>
                                <td class="small" style="color:var(--text-muted);">@(l.CategoryName ?? "—")</td>
                                <td class="small">@l.City</td>
                                <td class="fw-semibold">@l.Price.ToString("N0") ₼</td>
                                <td>
                                    @if (l.Status == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            <i class="bi bi-check-circle me-1"></i>@L["SP_Active"]
                                        </span>
                                    }
                                    else if (l.Status == "Closed")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">@L["SP_ClosedStatus"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">
                                            <i class="bi bi-clock me-1"></i>@l.Status
                                        </span>
                                    }
                                </td>
                                <td class="small" style="color:var(--text-muted);">@l.CreatedDate.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a href="/Listing/Edit/@l.Id"
                                           class="btn btn-sm btn-outline-primary btn-action" title="@L["SP_Edit"]">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post" asp-page-handler="Delete"
                                              onsubmit="return confirm('@L["SP_ConfirmDelete"]')">
                                            <input type="hidden" name="id" value="@l.Id" />
                                            <button class="btn btn-sm btn-outline-danger btn-action" title="@L["SP_Delete"]">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
