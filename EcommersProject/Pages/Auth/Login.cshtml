@page
@model EcommersProject.Pages.Auth.LoginModel
@{
    Layout = null;
    ViewData["Title"] = L["Auth_LoginTitle"];
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Auth_LoginTitle"] — EcommersAdmin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            background: #fff;
            border-radius: 16px;
            padding: 2.5rem;
            box-shadow: 0 20px 60px rgba(0,0,0,.3);
        }

        .login-brand { text-align: center; margin-bottom: 2rem; }
        .login-brand i { font-size: 2.5rem; color: #0f3460; }
        .login-brand h4 { font-weight: 700; color: #1a1a2e; margin: .5rem 0 .25rem; }
        .login-brand p { color: #6c757d; font-size: .875rem; margin: 0; }

        .form-label { font-weight: 500; font-size: .875rem; color: #495057; }

        .form-control {
            border: 1.5px solid #e9ecef;
            border-radius: 8px;
            padding: .65rem 1rem;
            font-size: .9rem;
            transition: border-color .2s;
        }

        .form-control:focus {
            border-color: #0f3460;
            box-shadow: 0 0 0 3px rgba(15,52,96,.1);
        }

        .btn-login {
            background: linear-gradient(135deg, #1a1a2e, #0f3460);
            border: none;
            border-radius: 8px;
            padding: .75rem;
            font-weight: 600;
            letter-spacing: .5px;
        }

        .btn-login:hover { opacity: .9; transform: translateY(-1px); }

        .input-icon { position: relative; }
        .input-icon i {
            position: absolute;
            left: .85rem;
            top: 50%;
            transform: translateY(-50%);
            color: #adb5bd;
            font-size: .9rem;
        }
        .input-icon input { padding-left: 2.5rem; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-brand">
            <i class="bi bi-shop-window"></i>
            <h4>EcommersAdmin</h4>
            <p>@L["Auth_PanelSubtitle"]</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2 small" role="alert">
                <i class="bi bi-exclamation-circle me-1"></i>@Model.ErrorMessage
            </div>
        }

        <form method="post">
            <div class="mb-3">
                <label for="Email" class="form-label">Email</label>
                <div class="input-icon">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Email" type="email" id="Email" class="form-control"
                           placeholder="admin@ecommers.com" autocomplete="email" required />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label for="Password" class="form-label">@L["Auth_Password"]</label>
                <div class="input-icon">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Password" type="password" id="Password" class="form-control"
                           placeholder="••••••••" autocomplete="current-password" required />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-login btn-primary w-100 text-white">
                <i class="bi bi-box-arrow-in-right me-2"></i>@L["Auth_LoginBtn"]
            </button>
        </form>

        <div class="mt-4 pt-3 border-top text-center">
            <small class="text-muted">
                <i class="bi bi-shield-lock me-1"></i>
                @L["Auth_AccessOnly"]
            </small>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
