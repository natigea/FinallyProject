@page
@{
    Layout = null;
    ViewData["Title"] = L["Auth_AccessDenied"];
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>@L["Auth_AccessDenied"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="min-height:100vh">
    <div class="text-center">
        <h1 class="display-1 fw-bold text-danger">403</h1>
        <h4 class="mb-3">@L["Auth_AccessDenied"]</h4>
        <p class="text-muted mb-4">@L["Auth_NoPermission"]</p>
        <a href="/Auth/Login" class="btn btn-primary">@L["Auth_Login"]</a>
    </div>
</body>
</html>
