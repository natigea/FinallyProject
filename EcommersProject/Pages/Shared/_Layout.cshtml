@using Microsoft.Extensions.Localization
@using EcommersProject.Resources
@inject IStringLocalizer<SharedResource> L
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString);
    var path = Context.Request.Path.ToString();
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — @L["Admin_Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root {
            --sb-w: 272px;
            --sb-bg: #0f172a;
            --sb-hover: rgba(255,255,255,.06);
            --sb-active: rgba(99,102,241,.15);
            --sb-accent: #818cf8;
            --sb-text: rgba(255,255,255,.55);
            --sb-text-h: rgba(255,255,255,.92);
            --page-bg: #f1f5f9;
            --card-bg: #fff;
            --card-border: #e2e8f0;
            --text-primary: #0f172a;
            --text-secondary: #64748b;
            --text-muted: #94a3b8;
            --accent: #6366f1;
            --accent-soft: rgba(99,102,241,.08);
            --radius: 14px;
            --radius-sm: 10px;
            --shadow-card: 0 1px 3px rgba(15,23,42,.04), 0 4px 14px rgba(15,23,42,.06);
            --shadow-card-h: 0 4px 20px rgba(15,23,42,.10);
            --transition: .2s cubic-bezier(.4,0,.2,1);
        }

        *, *::before, *::after { box-sizing: border-box; }
        body {
            background: var(--page-bg);
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            color: var(--text-primary);
            font-size: 14px;
            line-height: 1.6;
            margin: 0;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        /* ── SIDEBAR ── */
        .sb {
            width: var(--sb-w);
            min-height: 100vh;
            background: var(--sb-bg);
            position: fixed;
            top: 0; left: 0;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            border-right: 1px solid rgba(255,255,255,.06);
        }
        .sb-brand {
            padding: 24px 22px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .sb-logo {
            width: 40px; height: 40px; border-radius: 12px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem; color: #fff; flex-shrink: 0;
            box-shadow: 0 4px 16px rgba(99,102,241,.35);
        }
        .sb-brand-text { line-height: 1.2; }
        .sb-brand-name { color: #fff; font-size: 1.1rem; font-weight: 700; letter-spacing: -.3px; }
        .sb-brand-sub { color: rgba(255,255,255,.35); font-size: .65rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1.5px; }

        .sb-nav { flex: 1; padding: 8px 12px; overflow-y: auto; }
        .sb-section {
            padding: 20px 10px 6px;
            color: rgba(255,255,255,.28);
            font-size: .65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.8px;
        }
        .sb-section:first-child { padding-top: 8px; }

        .sb-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            border-radius: var(--radius-sm);
            color: var(--sb-text);
            font-size: .875rem;
            font-weight: 500;
            text-decoration: none;
            transition: all var(--transition);
            position: relative;
            margin-bottom: 2px;
        }
        .sb-link:hover {
            color: var(--sb-text-h);
            background: var(--sb-hover);
        }
        .sb-link.active {
            color: #fff;
            background: var(--sb-active);
        }
        .sb-link.active::before {
            content: '';
            position: absolute;
            left: 0; top: 8px; bottom: 8px;
            width: 3px;
            border-radius: 0 3px 3px 0;
            background: var(--sb-accent);
        }
        .sb-link i {
            font-size: 1.1rem;
            width: 20px;
            text-align: center;
            flex-shrink: 0;
            opacity: .7;
        }
        .sb-link.active i { opacity: 1; color: var(--sb-accent); }

        .sb-footer {
            padding: 16px;
            border-top: 1px solid rgba(255,255,255,.06);
        }
        .sb-lang {
            display: flex; gap: 4px; margin-bottom: 12px;
        }
        .sb-lang a {
            flex: 1;
            text-align: center;
            padding: 5px 0;
            border-radius: 8px;
            font-size: .7rem;
            font-weight: 700;
            text-decoration: none;
            transition: all var(--transition);
            border: 1px solid rgba(255,255,255,.1);
            color: rgba(255,255,255,.35);
        }
        .sb-lang a.active {
            background: rgba(99,102,241,.2);
            border-color: rgba(99,102,241,.4);
            color: #c7d2fe;
        }
        .sb-back {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: var(--radius-sm);
            color: rgba(255,255,255,.5);
            font-size: .85rem;
            font-weight: 500;
            text-decoration: none;
            transition: all var(--transition);
            margin-bottom: 12px;
        }
        .sb-back:hover { background: var(--sb-hover); color: rgba(255,255,255,.8); }
        .sb-user {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            border-radius: var(--radius-sm);
            background: rgba(255,255,255,.04);
        }
        .sb-avatar {
            width: 38px; height: 38px; border-radius: 10px;
            background: linear-gradient(135deg, #334155, #475569);
            display: flex; align-items: center; justify-content: center;
            font-size: .85rem; color: rgba(255,255,255,.7); flex-shrink: 0;
        }
        .sb-user-name { font-weight: 600; font-size: .85rem; color: rgba(255,255,255,.85); }
        .sb-user-role { font-size: .72rem; color: rgba(255,255,255,.35); }
        .sb-user-info { flex: 1; min-width: 0; line-height: 1.3; }
        .sb-logout {
            color: rgba(255,255,255,.3);
            font-size: 1.05rem;
            text-decoration: none;
            transition: color var(--transition);
            padding: 4px;
        }
        .sb-logout:hover { color: #f87171; }

        /* ── MAIN WRAPPER ── */
        .main-wrapper {
            margin-left: var(--sb-w);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .topbar {
            background: rgba(255,255,255,.8);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            padding: 16px 28px;
            border-bottom: 1px solid var(--card-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .topbar-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
            letter-spacing: -.3px;
        }
        .topbar-date {
            font-size: .8rem;
            color: var(--text-muted);
            font-weight: 500;
            background: var(--page-bg);
            padding: 6px 14px;
            border-radius: 20px;
        }

        .main-content { padding: 28px; flex: 1; }

        /* ── KPI CARDS ── */
        .kpi {
            border: none;
            border-radius: var(--radius);
            padding: 24px;
            color: #fff;
            position: relative;
            overflow: hidden;
            transition: transform var(--transition), box-shadow var(--transition);
        }
        .kpi:hover { transform: translateY(-2px); }
        .kpi::before {
            content: '';
            position: absolute;
            top: -30px; right: -30px;
            width: 100px; height: 100px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
        }
        .kpi::after {
            content: '';
            position: absolute;
            bottom: -20px; left: -20px;
            width: 60px; height: 60px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
        }
        .kpi-icon {
            width: 48px; height: 48px; border-radius: 12px;
            background: rgba(255,255,255,.15);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.3rem;
            backdrop-filter: blur(8px);
        }
        .kpi-value { font-size: 2rem; font-weight: 800; letter-spacing: -.5px; line-height: 1.1; }
        .kpi-label { font-size: .8rem; opacity: .8; font-weight: 500; margin-top: 2px; }
        .kpi-sub { font-size: .75rem; opacity: .65; margin-top: 8px; font-weight: 500; }

        .bg-g-indigo  { background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); box-shadow: 0 8px 24px rgba(99,102,241,.3); }
        .bg-g-emerald { background: linear-gradient(135deg, #10b981 0%, #34d399 100%); box-shadow: 0 8px 24px rgba(16,185,129,.3); }
        .bg-g-amber   { background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%); box-shadow: 0 8px 24px rgba(245,158,11,.3); }
        .bg-g-rose     { background: linear-gradient(135deg, #f43f5e 0%, #fb7185 100%); box-shadow: 0 8px 24px rgba(244,63,94,.3); }
        .bg-g-sky      { background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 100%); box-shadow: 0 8px 24px rgba(14,165,233,.3); }
        .bg-g-slate    { background: linear-gradient(135deg, #475569 0%, #64748b 100%); box-shadow: 0 8px 24px rgba(71,85,105,.3); }

        /* ── CARDS ── */
        .card {
            border: 1px solid var(--card-border);
            border-radius: var(--radius);
            box-shadow: var(--shadow-card);
            background: var(--card-bg);
            transition: box-shadow var(--transition);
        }
        .card:hover { box-shadow: var(--shadow-card-h); }
        .card-header {
            background: transparent;
            border-bottom: 1px solid var(--card-border);
            font-weight: 600;
            font-size: .9rem;
            color: var(--text-primary);
            padding: 16px 20px;
        }
        .card-body { padding: 20px; }

        /* ── TABLES ── */
        .table { margin-bottom: 0; }
        .table th {
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: .8px;
            color: var(--text-muted);
            font-weight: 600;
            border-top: none;
            padding: 12px 16px;
            background: #f8fafc;
            white-space: nowrap;
        }
        .table td { padding: 12px 16px; border-color: #f1f5f9; vertical-align: middle; }
        .table-hover tbody tr:hover { background: rgba(99,102,241,.03); }
        .table-hover tbody tr { transition: background var(--transition); }

        /* ── BADGES ── */
        .badge { font-weight: 600; font-size: .72rem; padding: .4em .8em; border-radius: 6px; letter-spacing: .2px; }

        /* ── BUTTONS ── */
        .btn-action {
            width: 32px; height: 32px; padding: 0;
            display: inline-flex; align-items: center; justify-content: center;
            border-radius: 8px;
            transition: all var(--transition);
        }
        .btn-action:hover { transform: scale(1.08); }

        /* ── EMPTY STATE ── */
        .empty-state {
            text-align: center;
            padding: 48px 24px;
            color: var(--text-muted);
        }
        .empty-state i { font-size: 2.5rem; display: block; margin-bottom: 12px; opacity: .5; }

        /* ── FILTER CARDS ── */
        .filter-card { padding: 12px 16px; }
        .filter-card .form-control,
        .filter-card .form-select {
            border-radius: 8px;
            border-color: var(--card-border);
            font-size: .85rem;
        }
        .filter-card .form-control:focus,
        .filter-card .form-select:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-soft);
        }

        /* ── ALERTS ── */
        .alert { border-radius: var(--radius-sm); border: none; font-size: .88rem; }
        .alert-success { background: #ecfdf5; color: #065f46; }
        .alert-danger  { background: #fef2f2; color: #991b1b; }

        /* ── SCROLLBAR ── */
        .sb-nav::-webkit-scrollbar { width: 4px; }
        .sb-nav::-webkit-scrollbar-track { background: transparent; }
        .sb-nav::-webkit-scrollbar-thumb { background: rgba(255,255,255,.1); border-radius: 4px; }

        /* ── MOBILE SIDEBAR ── */
        .sb-toggle {
            display: none;
            width: 40px; height: 40px;
            border: 1px solid var(--card-border);
            border-radius: 10px;
            background: var(--card-bg);
            color: var(--text-primary);
            font-size: 1.1rem;
            cursor: pointer;
            align-items: center;
            justify-content: center;
        }
        .sb-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.5);
            z-index: 999;
            backdrop-filter: blur(4px);
        }

        @@media (max-width: 768px) {
            .sb {
                transform: translateX(-100%);
                transition: transform .3s cubic-bezier(.4,0,.2,1);
                box-shadow: 4px 0 24px rgba(0,0,0,.2);
            }
            .sb.open { transform: translateX(0); }
            .sb-backdrop.open { display: block; }
            .main-wrapper { margin-left: 0; }
            .sb-toggle { display: flex; }
            .main-content { padding: 16px; }
            .topbar { padding: 12px 16px; }
        }

        /* ── FORM CONTROLS ── */
        .form-control, .form-select {
            border-radius: 8px;
            border: 1.5px solid var(--card-border);
            font-size: .875rem;
            transition: border-color var(--transition), box-shadow var(--transition);
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-soft);
        }
        .form-label { font-size: .8rem; font-weight: 600; color: var(--text-secondary); }

        /* backward compat with existing pages */
        .stat-card { border:none; border-radius:var(--radius); padding:24px; color:#fff; position:relative; overflow:hidden; transition: transform var(--transition); }
        .stat-card:hover { transform: translateY(-2px); }
        .stat-card::after { content:''; position:absolute; top:-30px; right:-30px; width:100px; height:100px; border-radius:50%; background:rgba(255,255,255,.08); }
        .stat-card .stat-icon { font-size:2rem; opacity:.8; }
        .stat-card .stat-value { font-size:2rem; font-weight:800; letter-spacing:-.5px; }
        .stat-card .stat-label { font-size:.8rem; opacity:.85; font-weight:500; }
        .bg-gradient-primary { background:linear-gradient(135deg,#6366f1,#8b5cf6); box-shadow:0 8px 24px rgba(99,102,241,.3); }
        .bg-gradient-success { background:linear-gradient(135deg,#10b981,#34d399); box-shadow:0 8px 24px rgba(16,185,129,.3); }
        .bg-gradient-warning { background:linear-gradient(135deg,#f59e0b,#fbbf24); box-shadow:0 8px 24px rgba(245,158,11,.3); }
        .bg-gradient-danger  { background:linear-gradient(135deg,#f43f5e,#fb7185); box-shadow:0 8px 24px rgba(244,63,94,.3); }
        .bg-gradient-info    { background:linear-gradient(135deg,#0ea5e9,#38bdf8); box-shadow:0 8px 24px rgba(14,165,233,.3); }
        .bg-gradient-dark    { background:linear-gradient(135deg,#475569,#64748b); box-shadow:0 8px 24px rgba(71,85,105,.3); }

        .chart-container { position:relative; height:280px; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Mobile backdrop -->
    <div class="sb-backdrop" id="sbBackdrop" onclick="document.querySelector('.sb').classList.remove('open');this.classList.remove('open');"></div>

    <!-- Sidebar -->
    <nav class="sb" id="sidebar">
        <div class="sb-brand">
            <div class="sb-logo"><i class="bi bi-shop-window"></i></div>
            <div class="sb-brand-text">
                <div class="sb-brand-name">AlisVeris</div>
                <div class="sb-brand-sub">@L["Admin_Title"]</div>
            </div>
        </div>

        <div class="sb-nav">
            @if (User.IsInRole("Admin"))
            {
                <div class="sb-section">@L["Admin_SectionAdmin"]</div>
                <a class="sb-link @(path.StartsWith("/Admin/Dashboard") ? "active" : "")"
                   href="/Admin/Dashboard">
                    <i class="bi bi-grid-1x2-fill"></i> @L["Admin_Dashboard"]
                </a>
                <a class="sb-link @(path.StartsWith("/Admin/Users") ? "active" : "")"
                   href="/Admin/Users">
                    <i class="bi bi-people-fill"></i> @L["Admin_Users"]
                </a>
                <a class="sb-link @(path.StartsWith("/Admin/Products") ? "active" : "")"
                   href="/Admin/Products">
                    <i class="bi bi-box-seam-fill"></i> @L["Admin_Listings"]
                </a>
                <a class="sb-link @(path.StartsWith("/Admin/Categories") ? "active" : "")"
                   href="/Admin/Categories">
                    <i class="bi bi-tags-fill"></i> @L["Admin_Categories"]
                </a>
                <a class="sb-link @(path.StartsWith("/Admin/DeliveryOrders") ? "active" : "")"
                   href="/Admin/DeliveryOrders">
                    <i class="bi bi-truck"></i> @L["Admin_DeliveryOrders"]
                </a>
            }

            <div class="sb-section">@L["Admin_SectionSeller"]</div>
            <a class="sb-link @(path.StartsWith("/Seller/Dashboard") ? "active" : "")"
               href="/Seller/Dashboard">
                <i class="bi bi-graph-up-arrow"></i> @L["Admin_MyStats"]
            </a>

            @if (User.IsInRole("Seller") || User.IsInRole("Admin"))
            {
                <a class="sb-link @(path.StartsWith("/Seller/Products") ? "active" : "")"
                   href="/Seller/Products">
                    <i class="bi bi-bag-fill"></i> @L["Admin_MyListings"]
                </a>
                <a class="sb-link @(path.StartsWith("/Seller/Orders") ? "active" : "")"
                   href="/Seller/Orders">
                    <i class="bi bi-truck"></i> @L["Admin_DeliveryOrders"]
                </a>
            }
        </div>

        <div class="sb-footer">
            <div class="sb-lang">
                <a href="/Language/Set?culture=ru&returnUrl=@returnUrl" class="@(currentCulture=="ru"?"active":"")">RU</a>
                <a href="/Language/Set?culture=az&returnUrl=@returnUrl" class="@(currentCulture=="az"?"active":"")">AZ</a>
                <a href="/Language/Set?culture=en&returnUrl=@returnUrl" class="@(currentCulture=="en"?"active":"")">EN</a>
            </div>
            <a href="/" class="sb-back">
                <i class="bi bi-arrow-left-circle"></i>
                <span>@L["Admin_GoToSite"]</span>
            </a>
            <div class="sb-user">
                <div class="sb-avatar"><i class="bi bi-person-fill"></i></div>
                <div class="sb-user-info">
                    <div class="sb-user-name">@User.Identity?.Name</div>
                    <div class="sb-user-role">
                        @(User.IsInRole("Admin") ? L["Admin_RoleAdmin"].Value : L["Admin_RoleSeller"].Value)
                    </div>
                </div>
                <a href="/Auth/Logout" class="sb-logout" title="@L["Nav_Logout"]">
                    <i class="bi bi-box-arrow-right"></i>
                </a>
            </div>
        </div>
    </nav>

    <!-- Main -->
    <div class="main-wrapper">
        <div class="topbar">
            <div class="d-flex align-items-center gap-3">
                <button class="sb-toggle" onclick="document.getElementById('sidebar').classList.toggle('open');document.getElementById('sbBackdrop').classList.toggle('open');">
                    <i class="bi bi-list"></i>
                </button>
                <h6 class="topbar-title mb-0">@ViewData["Title"]</h6>
            </div>
            <div class="topbar-date">
                <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dd.MM.yyyy")
            </div>
        </div>

        <main class="main-content">
            @if (TempData["SuccessMessage"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@success
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
